# Tidying up the device list of Dolphin (and of every UDisks-based program). It only affects
# the display: it does not touch mounts, partitions or file systems.

# The system's read-only image (composefs, since Fedora 42), if ostree mounts it on a loop device. Dolphin's
# nameless, 128 TB drive was not this though (the real machine has no loop device), but the composefs overlay
# mounted on / itself: KDE Solid shows it based on /etc/fstab, and sloth-hide-root-overlay.service hides it.
SUBSYSTEM=="block", KERNEL=="loop*", ATTR{loop/backing_file}=="*/.ostree.cfs", ENV{UDISKS_IGNORE}="1"
SUBSYSTEM=="block", KERNEL=="loop*", ENV{ID_FS_TYPE}=="erofs", ENV{UDISKS_IGNORE}="1"

# The system partition under a readable name. Dolphin shows the file system's label, not this: the installer after
# 2026-10-19 therefore creates it with the "Sloth OS" label from the start; this rule is for earlier installs (labelled "root")
SUBSYSTEM=="block", ENV{ID_FS_TYPE}=="btrfs", ENV{ID_FS_LABEL}=="root", ENV{UDISKS_NAME}="Sloth OS"
