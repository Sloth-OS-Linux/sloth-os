[Unit]
Description=Sloth OS: back up game saves every hour (Sloth Center → Games → Game saves)
# not for the sign-in screen's own user (plasmalogin) or other system users: only people's accounts
ConditionUser=!@system

[Timer]
OnStartupSec=10min
OnCalendar=hourly
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
