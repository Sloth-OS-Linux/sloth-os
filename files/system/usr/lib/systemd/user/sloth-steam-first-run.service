[Unit]
Description=Sloth OS: a notification while Steam downloads itself on its first start
ConditionPathExists=!%h/.local/state/sloth-os/steam-first-run.done
After=plasma-workspace.target

[Service]
Type=oneshot
# It stays active after exiting, otherwise PathExists would start it again and again
RemainAfterExit=yes
Environment=PYTHONPATH=/usr/lib/sloth-os/sloth-center:/usr/lib/sloth-os/common
ExecStart=/usr/bin/python3 -m sloth_center.steam_first_run
TimeoutStartSec=infinity
