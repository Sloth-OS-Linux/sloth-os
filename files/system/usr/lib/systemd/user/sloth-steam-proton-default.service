[Unit]
Description=Sloth OS: turning Proton on in Steam for every game (once)
# not for the sign-in screen's own user (plasmalogin) or other system users: only people's accounts
ConditionUser=!@system

[Service]
Type=oneshot
ExecStart=/usr/libexec/sloth-os/steam-proton-default

[Install]
WantedBy=default.target
