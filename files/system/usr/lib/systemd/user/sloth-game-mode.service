[Unit]
Description=Sloth OS: game mode (Sloth Center → Games → Game mode)
# not for the sign-in screen's own user (plasmalogin) or other system users: only people's accounts
ConditionUser=!@system
Documentation=file:///usr/libexec/sloth-os/game-mode
PartOf=graphical-session.target
After=plasma-workspace.target

[Service]
Type=simple
ExecStart=/usr/libexec/sloth-os/game-mode run
Restart=on-failure
RestartSec=10
Nice=5

[Install]
WantedBy=plasma-workspace.target
