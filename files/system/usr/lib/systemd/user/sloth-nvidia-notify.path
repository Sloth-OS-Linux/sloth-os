[Unit]
Description=Sloth OS: watching the preparation of the NVIDIA version
# not for the sign-in screen's own user (plasmalogin) or other system users: only people's accounts
ConditionUser=!@system

[Path]
PathChanged=/var/lib/sloth-os/nvidia-auto
Unit=sloth-nvidia-notify.service

[Install]
WantedBy=default.target
