[Unit]
Description=Sloth OS: cloud storage as a folder (%i)
# /usr/libexec/sloth-os/cloud-drive; Sloth Center turns it on (Account and security → Cloud storage)

[Service]
Type=notify
ExecStart=/usr/libexec/sloth-os/cloud-drive mount %i
# on stopping (SIGTERM) rclone unmounts the folder by itself
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
