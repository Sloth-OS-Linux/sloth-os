[Unit]
Description=Sloth OS: the Windows programs' taskbar balloons next to the taskbar (not in the top left corner)
# not for the sign-in screen's own user (plasmalogin) or other system users: only people's accounts
ConditionUser=!@system
PartOf=graphical-session.target
After=plasma-workspace.target

[Service]
ExecStart=/usr/libexec/sloth-os/wine-balloons
Restart=on-failure
RestartSec=10

[Install]
WantedBy=plasma-workspace.target
