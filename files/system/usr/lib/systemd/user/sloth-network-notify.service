[Unit]
Description=Sloth OS: the question at a new network (private or public)
After=plasma-workspace.target

[Service]
Type=oneshot
Environment=PYTHONPATH=/usr/lib/sloth-os/sloth-center:/usr/lib/sloth-os/common
ExecStart=/usr/bin/python3 -m sloth_center.network_notify

[Install]
WantedBy=plasma-workspace.target
