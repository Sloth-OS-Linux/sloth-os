[Unit]
Description=Sloth OS: a notification when a system update is ready
After=plasma-workspace.target

[Service]
Type=oneshot
Environment=PYTHONPATH=/usr/lib/sloth-os/sloth-center:/usr/lib/sloth-os/common
ExecStart=/usr/bin/python3 -m sloth_center.update_notify

[Install]
WantedBy=plasma-workspace.target
