[Unit]
Description=Sloth OS: preparing and updating the Windows programs' runner in the background
# not for the sign-in screen's own user (plasmalogin) or other system users: only people's accounts
ConditionUser=!@system

[Service]
# game mode: not while a game runs; it runs right after the game (/usr/libexec/sloth-os/game-mode)
ExecCondition=/usr/libexec/sloth-os/game-mode playing sloth-windows-prepare.service
Type=oneshot
ExecStart=/usr/libexec/sloth-os/windows-prepare
# Low priority: it must not slow down games or work. The "idle" disk priority is not good: next to other disk work
# (e.g. installing apps) it almost stops, and meanwhile the first .exe install would wait for it too
Nice=19
IOSchedulingClass=best-effort
IOSchedulingPriority=7
