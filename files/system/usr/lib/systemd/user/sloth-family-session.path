[Unit]
Description=Sloth OS: watching this account's parental controls (screen time, blocked apps)

[Path]
# /usr/libexec/sloth-os/screen-time writes <user>.json, sloth-helper-family <user>.apps
PathChanged=/run/sloth-os/family/%u.json
PathChanged=/run/sloth-os/family/%u.apps
Unit=sloth-family-session.service

[Install]
WantedBy=default.target
