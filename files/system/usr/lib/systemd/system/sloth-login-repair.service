[Unit]
Description=Sloth OS: visibility of the login screen's system users (authselect with-altfiles)
# authselect (when turning on fingerprint, PIN, work account) may have removed altfiles from /etc/nsswitch.conf;
# without it the users of /usr/lib/passwd (e.g. "plasmalogin") are not visible, and the login screen does not even start.
# At startup it turns it back on, before the login screen starts.
DefaultDependencies=no
After=local-fs.target ostree-remount.service
Before=display-manager.service plasmalogin.service sddm.service systemd-user-sessions.service shutdown.target
Conflicts=shutdown.target
ConditionPathExists=/usr/lib/passwd

[Service]
Type=oneshot
ExecStart=-/usr/libexec/sloth-os/sloth-helper login-repair

[Install]
WantedBy=multi-user.target
