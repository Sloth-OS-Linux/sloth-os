[Unit]
Description=Sloth OS: frissítések aláírás-ellenőrzéssel (a régebbi telepítések egyszeri átállítása)
ConditionPathExists=!/var/lib/sloth-os/signed-updates-done
Wants=network-online.target
After=network-online.target rpm-ostreed.service sloth-nvidia-auto.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/sloth-os/signed-updates
