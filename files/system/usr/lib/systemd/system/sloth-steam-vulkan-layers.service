[Unit]
Description=Sloth OS: MangoHud and gamescope Vulkan layers for the Steam Flatpak
# Steam is installed by the default-flatpaks module's service; we run after it.
After=system-flatpak-setup.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/sloth-os/steam-vulkan-layers
# If there is no network right now, the timer tries again later.
Restart=no
