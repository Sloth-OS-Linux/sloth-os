[Unit]
Description=Sloth OS: sikeres indítás jelzése (a boot menü rejtve marad)
# A bejelentkező képernyőig eljutott indítás számít sikeresnek; ha ez nem fut le,
# a következő indításkor a GRUB megmutatja a menüt (lásd /usr/lib/sloth-os/grub-custom.cfg).
After=graphical.target

[Service]
Type=oneshot
ExecStart=-/usr/libexec/sloth-os/boot-env ensure-config
ExecStart=/usr/libexec/sloth-os/boot-env set sloth_boot_pending=0
# a boot menü „Alaphelyzetbe állítás” pontjának felirata a rendszer nyelvén
ExecStart=-/bin/sh -c '/usr/libexec/sloth-os/boot-env set-title "$$(/usr/libexec/sloth-os/factory-reset boot-title)"'

[Install]
WantedBy=graphical.target
