[Unit]
Description=Sloth OS: taking over a reset requested from the boot menu
# GRUB's "Reset this PC" entry writes to the EFI partition (sloth_reset=keep, see grub-custom.cfg); this
# service records it for factory-reset, which does it right afterwards, before login.
DefaultDependencies=no
Requires=local-fs.target
After=local-fs.target ostree-remount.service
Before=sloth-factory-reset.service sysinit.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
ExecStart=-/usr/libexec/sloth-os/factory-reset boot-request

[Install]
WantedBy=sysinit.target
