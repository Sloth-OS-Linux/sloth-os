[Unit]
Description=Sloth OS: folder sharing, watching the shared folders (Dolphin → Share)

[Path]
# at every new or removed share; at startup sloth-file-sharing.service runs by itself (its own [Install])
# Not DirectoryNotEmpty=: that starts the service again and again while something is shared, the service hits its
# start limit within seconds and the path unit stops watching (then Dolphin → Stop sharing was never noticed)
PathChanged=/var/lib/samba/usershares

[Install]
WantedBy=multi-user.target
