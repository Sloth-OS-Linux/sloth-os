[Unit]
Description=Sloth OS: resetting the computer (requested in Sloth Center)
# Early, under the Plymouth animation: the file systems are available, but nothing uses the accounts,
# the settings and the apps yet. At the end the machine restarts (factory-reset boot).
DefaultDependencies=no
ConditionPathExists=/var/lib/sloth-os/factory-reset.json
Requires=local-fs.target
After=local-fs.target ostree-remount.service plymouth-start.service systemd-tmpfiles-setup.service
Before=sysinit.target sloth-home-layout.service sloth-first-user.service systemd-user-sessions.service display-manager.service shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/sloth-os/factory-reset boot
TimeoutStartSec=infinity

[Install]
WantedBy=sysinit.target
