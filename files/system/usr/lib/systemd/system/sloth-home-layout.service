[Unit]
Description=Sloth OS: a saját fájlok mentésének előkészítése (a /var/home külön Btrfs-subvolume)
# Bejelentkezés és az első fiók létrehozása előtt, amikor még senki nem használja a saját mappákat
After=local-fs.target systemd-tmpfiles-setup.service
Before=systemd-user-sessions.service sloth-first-user.service display-manager.service plasmalogin.service sddm.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/sloth-os/home-snapshots layout
# Az első átalakítás egy nagy saját mappánál percekig tarthat (közben a Plymouth-animáció látszik)
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
