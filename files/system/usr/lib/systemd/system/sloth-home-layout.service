[Unit]
Description=Sloth OS: preparing the backup of your own files (/var/home as a separate Btrfs subvolume)
# Before login and before the first account is created, while nobody uses the home folders yet
After=local-fs.target systemd-tmpfiles-setup.service
Before=systemd-user-sessions.service sloth-first-user.service display-manager.service plasmalogin.service sddm.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/sloth-os/home-snapshots layout
# The first conversion of a big home folder may take minutes (the Plymouth animation shows meanwhile)
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
