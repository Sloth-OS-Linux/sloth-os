        smooth: true
        sourceSize.width: 480
        sourceSize.height: 480
    }

    Repeater {
        model: root.trail
        Image {
            required property int index
            readonly property var p: root.points[((root.frame * 2 - index * 3) % root.points.length + root.points.length) % root.points.length]
            readonly property real size: root.logoSize * 0.075 * (1 - index * 0.09)
            source: "images/dot.png"
            width: size
            height: size
            opacity: 1 - index * 0.14
            z: 10 - index
            x: logo.x + p[0] * root.logoSize - size / 2
            y: logo.y + p[1] * root.logoSize - size / 2
            smooth: true
        }
    }

    Timer {
        interval: 20 // 50 fps, mint a Plymouth
        running: true
        repeat: true
        onTriggered: root.frame = (root.frame + 1) % (root.points.length * 1000)
    }

