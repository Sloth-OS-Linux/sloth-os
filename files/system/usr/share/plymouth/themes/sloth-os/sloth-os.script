# --- Logó ---------------------------------------------------------------
screen_w = Window.GetWidth();
screen_h = Window.GetHeight();
size = Math.Int(screen_h * 0.32);
if (size > 480) size = 480;
if (size < 160) size = 160;

logo.image = Image("logo.png").Scale(size, size);
logo.sprite = Sprite(logo.image);
logo.x = Window.GetX() + Math.Int((screen_w - size) / 2);
logo.y = Window.GetY() + Math.Int((screen_h - size) / 2);
logo.sprite.SetPosition(logo.x, logo.y, 1);

# --- Pont és halványuló csóva -------------------------------------------
TRAIL = 7;        # a csóva hossza (pontok száma a vezető pont mögött)
STEP = 2;         # ennyi pozíciót lép képkockánként (50 fps-nél ~2,4 mp egy kör)
dot_size = Math.Int(size * 0.075);
for (i = 0; i < TRAIL; i++) {
  s = Math.Int(dot_size * (1 - i * 0.09));
  trail[i].image = Image("dot.png").Scale(s, s);
  trail[i].sprite = Sprite(trail[i].image);
  trail[i].sprite.SetOpacity(1 - i * 0.14);
  trail[i].sprite.SetZ(10 - i);
  trail[i].half = s / 2;
}

frame = 0;
fun place_dots() {
  for (i = 0; i < TRAIL; i++) {
    idx = Math.Int((frame * STEP - i * 3) % N);
    if (idx < 0) idx = idx + N;
    trail[i].sprite.SetX(logo.x + px[idx] * size - trail[i].half);
    trail[i].sprite.SetY(logo.y + py[idx] * size - trail[i].half);
  }
}

fun refresh_callback() {
  global.frame = global.frame + 1;
  if (global.frame * STEP >= N * 1000) global.frame = 0;
  place_dots();
}
Plymouth.SetRefreshFunction(refresh_callback);
place_dots();

# --- Jelszó (titkosított lemez) és kérdések -----------------------------
prompt.sprite = Sprite();
bullets.sprite = Sprite();
message.sprite = Sprite();
text_y = logo.y + size + Math.Int(size * 0.12);

fun center_text(sprite, image, y) {
  sprite.SetImage(image);
  sprite.SetPosition(Window.GetX() + (screen_w - image.GetWidth()) / 2, y, 20);
}

# A titkosított lemez jelszókérője: a systemd szövege angol és technikai ("Please enter passphrase for disk
# luks-…"), az initramfs-ben pedig nincs nyelvi beállítás, ezért szöveg helyett lakat ikon (lock.png,
# tools/branding/plymouth_lock.py), alatta egy beviteli vonal és a beírt karakterek pöttyei. Jól láthatónak kell
# lennie: ha a felhasználó nem veszi észre, a gép a logón áll, és végtelenül a jelszóra vár.
padlock_size = Math.Int(size * 0.24);
padlock.image = Image("lock.png").Scale(padlock_size, padlock_size);
padlock.sprite = Sprite();
padlock.sprite.SetZ(20);
field_w = Math.Int(size * 0.9);
field.image = Image("dot.png").Scale(field_w, 4);
field.sprite = Sprite();
field.sprite.SetZ(20);
field_y = text_y + padlock_size + 52;
# A beírt karakterek pöttyei képből (az initramfs betűtípusában nincs "●", négyzetek látszanának)
MAX_BULLETS = 24;
bullet_size = Math.Int(size * 0.045);
if (bullet_size < 8) bullet_size = 8;
bullet_gap = Math.Int(bullet_size * 0.8);
bullet_image = Image("dot.png").Scale(bullet_size, bullet_size);
for (i = 0; i < MAX_BULLETS; i++) {
  bullet[i].sprite = Sprite();
  bullet[i].sprite.SetZ(20);
}

fun show_bullets(count) {
  if (count > MAX_BULLETS) count = MAX_BULLETS;
  row_w = count * bullet_size + (count - 1) * bullet_gap;
  x0 = Window.GetX() + Math.Int((screen_w - row_w) / 2);
  for (i = 0; i < MAX_BULLETS; i++) {
    if (i < count) {
      bullet[i].sprite.SetImage(bullet_image);
      bullet[i].sprite.SetPosition(x0 + i * (bullet_size + bullet_gap), field_y - bullet_size - 12, 20);
    } else {
      bullet[i].sprite.SetImage(Image("blank.png"));
    }
  }
}

fun display_normal_callback() {
  prompt.sprite.SetImage(Image("blank.png"));
  bullets.sprite.SetImage(Image("blank.png"));
  padlock.sprite.SetImage(Image("blank.png"));
  field.sprite.SetImage(Image("blank.png"));
  show_bullets(0);
}

fun display_password_callback(text, count) {
  prompt.sprite.SetImage(Image("blank.png"));
  padlock.sprite.SetImage(padlock.image);
  padlock.sprite.SetPosition(Window.GetX() + (screen_w - padlock_size) / 2, text_y, 20);
  field.sprite.SetImage(field.image);
  field.sprite.SetPosition(Window.GetX() + (screen_w - field_w) / 2, field_y, 20);
  show_bullets(count);
}

fun display_question_callback(text, entry) {
  center_text(prompt.sprite, Image.Text(text, 0.89, 0.9, 0.91), text_y);
  if (entry == "") entry = " ";
  center_text(bullets.sprite, Image.Text(entry, 0.89, 0.9, 0.91), text_y + 30);
}

fun message_callback(text) {
  center_text(message.sprite, Image.Text(text, 0.6, 0.63, 0.66), screen_h - 60);
}

Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayQuestionFunction(display_question_callback);
Plymouth.SetMessageFunction(message_callback);
