<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Administrator actions of the Sloth OS GUI tools (Sloth Center). -->
<policyconfig>
  <vendor>Sloth OS</vendor>
  <action id="org.slothos.helper">
    <description>Change a system setting</description>
    <description xml:lang="af">Verander 'n stelselinstelling</description>
    <description xml:lang="ar">تغيير إعداد في النظام</description>
    <description xml:lang="as">এটা চিষ্টেম ছেটিং সলনি কৰক</description>
    <description xml:lang="be">Змяніць сістэмную наладу</description>
    <description xml:lang="bg">Промяна на системна настройка</description>
    <description xml:lang="bn_IN">একটি সিস্টেম সেটিং পরিবর্তন করুন</description>
    <description xml:lang="ca">Canvia un paràmetre del sistema</description>
    <description xml:lang="cs">Změna systémového nastavení</description>
    <description xml:lang="da">Ændr en systemindstilling</description>
    <description xml:lang="de">Eine Systemeinstellung ändern</description>
    <description xml:lang="el">Αλλαγή ρύθμισης συστήματος</description>
    <description xml:lang="eo">Ŝanĝi sisteman agordon</description>
    <description xml:lang="es">Cambiar un ajuste del sistema</description>
    <description xml:lang="et">Muuda süsteemi sätet</description>
    <description xml:lang="fi">Muuta järjestelmäasetusta</description>
    <description xml:lang="fr">Modifier un paramètre du système</description>
    <description xml:lang="fur">Cambie une impostazion dal sisteme</description>
    <description xml:lang="he">שינוי הגדרת מערכת</description>
    <description xml:lang="hr">Promjena postavke sustava</description>
    <description xml:lang="hu">Rendszerbeállítás módosítása</description>
    <description xml:lang="ia">Cambiar un configuration del systema</description>
    <description xml:lang="id">Ubah pengaturan sistem</description>
    <description xml:lang="it">Modifica un'impostazione di sistema</description>
    <description xml:lang="ja">システム設定の変更</description>
    <description xml:lang="ka">სისტემის პარამეტრის შეცვლა</description>
    <description xml:lang="kab">Beddel aɣewwar n unagraw</description>
    <description xml:lang="kk">Жүйе параметрін өзгерту</description>
    <description xml:lang="ko">시스템 설정 변경</description>
    <description xml:lang="lo">ປ່ຽນການຕັ້ງຄ່າລະບົບ</description>
    <description xml:lang="lt">Keisti sistemos nustatymą</description>
    <description xml:lang="nb">Endre en systeminnstilling</description>
    <description xml:lang="nl">Een systeeminstelling wijzigen</description>
    <description xml:lang="nn">Endre ei systeminnstilling</description>
    <description xml:lang="pa">ਸਿਸਟਮ ਸੈਟਿੰਗ ਬਦਲੋ</description>
    <description xml:lang="pl">Zmień ustawienie systemu</description>
    <description xml:lang="pt">Alterar uma definição do sistema</description>
    <description xml:lang="pt_BR">Alterar uma configuração do sistema</description>
    <description xml:lang="ro">Modifică o setare de sistem</description>
    <description xml:lang="ru">Изменение системного параметра</description>
    <description xml:lang="sk">Zmena systémového nastavenia</description>
    <description xml:lang="sl">Sprememba sistemske nastavitve</description>
    <description xml:lang="sq">Ndrysho një parametër të sistemit</description>
    <description xml:lang="sr">Промена системског подешавања</description>
    <description xml:lang="sv">Ändra en systeminställning</description>
    <description xml:lang="ta">கணினி அமைப்பை மாற்று</description>
    <description xml:lang="tr">Bir sistem ayarını değiştirme</description>
    <description xml:lang="uk">Зміна системного параметра</description>
    <description xml:lang="zh_CN">更改系统设置</description>
    <description xml:lang="zh_TW">變更系統設定</description>
    <message>Sloth Center wants to change a system setting. Enter your password to allow it.</message>
    <message xml:lang="af">Sloth Center wil 'n stelselinstelling verander. Tik jou wagwoord in om dit toe te laat.</message>
    <message xml:lang="ar">يريد Sloth Center تغيير إعداد في النظام. أدخل كلمة المرور للسماح بذلك.</message>
    <message xml:lang="as">Sloth Center-এ এটা চিষ্টেম ছেটিং সলনি কৰিব বিচাৰে। অনুমতি দিবলৈ আপোনাৰ পাছৱৰ্ড দিয়ক।</message>
    <message xml:lang="be">Sloth Center хоча змяніць сістэмную наладу. Каб дазволіць гэта, увядзіце свой пароль.</message>
    <message xml:lang="bg">Sloth Center иска да промени системна настройка. Въведете паролата си, за да го разрешите.</message>
    <message xml:lang="bn_IN">Sloth Center একটি সিস্টেম সেটিং পরিবর্তন করতে চায়। অনুমতি দিতে আপনার পাসওয়ার্ড লিখুন।</message>
    <message xml:lang="ca">Sloth Center vol canviar un paràmetre del sistema. Escriu la teva contrasenya per permetre-ho.</message>
    <message xml:lang="cs">Sloth Center chce změnit systémové nastavení. Pro povolení zadejte své heslo.</message>
    <message xml:lang="da">Sloth Center vil ændre en systemindstilling. Indtast din adgangskode for at tillade det.</message>
    <message xml:lang="de">Sloth Center möchte eine Systemeinstellung ändern. Gib dein Passwort ein, um es zu erlauben.</message>
    <message xml:lang="el">Το Sloth Center θέλει να αλλάξει μια ρύθμιση συστήματος. Εισαγάγετε τον κωδικό σας για να το επιτρέψετε.</message>
    <message xml:lang="eo">Sloth Center volas ŝanĝi sisteman agordon. Entajpu vian pasvorton por permesi tion.</message>
    <message xml:lang="es">Sloth Center quiere cambiar un ajuste del sistema. Escribe tu contraseña para permitirlo.</message>
    <message xml:lang="et">Sloth Center soovib muuta süsteemi sätet. Selle lubamiseks sisesta oma parool.</message>
    <message xml:lang="fi">Sloth Center haluaa muuttaa järjestelmäasetusta. Anna salasanasi salliaksesi sen.</message>
    <message xml:lang="fr">Sloth Center veut modifier un paramètre du système. Saisissez votre mot de passe pour l'autoriser.</message>
    <message xml:lang="fur">Sloth Center al vûl cambiâ une impostazion dal sisteme. Met la tô password par permetilu.</message>
    <message xml:lang="he">Sloth Center רוצה לשנות הגדרת מערכת. יש להזין את הסיסמה כדי לאשר זאת.</message>
    <message xml:lang="hr">Sloth Center želi promijeniti postavku sustava. Upišite svoju lozinku da biste to dopustili.</message>
    <message xml:lang="hu">A Sloth Központ egy rendszerbeállítást szeretne módosítani. Ehhez add meg a jelszavad.</message>
    <message xml:lang="ia">Sloth Center vole cambiar un configuration del systema. Entra tu contrasigno pro permitter lo.</message>
    <message xml:lang="id">Sloth Center ingin mengubah pengaturan sistem. Masukkan kata sandi Anda untuk mengizinkannya.</message>
    <message xml:lang="it">Sloth Center vuole modificare un'impostazione di sistema. Inserisci la tua password per consentirlo.</message>
    <message xml:lang="ja">Sloth Center がシステム設定を変更しようとしています。許可するにはパスワードを入力してください。</message>
    <message xml:lang="ka">Sloth Center-ს სურს სისტემის პარამეტრის შეცვლა. ნებართვისთვის შეიყვანეთ თქვენი პაროლი.</message>
    <message xml:lang="kab">Sloth Center yebɣa ad ibeddel aɣewwar n unagraw. Sekcem awal-ik uffir akken ad t-tsirgeḍ.</message>
    <message xml:lang="kk">Sloth Center жүйе параметрін өзгерткісі келеді. Рұқсат беру үшін құпиясөзіңізді енгізіңіз.</message>
    <message xml:lang="ko">Sloth Center가 시스템 설정을 변경하려고 합니다. 허용하려면 비밀번호를 입력하세요.</message>
    <message xml:lang="lo">Sloth Center ຕ້ອງການປ່ຽນການຕັ້ງຄ່າລະບົບ. ກະລຸນາໃສ່ລະຫັດຜ່ານຂອງທ່ານເພື່ອອະນຸຍາດ.</message>
    <message xml:lang="lt">Sloth Center nori pakeisti sistemos nustatymą. Norėdami tai leisti, įveskite savo slaptažodį.</message>
    <message xml:lang="nb">Sloth Center vil endre en systeminnstilling. Skriv inn passordet ditt for å tillate det.</message>
    <message xml:lang="nl">Sloth Center wil een systeeminstelling wijzigen. Voer je wachtwoord in om dit toe te staan.</message>
    <message xml:lang="nn">Sloth Center vil endre ei systeminnstilling. Skriv inn passordet ditt for å tillate det.</message>
    <message xml:lang="pa">Sloth Center ਇੱਕ ਸਿਸਟਮ ਸੈਟਿੰਗ ਬਦਲਣਾ ਚਾਹੁੰਦਾ ਹੈ। ਇਜਾਜ਼ਤ ਦੇਣ ਲਈ ਆਪਣਾ ਪਾਸਵਰਡ ਦਿਓ।</message>
    <message xml:lang="pl">Sloth Center chce zmienić ustawienie systemu. Wpisz swoje hasło, aby na to zezwolić.</message>
    <message xml:lang="pt">O Sloth Center quer alterar uma definição do sistema. Introduza a sua palavra-passe para o permitir.</message>
    <message xml:lang="pt_BR">O Sloth Center quer alterar uma configuração do sistema. Digite sua senha para permitir.</message>
    <message xml:lang="ro">Sloth Center vrea să modifice o setare de sistem. Introdu parola pentru a permite acest lucru.</message>
    <message xml:lang="ru">Sloth Center хочет изменить системный параметр. Введите свой пароль, чтобы разрешить это.</message>
    <message xml:lang="sk">Sloth Center chce zmeniť systémové nastavenie. Na povolenie zadajte svoje heslo.</message>
    <message xml:lang="sl">Sloth Center želi spremeniti sistemsko nastavitev. Vnesite svoje geslo, da to dovolite.</message>
    <message xml:lang="sq">Sloth Center dëshiron të ndryshojë një parametër të sistemit. Shkruaj fjalëkalimin për ta lejuar.</message>
    <message xml:lang="sr">Sloth Center жели да промени системско подешавање. Унесите своју лозинку да бисте то дозволили.</message>
    <message xml:lang="sv">Sloth Center vill ändra en systeminställning. Ange ditt lösenord för att tillåta det.</message>
    <message xml:lang="ta">Sloth Center ஒரு கணினி அமைப்பை மாற்ற விரும்புகிறது. அனுமதிக்க உங்கள் கடவுச்சொல்லை உள்ளிடவும்.</message>
    <message xml:lang="tr">Sloth Center bir sistem ayarını değiştirmek istiyor. İzin vermek için parolanızı girin.</message>
    <message xml:lang="uk">Sloth Center хоче змінити системний параметр. Введіть свій пароль, щоб дозволити це.</message>
    <message xml:lang="zh_CN">Sloth Center 想要更改一项系统设置。请输入密码以允许此操作。</message>
    <message xml:lang="zh_TW">Sloth Center 想要變更一項系統設定。請輸入密碼以允許此操作。</message>
    <icon_name>sloth-os</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/sloth-os/sloth-helper</annotate>
  </action>
  <action id="org.slothos.helper.versions">
    <description>Keep or choose a system version</description>
    <description xml:lang="af">Hou of kies 'n stelselweergawe</description>
    <description xml:lang="ar">الاحتفاظ بإصدار من النظام أو اختياره</description>
    <description xml:lang="as">এটা চিষ্টেম সংস্কৰণ ৰাখক বা বাছক</description>
    <description xml:lang="be">Захаваць або выбраць версію сістэмы</description>
    <description xml:lang="bg">Запазване или избор на версия на системата</description>
    <description xml:lang="bn_IN">একটি সিস্টেম সংস্করণ রাখুন বা বেছে নিন</description>
    <description xml:lang="ca">Conserva o tria una versió del sistema</description>
    <description xml:lang="cs">Ponechání nebo výběr verze systému</description>
    <description xml:lang="da">Behold eller vælg en systemversion</description>
    <description xml:lang="de">Eine Systemversion behalten oder auswählen</description>
    <description xml:lang="el">Διατήρηση ή επιλογή έκδοσης συστήματος</description>
    <description xml:lang="eo">Konservi aŭ elekti sisteman version</description>
    <description xml:lang="es">Conservar o elegir una versión del sistema</description>
    <description xml:lang="et">Hoia alles või vali süsteemi versioon</description>
    <description xml:lang="fi">Säilytä tai valitse järjestelmäversio</description>
    <description xml:lang="fr">Conserver ou choisir une version du système</description>
    <description xml:lang="fur">Ten o sielç une version dal sisteme</description>
    <description xml:lang="he">שמירה או בחירה של גרסת מערכת</description>
    <description xml:lang="hr">Zadržavanje ili odabir verzije sustava</description>
    <description xml:lang="hu">Rendszerverzió megtartása vagy kiválasztása</description>
    <description xml:lang="ia">Mantener o seliger un version del systema</description>
    <description xml:lang="id">Simpan atau pilih versi sistem</description>
    <description xml:lang="it">Conserva o scegli una versione del sistema</description>
    <description xml:lang="ja">システムバージョンの保持または選択</description>
    <description xml:lang="ka">სისტემის ვერსიის შენარჩუნება ან არჩევა</description>
    <description xml:lang="kab">Eǧǧ neɣ fren lqem n unagraw</description>
    <description xml:lang="kk">Жүйе нұсқасын сақтау немесе таңдау</description>
    <description xml:lang="ko">시스템 버전 유지 또는 선택</description>
    <description xml:lang="lo">ເກັບ ຫຼື ເລືອກເວີຊັນລະບົບ</description>
    <description xml:lang="lt">Išlaikyti arba pasirinkti sistemos versiją</description>
    <description xml:lang="nb">Behold eller velg en systemversjon</description>
    <description xml:lang="nl">Een systeemversie bewaren of kiezen</description>
    <description xml:lang="nn">Behald eller vel ein systemversjon</description>
    <description xml:lang="pa">ਸਿਸਟਮ ਵਰਜਨ ਰੱਖੋ ਜਾਂ ਚੁਣੋ</description>
    <description xml:lang="pl">Zachowaj lub wybierz wersję systemu</description>
    <description xml:lang="pt">Manter ou escolher uma versão do sistema</description>
    <description xml:lang="pt_BR">Manter ou escolher uma versão do sistema</description>
    <description xml:lang="ro">Păstrează sau alege o versiune a sistemului</description>
    <description xml:lang="ru">Сохранение или выбор версии системы</description>
    <description xml:lang="sk">Ponechanie alebo výber verzie systému</description>
    <description xml:lang="sl">Ohranitev ali izbira različice sistema</description>
    <description xml:lang="sq">Mbaj ose zgjidh një version të sistemit</description>
    <description xml:lang="sr">Задржавање или избор верзије система</description>
    <description xml:lang="sv">Behåll eller välj en systemversion</description>
    <description xml:lang="ta">கணினிப் பதிப்பை வைத்திரு அல்லது தேர்வுசெய்</description>
    <description xml:lang="tr">Bir sistem sürümünü koruma veya seçme</description>
    <description xml:lang="uk">Збереження або вибір версії системи</description>
    <description xml:lang="zh_CN">保留或选择系统版本</description>
    <description xml:lang="zh_TW">保留或選擇系統版本</description>
    <message>Sloth Center wants to keep a system version or choose it for the next start. Enter your password to allow it.</message>
    <message xml:lang="af">Sloth Center wil 'n stelselweergawe hou of dit vir die volgende begin kies. Tik jou wagwoord in om dit toe te laat.</message>
    <message xml:lang="ar">يريد Sloth Center الاحتفاظ بإصدار من النظام أو اختياره للتشغيل القادم. أدخل كلمة المرور للسماح بذلك.</message>
    <message xml:lang="as">Sloth Center-এ এটা চিষ্টেম সংস্কৰণ ৰাখিব বা পৰৱৰ্তী আৰম্ভণিৰ বাবে বাছিব বিচাৰে। অনুমতি দিবলৈ আপোনাৰ পাছৱৰ্ড দিয়ক।</message>
    <message xml:lang="be">Sloth Center хоча захаваць версію сістэмы або выбраць яе для наступнага запуску. Каб дазволіць гэта, увядзіце свой пароль.</message>
    <message xml:lang="bg">Sloth Center иска да запази версия на системата или да я избере за следващото стартиране. Въведете паролата си, за да го разрешите.</message>
    <message xml:lang="bn_IN">Sloth Center একটি সিস্টেম সংস্করণ রাখতে বা পরের বার চালু করার জন্য বেছে নিতে চায়। অনুমতি দিতে আপনার পাসওয়ার্ড লিখুন।</message>
    <message xml:lang="ca">Sloth Center vol conservar una versió del sistema o triar-la per al proper inici. Escriu la teva contrasenya per permetre-ho.</message>
    <message xml:lang="cs">Sloth Center chce ponechat verzi systému nebo ji vybrat pro příští spuštění. Pro povolení zadejte své heslo.</message>
    <message xml:lang="da">Sloth Center vil beholde en systemversion eller vælge den til næste opstart. Indtast din adgangskode for at tillade det.</message>
    <message xml:lang="de">Sloth Center möchte eine Systemversion behalten oder für den nächsten Start auswählen. Gib dein Passwort ein, um es zu erlauben.</message>
    <message xml:lang="el">Το Sloth Center θέλει να διατηρήσει μια έκδοση συστήματος ή να την επιλέξει για την επόμενη εκκίνηση. Εισαγάγετε τον κωδικό σας για να το επιτρέψετε.</message>
    <message xml:lang="eo">Sloth Center volas konservi sisteman version aŭ elekti ĝin por la sekva starto. Entajpu vian pasvorton por permesi tion.</message>
    <message xml:lang="es">Sloth Center quiere conservar una versión del sistema o elegirla para el próximo inicio. Escribe tu contraseña para permitirlo.</message>
    <message xml:lang="et">Sloth Center soovib süsteemi versiooni alles hoida või selle järgmiseks käivituseks valida. Selle lubamiseks sisesta oma parool.</message>
    <message xml:lang="fi">Sloth Center haluaa säilyttää järjestelmäversion tai valita sen seuraavaa käynnistystä varten. Anna salasanasi salliaksesi sen.</message>
    <message xml:lang="fr">Sloth Center veut conserver une version du système ou la choisir pour le prochain démarrage. Saisissez votre mot de passe pour l'autoriser.</message>
    <message xml:lang="fur">Sloth Center al vûl tignî une version dal sisteme o sielzile pe prossime inviade. Met la tô password par permetilu.</message>
    <message xml:lang="he">Sloth Center רוצה לשמור גרסת מערכת או לבחור אותה להפעלה הבאה. יש להזין את הסיסמה כדי לאשר זאת.</message>
    <message xml:lang="hr">Sloth Center želi zadržati verziju sustava ili je odabrati za sljedeće pokretanje. Upišite svoju lozinku da biste to dopustili.</message>
    <message xml:lang="hu">A Sloth Központ egy rendszerverziót szeretne megtartani vagy a következő indításra kiválasztani. Ehhez add meg a jelszavad.</message>
    <message xml:lang="ia">Sloth Center vole mantener un version del systema o seliger lo pro le proxime initio. Entra tu contrasigno pro permitter lo.</message>
    <message xml:lang="id">Sloth Center ingin menyimpan versi sistem atau memilihnya untuk mulai berikutnya. Masukkan kata sandi Anda untuk mengizinkannya.</message>
    <message xml:lang="it">Sloth Center vuole conservare una versione del sistema o sceglierla per il prossimo avvio. Inserisci la tua password per consentirlo.</message>
    <message xml:lang="ja">Sloth Center がシステムバージョンを保持するか、次回の起動用に選択しようとしています。許可するにはパスワードを入力してください。</message>
    <message xml:lang="ka">Sloth Center-ს სურს სისტემის ვერსიის შენარჩუნება ან მისი არჩევა შემდეგი ჩართვისთვის. ნებართვისთვის შეიყვანეთ თქვენი პაროლი.</message>
    <message xml:lang="kab">Sloth Center yebɣa ad yeǧǧ lqem n unagraw neɣ ad t-yefren i usenker d-iteddun. Sekcem awal-ik uffir akken ad t-tsirgeḍ.</message>
    <message xml:lang="kk">Sloth Center жүйе нұсқасын сақтағысы немесе оны келесі іске қосу үшін таңдағысы келеді. Рұқсат беру үшін құпиясөзіңізді енгізіңіз.</message>
    <message xml:lang="ko">Sloth Center가 시스템 버전을 유지하거나 다음 시작에 사용할 버전으로 선택하려고 합니다. 허용하려면 비밀번호를 입력하세요.</message>
    <message xml:lang="lo">Sloth Center ຕ້ອງການເກັບເວີຊັນລະບົບ ຫຼື ເລືອກມັນສຳລັບການເລີ່ມຄັ້ງຕໍ່ໄປ. ກະລຸນາໃສ່ລະຫັດຜ່ານຂອງທ່ານເພື່ອອະນຸຍາດ.</message>
    <message xml:lang="lt">Sloth Center nori išlaikyti sistemos versiją arba pasirinkti ją kitam paleidimui. Norėdami tai leisti, įveskite savo slaptažodį.</message>
    <message xml:lang="nb">Sloth Center vil beholde en systemversjon eller velge den for neste oppstart. Skriv inn passordet ditt for å tillate det.</message>
    <message xml:lang="nl">Sloth Center wil een systeemversie bewaren of kiezen voor de volgende start. Voer je wachtwoord in om dit toe te staan.</message>
    <message xml:lang="nn">Sloth Center vil behalde ein systemversjon eller velje han for neste oppstart. Skriv inn passordet ditt for å tillate det.</message>
    <message xml:lang="pa">Sloth Center ਇੱਕ ਸਿਸਟਮ ਵਰਜਨ ਰੱਖਣਾ ਜਾਂ ਅਗਲੀ ਵਾਰ ਚਾਲੂ ਕਰਨ ਲਈ ਚੁਣਨਾ ਚਾਹੁੰਦਾ ਹੈ। ਇਜਾਜ਼ਤ ਦੇਣ ਲਈ ਆਪਣਾ ਪਾਸਵਰਡ ਦਿਓ।</message>
    <message xml:lang="pl">Sloth Center chce zachować wersję systemu lub wybrać ją do następnego uruchomienia. Wpisz swoje hasło, aby na to zezwolić.</message>
    <message xml:lang="pt">O Sloth Center quer manter uma versão do sistema ou escolhê-la para o próximo arranque. Introduza a sua palavra-passe para o permitir.</message>
    <message xml:lang="pt_BR">O Sloth Center quer manter uma versão do sistema ou escolhê-la para a próxima inicialização. Digite sua senha para permitir.</message>
    <message xml:lang="ro">Sloth Center vrea să păstreze o versiune a sistemului sau s-o aleagă pentru următoarea pornire. Introdu parola pentru a permite acest lucru.</message>
    <message xml:lang="ru">Sloth Center хочет сохранить версию системы или выбрать её для следующего запуска. Введите свой пароль, чтобы разрешить это.</message>
    <message xml:lang="sk">Sloth Center chce ponechať verziu systému alebo ju vybrať pre ďalšie spustenie. Na povolenie zadajte svoje heslo.</message>
    <message xml:lang="sl">Sloth Center želi ohraniti različico sistema ali jo izbrati za naslednji zagon. Vnesite svoje geslo, da to dovolite.</message>
    <message xml:lang="sq">Sloth Center dëshiron të mbajë një version të sistemit ose ta zgjedhë për nisjen e ardhshme. Shkruaj fjalëkalimin për ta lejuar.</message>
    <message xml:lang="sr">Sloth Center жели да задржи верзију система или да је изабере за следеће покретање. Унесите своју лозинку да бисте то дозволили.</message>
    <message xml:lang="sv">Sloth Center vill behålla en systemversion eller välja den för nästa start. Ange ditt lösenord för att tillåta det.</message>
    <message xml:lang="ta">Sloth Center ஒரு கணினிப் பதிப்பை வைத்திருக்க அல்லது அடுத்த தொடக்கத்திற்குத் தேர்வுசெய்ய விரும்புகிறது. அனுமதிக்க உங்கள் கடவுச்சொல்லை உள்ளிடவும்.</message>
    <message xml:lang="tr">Sloth Center bir sistem sürümünü korumak veya bir sonraki başlatma için seçmek istiyor. İzin vermek için parolanızı girin.</message>
    <message xml:lang="uk">Sloth Center хоче зберегти версію системи або вибрати її для наступного запуску. Введіть свій пароль, щоб дозволити це.</message>
    <message xml:lang="zh_CN">Sloth Center 想要保留一个系统版本，或将其选为下次启动的版本。请输入密码以允许此操作。</message>
    <message xml:lang="zh_TW">Sloth Center 想要保留一個系統版本，或將它選為下次啟動的版本。請輸入密碼以允許此操作。</message>
    <icon_name>sloth-os</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/sloth-os/sloth-helper-versions</annotate>
  </action>
  <action id="org.slothos.helper.backup">
    <description>Back up your own files now</description>
    <description xml:lang="af">Rugsteun nou jou eie lêers</description>
    <description xml:lang="ar">نسخ ملفاتك احتياطيًا الآن</description>
    <description xml:lang="as">এতিয়াই নিজৰ ফাইলৰ বেকআপ লওক</description>
    <description xml:lang="be">Зрабіць рэзервовую копію сваіх файлаў зараз</description>
    <description xml:lang="bg">Резервно копие на вашите файлове сега</description>
    <description xml:lang="bn_IN">এখনই নিজের ফাইলের ব্যাকআপ নিন</description>
    <description xml:lang="ca">Fes ara una còpia de seguretat dels teus fitxers</description>
    <description xml:lang="cs">Záloha vlastních souborů nyní</description>
    <description xml:lang="da">Sikkerhedskopiér dine egne filer nu</description>
    <description xml:lang="de">Deine eigenen Dateien jetzt sichern</description>
    <description xml:lang="el">Αντίγραφο ασφαλείας των αρχείων σας τώρα</description>
    <description xml:lang="eo">Savkopii viajn proprajn dosierojn nun</description>
    <description xml:lang="es">Hacer ahora una copia de seguridad de tus archivos</description>
    <description xml:lang="et">Varunda kohe oma failid</description>
    <description xml:lang="fi">Varmuuskopioi omat tiedostosi nyt</description>
    <description xml:lang="fr">Sauvegarder vos fichiers maintenant</description>
    <description xml:lang="fur">Fâs cumò une copie di sigurece dai tiei files</description>
    <description xml:lang="he">גיבוי הקבצים שלך עכשיו</description>
    <description xml:lang="hr">Sigurnosna kopija vlastitih datoteka sada</description>
    <description xml:lang="hu">A saját fájlok mentése most</description>
    <description xml:lang="ia">Facer ora un copia de reserva de tu proprie files</description>
    <description xml:lang="id">Cadangkan file Anda sendiri sekarang</description>
    <description xml:lang="it">Esegui ora il backup dei tuoi file</description>
    <description xml:lang="ja">自分のファイルを今すぐバックアップ</description>
    <description xml:lang="ka">საკუთარი ფაილების სარეზერვო ასლი ახლავე</description>
    <description xml:lang="kab">Sekles tura ifuyla-ik</description>
    <description xml:lang="kk">Өз файлдарыңыздың сақтық көшірмесін қазір жасау</description>
    <description xml:lang="ko">지금 내 파일 백업</description>
    <description xml:lang="lo">ສຳຮອງໄຟລ໌ຂອງທ່ານດຽວນີ້</description>
    <description xml:lang="lt">Dabar sukurti savo failų atsarginę kopiją</description>
    <description xml:lang="nb">Sikkerhetskopier dine egne filer nå</description>
    <description xml:lang="nl">Nu een back-up van je eigen bestanden maken</description>
    <description xml:lang="nn">Ta tryggleikskopi av dine eigne filer no</description>
    <description xml:lang="pa">ਹੁਣੇ ਆਪਣੀਆਂ ਫ਼ਾਈਲਾਂ ਦਾ ਬੈਕਅੱਪ ਲਓ</description>
    <description xml:lang="pl">Utwórz teraz kopię zapasową swoich plików</description>
    <description xml:lang="pt">Fazer já uma cópia de segurança dos seus ficheiros</description>
    <description xml:lang="pt_BR">Fazer agora o backup dos seus arquivos</description>
    <description xml:lang="ro">Fă acum o copie de siguranță a propriilor fișiere</description>
    <description xml:lang="ru">Резервное копирование своих файлов сейчас</description>
    <description xml:lang="sk">Záloha vlastných súborov teraz</description>
    <description xml:lang="sl">Varnostno kopiranje lastnih datotek zdaj</description>
    <description xml:lang="sq">Bëj tani kopjeruajtje të skedarëve të tu</description>
    <description xml:lang="sr">Резервна копија сопствених датотека сада</description>
    <description xml:lang="sv">Säkerhetskopiera dina egna filer nu</description>
    <description xml:lang="ta">உங்கள் கோப்புகளை இப்போதே காப்புப்பிரதி எடு</description>
    <description xml:lang="tr">Kendi dosyalarınızı şimdi yedekleme</description>
    <description xml:lang="uk">Резервне копіювання власних файлів зараз</description>
    <description xml:lang="zh_CN">立即备份你自己的文件</description>
    <description xml:lang="zh_TW">立即備份你自己的檔案</description>
    <message>Sloth Center is saving the current state of your files.</message>
    <message xml:lang="af">Sloth Center stoor die huidige toestand van jou lêers.</message>
    <message xml:lang="ar">يحفظ Sloth Center الحالة الحالية لملفاتك.</message>
    <message xml:lang="as">Sloth Center-এ আপোনাৰ ফাইলৰ বৰ্তমান অৱস্থা ছেভ কৰি আছে।</message>
    <message xml:lang="be">Sloth Center захоўвае цяперашні стан вашых файлаў.</message>
    <message xml:lang="bg">Sloth Center запазва текущото състояние на вашите файлове.</message>
    <message xml:lang="bn_IN">Sloth Center আপনার ফাইলগুলির বর্তমান অবস্থা সংরক্ষণ করছে।</message>
    <message xml:lang="ca">Sloth Center està desant l'estat actual dels teus fitxers.</message>
    <message xml:lang="cs">Sloth Center ukládá současný stav vašich souborů.</message>
    <message xml:lang="da">Sloth Center gemmer den nuværende tilstand af dine filer.</message>
    <message xml:lang="de">Sloth Center sichert den aktuellen Stand deiner Dateien.</message>
    <message xml:lang="el">Το Sloth Center αποθηκεύει την τρέχουσα κατάσταση των αρχείων σας.</message>
    <message xml:lang="eo">Sloth Center konservas la nunan staton de viaj dosieroj.</message>
    <message xml:lang="es">Sloth Center está guardando el estado actual de tus archivos.</message>
    <message xml:lang="et">Sloth Center salvestab sinu failide praeguse seisu.</message>
    <message xml:lang="fi">Sloth Center tallentaa tiedostojesi nykyisen tilan.</message>
    <message xml:lang="fr">Sloth Center enregistre l'état actuel de vos fichiers.</message>
    <message xml:lang="fur">Sloth Center al sta salvant il stât di cumò dai tiei files.</message>
    <message xml:lang="he">Sloth Center שומר את המצב הנוכחי של הקבצים שלך.</message>
    <message xml:lang="hr">Sloth Center sprema trenutno stanje vaših datoteka.</message>
    <message xml:lang="hu">A Sloth Központ elmenti a fájljaid mostani állapotát.</message>
    <message xml:lang="ia">Sloth Center salva le stato actual de tu files.</message>
    <message xml:lang="id">Sloth Center sedang menyimpan keadaan file Anda saat ini.</message>
    <message xml:lang="it">Sloth Center sta salvando lo stato attuale dei tuoi file.</message>
    <message xml:lang="ja">Sloth Center がファイルの現在の状態を保存しています。</message>
    <message xml:lang="ka">Sloth Center ინახავს თქვენი ფაილების ამჟამინდელ მდგომარეობას.</message>
    <message xml:lang="kab">Sloth Center yettsekles addad n tura n yifuyla-ik.</message>
    <message xml:lang="kk">Sloth Center файлдарыңыздың қазіргі күйін сақтап жатыр.</message>
    <message xml:lang="ko">Sloth Center가 파일의 현재 상태를 저장하고 있습니다.</message>
    <message xml:lang="lo">Sloth Center ກຳລັງບັນທຶກສະຖານະປັດຈຸບັນຂອງໄຟລ໌ຂອງທ່ານ.</message>
    <message xml:lang="lt">Sloth Center įrašo dabartinę jūsų failų būseną.</message>
    <message xml:lang="nb">Sloth Center lagrer den nåværende tilstanden til filene dine.</message>
    <message xml:lang="nl">Sloth Center slaat de huidige staat van je bestanden op.</message>
    <message xml:lang="nn">Sloth Center lagrar den noverande tilstanden til filene dine.</message>
    <message xml:lang="pa">Sloth Center ਤੁਹਾਡੀਆਂ ਫ਼ਾਈਲਾਂ ਦੀ ਮੌਜੂਦਾ ਹਾਲਤ ਸੰਭਾਲ ਰਿਹਾ ਹੈ।</message>
    <message xml:lang="pl">Sloth Center zapisuje bieżący stan twoich plików.</message>
    <message xml:lang="pt">O Sloth Center está a guardar o estado atual dos seus ficheiros.</message>
    <message xml:lang="pt_BR">O Sloth Center está salvando o estado atual dos seus arquivos.</message>
    <message xml:lang="ro">Sloth Center salvează starea actuală a fișierelor tale.</message>
    <message xml:lang="ru">Sloth Center сохраняет текущее состояние ваших файлов.</message>
    <message xml:lang="sk">Sloth Center ukladá aktuálny stav vašich súborov.</message>
    <message xml:lang="sl">Sloth Center shranjuje trenutno stanje vaših datotek.</message>
    <message xml:lang="sq">Sloth Center po ruan gjendjen e tanishme të skedarëve të tu.</message>
    <message xml:lang="sr">Sloth Center чува тренутно стање ваших датотека.</message>
    <message xml:lang="sv">Sloth Center sparar det nuvarande tillståndet för dina filer.</message>
    <message xml:lang="ta">Sloth Center உங்கள் கோப்புகளின் தற்போதைய நிலையைச் சேமிக்கிறது.</message>
    <message xml:lang="tr">Sloth Center dosyalarınızın şu anki durumunu kaydediyor.</message>
    <message xml:lang="uk">Sloth Center зберігає поточний стан ваших файлів.</message>
    <message xml:lang="zh_CN">Sloth Center 正在保存你的文件的当前状态。</message>
    <message xml:lang="zh_TW">Sloth Center 正在儲存你的檔案目前的狀態。</message>
    <icon_name>sloth-os</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/sloth-os/sloth-helper-backup</annotate>
  </action>
  <action id="org.slothos.helper.netlimit">
    <description>Set the download speed limit</description>
    <description xml:lang="af">Stel die aflaaispoedlimiet</description>
    <description xml:lang="ar">تعيين حد سرعة التنزيل</description>
    <description xml:lang="as">ডাউনলোডৰ গতিৰ সীমা ছেট কৰক</description>
    <description xml:lang="be">Задаць абмежаванне хуткасці спампоўвання</description>
    <description xml:lang="bg">Задаване на ограничение на скоростта на изтегляне</description>
    <description xml:lang="bn_IN">ডাউনলোডের গতির সীমা সেট করুন</description>
    <description xml:lang="ca">Estableix el límit de velocitat de baixada</description>
    <description xml:lang="cs">Nastavení omezení rychlosti stahování</description>
    <description xml:lang="da">Indstil grænsen for downloadhastighed</description>
    <description xml:lang="de">Die Begrenzung der Download-Geschwindigkeit festlegen</description>
    <description xml:lang="el">Ορισμός ορίου ταχύτητας λήψης</description>
    <description xml:lang="eo">Agordi la limon de elŝuta rapido</description>
    <description xml:lang="es">Establecer el límite de velocidad de descarga</description>
    <description xml:lang="et">Määra allalaadimiskiiruse piirang</description>
    <description xml:lang="fi">Aseta latausnopeuden raja</description>
    <description xml:lang="fr">Définir la limite de vitesse de téléchargement</description>
    <description xml:lang="fur">Stabilìs il limit di velocitât di discjariament</description>
    <description xml:lang="he">הגדרת מגבלת מהירות ההורדה</description>
    <description xml:lang="hr">Postavljanje ograničenja brzine preuzimanja</description>
    <description xml:lang="hu">A letöltési sebességkorlát beállítása</description>
    <description xml:lang="ia">Definir le limite de velocitate de discargamento</description>
    <description xml:lang="id">Atur batas kecepatan unduh</description>
    <description xml:lang="it">Imposta il limite di velocità di download</description>
    <description xml:lang="ja">ダウンロード速度の上限の設定</description>
    <description xml:lang="ka">ჩამოტვირთვის სიჩქარის ლიმიტის დაყენება</description>
    <description xml:lang="kab">Sbadu talast n urured n usader</description>
    <description xml:lang="kk">Жүктеп алу жылдамдығының шегін орнату</description>
    <description xml:lang="ko">다운로드 속도 제한 설정</description>
    <description xml:lang="lo">ຕັ້ງຂີດຈຳກັດຄວາມໄວການດາວໂຫຼດ</description>
    <description xml:lang="lt">Nustatyti atsisiuntimo greičio ribą</description>
    <description xml:lang="nb">Angi grensen for nedlastingshastighet</description>
    <description xml:lang="nl">De limiet voor downloadsnelheid instellen</description>
    <description xml:lang="nn">Set grensa for nedlastingsfart</description>
    <description xml:lang="pa">ਡਾਊਨਲੋਡ ਸਪੀਡ ਦੀ ਸੀਮਾ ਸੈੱਟ ਕਰੋ</description>
    <description xml:lang="pl">Ustaw limit prędkości pobierania</description>
    <description xml:lang="pt">Definir o limite de velocidade de transferência</description>
    <description xml:lang="pt_BR">Definir o limite de velocidade de download</description>
    <description xml:lang="ro">Setează limita vitezei de descărcare</description>
    <description xml:lang="ru">Установка ограничения скорости загрузки</description>
    <description xml:lang="sk">Nastavenie obmedzenia rýchlosti sťahovania</description>
    <description xml:lang="sl">Nastavitev omejitve hitrosti prenosa</description>
    <description xml:lang="sq">Cakto kufirin e shpejtësisë së shkarkimit</description>
    <description xml:lang="sr">Подешавање ограничења брзине преузимања</description>
    <description xml:lang="sv">Ange gränsen för nedladdningshastighet</description>
    <description xml:lang="ta">பதிவிறக்க வேக வரம்பை அமை</description>
    <description xml:lang="tr">İndirme hızı sınırını ayarlama</description>
    <description xml:lang="uk">Встановлення обмеження швидкості завантаження</description>
    <description xml:lang="zh_CN">设置下载速度限制</description>
    <description xml:lang="zh_TW">設定下載速度限制</description>
    <message>Sloth Center is setting how fast this computer downloads.</message>
    <message xml:lang="af">Sloth Center stel hoe vinnig hierdie rekenaar aflaai.</message>
    <message xml:lang="ar">يضبط Sloth Center سرعة التنزيل على هذا الحاسوب.</message>
    <message xml:lang="as">Sloth Center-এ এই কম্পিউটাৰে কিমান দ্ৰুতভাৱে ডাউনলোড কৰে সেয়া ছেট কৰি আছে।</message>
    <message xml:lang="be">Sloth Center задае, як хутка гэты камп'ютар спампоўвае.</message>
    <message xml:lang="bg">Sloth Center задава колко бързо изтегля този компютър.</message>
    <message xml:lang="bn_IN">Sloth Center এই কম্পিউটার কত দ্রুত ডাউনলোড করবে তা সেট করছে।</message>
    <message xml:lang="ca">Sloth Center està establint la velocitat a què baixa aquest ordinador.</message>
    <message xml:lang="cs">Sloth Center nastavuje, jak rychle tento počítač stahuje.</message>
    <message xml:lang="da">Sloth Center indstiller, hvor hurtigt denne computer downloader.</message>
    <message xml:lang="de">Sloth Center legt fest, wie schnell dieser Computer herunterlädt.</message>
    <message xml:lang="el">Το Sloth Center ορίζει πόσο γρήγορα κατεβάζει αυτός ο υπολογιστής.</message>
    <message xml:lang="eo">Sloth Center agordas, kiom rapide ĉi tiu komputilo elŝutas.</message>
    <message xml:lang="es">Sloth Center está ajustando la velocidad de descarga de este equipo.</message>
    <message xml:lang="et">Sloth Center määrab, kui kiiresti see arvuti alla laadib.</message>
    <message xml:lang="fi">Sloth Center asettaa, kuinka nopeasti tämä tietokone lataa.</message>
    <message xml:lang="fr">Sloth Center règle la vitesse de téléchargement de cet ordinateur.</message>
    <message xml:lang="fur">Sloth Center al sta stabilint trop svelt che chest computer al discjame.</message>
    <message xml:lang="he">Sloth Center מגדיר באיזו מהירות המחשב הזה מוריד.</message>
    <message xml:lang="hr">Sloth Center postavlja koliko brzo ovo računalo preuzima.</message>
    <message xml:lang="hu">A Sloth Központ beállítja, milyen gyorsan tölt le ez a gép.</message>
    <message xml:lang="ia">Sloth Center defini le velocitate de discargamento de iste computator.</message>
    <message xml:lang="id">Sloth Center sedang mengatur seberapa cepat komputer ini mengunduh.</message>
    <message xml:lang="it">Sloth Center sta impostando la velocità di download di questo computer.</message>
    <message xml:lang="ja">Sloth Center がこのコンピューターのダウンロード速度を設定しています。</message>
    <message xml:lang="ka">Sloth Center აყენებს, რა სიჩქარით ჩამოტვირთავს ეს კომპიუტერი.</message>
    <message xml:lang="kab">Sloth Center yettsbadu arured n usader n uselkim-a.</message>
    <message xml:lang="kk">Sloth Center бұл компьютердің қаншалықты жылдам жүктеп алатынын орнатып жатыр.</message>
    <message xml:lang="ko">Sloth Center가 이 컴퓨터의 다운로드 속도를 설정하고 있습니다.</message>
    <message xml:lang="lo">Sloth Center ກຳລັງຕັ້ງຄວາມໄວໃນການດາວໂຫຼດຂອງຄອມພິວເຕີນີ້.</message>
    <message xml:lang="lt">Sloth Center nustato, kaip greitai šis kompiuteris atsisiunčia.</message>
    <message xml:lang="nb">Sloth Center angir hvor raskt denne datamaskinen laster ned.</message>
    <message xml:lang="nl">Sloth Center stelt in hoe snel deze computer downloadt.</message>
    <message xml:lang="nn">Sloth Center stiller inn kor raskt denne datamaskina lastar ned.</message>
    <message xml:lang="pa">Sloth Center ਸੈੱਟ ਕਰ ਰਿਹਾ ਹੈ ਕਿ ਇਹ ਕੰਪਿਊਟਰ ਕਿੰਨੀ ਤੇਜ਼ੀ ਨਾਲ ਡਾਊਨਲੋਡ ਕਰੇ।</message>
    <message xml:lang="pl">Sloth Center ustawia, jak szybko ten komputer pobiera dane.</message>
    <message xml:lang="pt">O Sloth Center está a definir a velocidade a que este computador transfere.</message>
    <message xml:lang="pt_BR">O Sloth Center está definindo a velocidade de download deste computador.</message>
    <message xml:lang="ro">Sloth Center setează cât de repede descarcă acest calculator.</message>
    <message xml:lang="ru">Sloth Center задаёт, насколько быстро этот компьютер загружает данные.</message>
    <message xml:lang="sk">Sloth Center nastavuje, ako rýchlo tento počítač sťahuje.</message>
    <message xml:lang="sl">Sloth Center nastavlja, kako hitro ta računalnik prenaša.</message>
    <message xml:lang="sq">Sloth Center po cakton sa shpejt shkarkon ky kompjuter.</message>
    <message xml:lang="sr">Sloth Center подешава колико брзо овај рачунар преузима.</message>
    <message xml:lang="sv">Sloth Center ställer in hur snabbt den här datorn laddar ner.</message>
    <message xml:lang="ta">இந்தக் கணினி எவ்வளவு வேகமாகப் பதிவிறக்க வேண்டும் என்பதை Sloth Center அமைக்கிறது.</message>
    <message xml:lang="tr">Sloth Center bu bilgisayarın ne kadar hızlı indireceğini ayarlıyor.</message>
    <message xml:lang="uk">Sloth Center задає, як швидко цей комп'ютер завантажує дані.</message>
    <message xml:lang="zh_CN">Sloth Center 正在设置这台电脑的下载速度。</message>
    <message xml:lang="zh_TW">Sloth Center 正在設定這台電腦的下載速度。</message>
    <icon_name>sloth-os</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/sloth-os/sloth-helper-netlimit</annotate>
  </action>
  <!-- Always with the password (no keep, and no Sloth Center topic contains it): sharing a folder, and
       turning sharing on or off altogether -->
  <action id="org.slothos.helper.sharing">
    <description>Change folder sharing on the network</description>
    <description xml:lang="af">Verander vouerdeling op die netwerk</description>
    <description xml:lang="ar">تغيير مشاركة المجلدات على الشبكة</description>
    <description xml:lang="as">নেটৱৰ্কত ফোল্ডাৰ শ্বেয়াৰিং সলনি কৰক</description>
    <description xml:lang="be">Змяніць агульны доступ да папак у сетцы</description>
    <description xml:lang="bg">Промяна на споделянето на папки в мрежата</description>
    <description xml:lang="bn_IN">নেটওয়ার্কে ফোল্ডার শেয়ারিং পরিবর্তন করুন</description>
    <description xml:lang="ca">Canvia la compartició de carpetes a la xarxa</description>
    <description xml:lang="cs">Změna sdílení složek v síti</description>
    <description xml:lang="da">Ændr deling af mapper på netværket</description>
    <description xml:lang="de">Ordnerfreigabe im Netzwerk ändern</description>
    <description xml:lang="el">Αλλαγή κοινής χρήσης φακέλων στο δίκτυο</description>
    <description xml:lang="eo">Ŝanĝi kunhavigon de dosierujoj en la reto</description>
    <description xml:lang="es">Cambiar el uso compartido de carpetas en la red</description>
    <description xml:lang="et">Muuda kaustade jagamist võrgus</description>
    <description xml:lang="fi">Muuta kansioiden jakamista verkossa</description>
    <description xml:lang="fr">Modifier le partage de dossiers sur le réseau</description>
    <description xml:lang="fur">Cambie la condivision des cartelis te rêt</description>
    <description xml:lang="he">שינוי שיתוף התיקיות ברשת</description>
    <description xml:lang="hr">Promjena dijeljenja mapa na mreži</description>
    <description xml:lang="hu">A mappamegosztás módosítása a hálózaton</description>
    <description xml:lang="ia">Cambiar le compartimento de dossiers in le rete</description>
    <description xml:lang="id">Ubah berbagi folder di jaringan</description>
    <description xml:lang="it">Modifica la condivisione delle cartelle in rete</description>
    <description xml:lang="ja">ネットワークでのフォルダー共有の変更</description>
    <description xml:lang="ka">საქაღალდეების გაზიარების შეცვლა ქსელში</description>
    <description xml:lang="kab">Beddel beṭṭu n yikaramen deg uẓeṭṭa</description>
    <description xml:lang="kk">Желідегі қалталарды ортақ етуді өзгерту</description>
    <description xml:lang="ko">네트워크 폴더 공유 변경</description>
    <description xml:lang="lo">ປ່ຽນການແບ່ງປັນໂຟນເດີໃນເຄືອຂ່າຍ</description>
    <description xml:lang="lt">Keisti aplankų bendrinimą tinkle</description>
    <description xml:lang="nb">Endre mappedeling på nettverket</description>
    <description xml:lang="nl">Mappen delen op het netwerk wijzigen</description>
    <description xml:lang="nn">Endre mappedeling på nettverket</description>
    <description xml:lang="pa">ਨੈੱਟਵਰਕ 'ਤੇ ਫੋਲਡਰ ਸਾਂਝਾ ਕਰਨਾ ਬਦਲੋ</description>
    <description xml:lang="pl">Zmień udostępnianie folderów w sieci</description>
    <description xml:lang="pt">Alterar a partilha de pastas na rede</description>
    <description xml:lang="pt_BR">Alterar o compartilhamento de pastas na rede</description>
    <description xml:lang="ro">Modifică partajarea dosarelor în rețea</description>
    <description xml:lang="ru">Изменение общего доступа к папкам в сети</description>
    <description xml:lang="sk">Zmena zdieľania priečinkov v sieti</description>
    <description xml:lang="sl">Sprememba skupne rabe map v omrežju</description>
    <description xml:lang="sq">Ndrysho ndarjen e dosjeve në rrjet</description>
    <description xml:lang="sr">Промена дељења фасцикли на мрежи</description>
    <description xml:lang="sv">Ändra mappdelning i nätverket</description>
    <description xml:lang="ta">பிணையத்தில் கோப்புறைப் பகிர்வை மாற்று</description>
    <description xml:lang="tr">Ağda klasör paylaşımını değiştirme</description>
    <description xml:lang="uk">Зміна спільного доступу до тек у мережі</description>
    <description xml:lang="zh_CN">更改网络上的文件夹共享</description>
    <description xml:lang="zh_TW">變更網路上的資料夾分享</description>
    <message>Sloth Center wants to change folder sharing on the network. Enter your password to allow it.</message>
    <message xml:lang="af">Sloth Center wil vouerdeling op die netwerk verander. Tik jou wagwoord in om dit toe te laat.</message>
    <message xml:lang="ar">يريد Sloth Center تغيير مشاركة المجلدات على الشبكة. أدخل كلمة المرور للسماح بذلك.</message>
    <message xml:lang="as">Sloth Center-এ নেটৱৰ্কত ফোল্ডাৰ শ্বেয়াৰিং সলনি কৰিব বিচাৰে। অনুমতি দিবলৈ আপোনাৰ পাছৱৰ্ড দিয়ক।</message>
    <message xml:lang="be">Sloth Center хоча змяніць агульны доступ да папак у сетцы. Каб дазволіць гэта, увядзіце свой пароль.</message>
    <message xml:lang="bg">Sloth Center иска да промени споделянето на папки в мрежата. Въведете паролата си, за да го разрешите.</message>
    <message xml:lang="bn_IN">Sloth Center নেটওয়ার্কে ফোল্ডার শেয়ারিং পরিবর্তন করতে চায়। অনুমতি দিতে আপনার পাসওয়ার্ড লিখুন।</message>
    <message xml:lang="ca">Sloth Center vol canviar la compartició de carpetes a la xarxa. Escriu la teva contrasenya per permetre-ho.</message>
    <message xml:lang="cs">Sloth Center chce změnit sdílení složek v síti. Pro povolení zadejte své heslo.</message>
    <message xml:lang="da">Sloth Center vil ændre deling af mapper på netværket. Indtast din adgangskode for at tillade det.</message>
    <message xml:lang="de">Sloth Center möchte die Ordnerfreigabe im Netzwerk ändern. Gib dein Passwort ein, um es zu erlauben.</message>
    <message xml:lang="el">Το Sloth Center θέλει να αλλάξει την κοινή χρήση φακέλων στο δίκτυο. Εισαγάγετε τον κωδικό σας για να το επιτρέψετε.</message>
    <message xml:lang="eo">Sloth Center volas ŝanĝi la kunhavigon de dosierujoj en la reto. Entajpu vian pasvorton por permesi tion.</message>
    <message xml:lang="es">Sloth Center quiere cambiar el uso compartido de carpetas en la red. Escribe tu contraseña para permitirlo.</message>
    <message xml:lang="et">Sloth Center soovib muuta kaustade jagamist võrgus. Selle lubamiseks sisesta oma parool.</message>
    <message xml:lang="fi">Sloth Center haluaa muuttaa kansioiden jakamista verkossa. Anna salasanasi salliaksesi sen.</message>
    <message xml:lang="fr">Sloth Center veut modifier le partage de dossiers sur le réseau. Saisissez votre mot de passe pour l'autoriser.</message>
    <message xml:lang="fur">Sloth Center al vûl cambiâ la condivision des cartelis te rêt. Met la tô password par permetilu.</message>
    <message xml:lang="he">Sloth Center רוצה לשנות את שיתוף התיקיות ברשת. יש להזין את הסיסמה כדי לאשר זאת.</message>
    <message xml:lang="hr">Sloth Center želi promijeniti dijeljenje mapa na mreži. Upišite svoju lozinku da biste to dopustili.</message>
    <message xml:lang="hu">A Sloth Központ módosítani szeretné a mappamegosztást a hálózaton. Ehhez add meg a jelszavad.</message>
    <message xml:lang="ia">Sloth Center vole cambiar le compartimento de dossiers in le rete. Entra tu contrasigno pro permitter lo.</message>
    <message xml:lang="id">Sloth Center ingin mengubah berbagi folder di jaringan. Masukkan kata sandi Anda untuk mengizinkannya.</message>
    <message xml:lang="it">Sloth Center vuole modificare la condivisione delle cartelle in rete. Inserisci la tua password per consentirlo.</message>
    <message xml:lang="ja">Sloth Center がネットワークでのフォルダー共有を変更しようとしています。許可するにはパスワードを入力してください。</message>
    <message xml:lang="ka">Sloth Center-ს სურს ქსელში საქაღალდეების გაზიარების შეცვლა. ნებართვისთვის შეიყვანეთ თქვენი პაროლი.</message>
    <message xml:lang="kab">Sloth Center yebɣa ad ibeddel beṭṭu n yikaramen deg uẓeṭṭa. Sekcem awal-ik uffir akken ad t-tsirgeḍ.</message>
    <message xml:lang="kk">Sloth Center желідегі қалталарды ортақ етуді өзгерткісі келеді. Рұқсат беру үшін құпиясөзіңізді енгізіңіз.</message>
    <message xml:lang="ko">Sloth Center가 네트워크 폴더 공유를 변경하려고 합니다. 허용하려면 비밀번호를 입력하세요.</message>
    <message xml:lang="lo">Sloth Center ຕ້ອງການປ່ຽນການແບ່ງປັນໂຟນເດີໃນເຄືອຂ່າຍ. ກະລຸນາໃສ່ລະຫັດຜ່ານຂອງທ່ານເພື່ອອະນຸຍາດ.</message>
    <message xml:lang="lt">Sloth Center nori pakeisti aplankų bendrinimą tinkle. Norėdami tai leisti, įveskite savo slaptažodį.</message>
    <message xml:lang="nb">Sloth Center vil endre mappedeling på nettverket. Skriv inn passordet ditt for å tillate det.</message>
    <message xml:lang="nl">Sloth Center wil het delen van mappen op het netwerk wijzigen. Voer je wachtwoord in om dit toe te staan.</message>
    <message xml:lang="nn">Sloth Center vil endre mappedeling på nettverket. Skriv inn passordet ditt for å tillate det.</message>
    <message xml:lang="pa">Sloth Center ਨੈੱਟਵਰਕ 'ਤੇ ਫੋਲਡਰ ਸਾਂਝਾ ਕਰਨਾ ਬਦਲਣਾ ਚਾਹੁੰਦਾ ਹੈ। ਇਜਾਜ਼ਤ ਦੇਣ ਲਈ ਆਪਣਾ ਪਾਸਵਰਡ ਦਿਓ।</message>
    <message xml:lang="pl">Sloth Center chce zmienić udostępnianie folderów w sieci. Wpisz swoje hasło, aby na to zezwolić.</message>
    <message xml:lang="pt">O Sloth Center quer alterar a partilha de pastas na rede. Introduza a sua palavra-passe para o permitir.</message>
    <message xml:lang="pt_BR">O Sloth Center quer alterar o compartilhamento de pastas na rede. Digite sua senha para permitir.</message>
    <message xml:lang="ro">Sloth Center vrea să modifice partajarea dosarelor în rețea. Introdu parola pentru a permite acest lucru.</message>
    <message xml:lang="ru">Sloth Center хочет изменить общий доступ к папкам в сети. Введите свой пароль, чтобы разрешить это.</message>
    <message xml:lang="sk">Sloth Center chce zmeniť zdieľanie priečinkov v sieti. Na povolenie zadajte svoje heslo.</message>
    <message xml:lang="sl">Sloth Center želi spremeniti skupno rabo map v omrežju. Vnesite svoje geslo, da to dovolite.</message>
    <message xml:lang="sq">Sloth Center dëshiron të ndryshojë ndarjen e dosjeve në rrjet. Shkruaj fjalëkalimin për ta lejuar.</message>
    <message xml:lang="sr">Sloth Center жели да промени дељење фасцикли на мрежи. Унесите своју лозинку да бисте то дозволили.</message>
    <message xml:lang="sv">Sloth Center vill ändra mappdelning i nätverket. Ange ditt lösenord för att tillåta det.</message>
    <message xml:lang="ta">Sloth Center பிணையத்தில் கோப்புறைப் பகிர்வை மாற்ற விரும்புகிறது. அனுமதிக்க உங்கள் கடவுச்சொல்லை உள்ளிடவும்.</message>
    <message xml:lang="tr">Sloth Center ağdaki klasör paylaşımını değiştirmek istiyor. İzin vermek için parolanızı girin.</message>
    <message xml:lang="uk">Sloth Center хоче змінити спільний доступ до тек у мережі. Введіть свій пароль, щоб дозволити це.</message>
    <message xml:lang="zh_CN">Sloth Center 想要更改网络上的文件夹共享。请输入密码以允许此操作。</message>
    <message xml:lang="zh_TW">Sloth Center 想要變更網路上的資料夾分享。請輸入密碼以允許此操作。</message>
    <icon_name>sloth-os</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/sloth-os/sloth-helper-sharing</annotate>
  </action>
  <!-- Without a password at the computer (like Wi-Fi settings): the question comes at every new network -->
  <action id="org.slothos.helper.network">
    <description>Set whether a network is private or public</description>
    <description xml:lang="af">Stel of 'n netwerk privaat of publiek is</description>
    <description xml:lang="ar">تحديد ما إذا كانت الشبكة خاصة أم عامة</description>
    <description xml:lang="as">নেটৱৰ্ক ব্যক্তিগত নে ৰাজহুৱা ছেট কৰক</description>
    <description xml:lang="be">Задаць, ці сетка прыватная або публічная</description>
    <description xml:lang="bg">Задаване дали мрежата е частна или публична</description>
    <description xml:lang="bn_IN">নেটওয়ার্ক ব্যক্তিগত না সর্বজনীন তা সেট করুন</description>
    <description xml:lang="ca">Indica si una xarxa és privada o pública</description>
    <description xml:lang="cs">Nastavení, zda je síť soukromá, nebo veřejná</description>
    <description xml:lang="da">Angiv, om et netværk er privat eller offentligt</description>
    <description xml:lang="de">Festlegen, ob ein Netzwerk privat oder öffentlich ist</description>
    <description xml:lang="el">Ορισμός αν ένα δίκτυο είναι ιδιωτικό ή δημόσιο</description>
    <description xml:lang="eo">Agordi, ĉu reto estas privata aŭ publika</description>
    <description xml:lang="es">Indicar si una red es privada o pública</description>
    <description xml:lang="et">Määra, kas võrk on privaatne või avalik</description>
    <description xml:lang="fi">Aseta, onko verkko yksityinen vai julkinen</description>
