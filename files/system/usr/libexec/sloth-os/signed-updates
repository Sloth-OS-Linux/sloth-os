#!/usr/bin/python3 -I
"""Switches already installed machines to signature-verified updates (once, in the background).

On newly installed machines the installer already sets this (sloth-install-helper: use_signed_updates).
Older installs update with an unverified reference (ostree-unverified-registry); these are
switched once (rpm-ostree rebase to the same image, ostree-image-signed:docker://). If there is already a
prepared version waiting for a restart (an update or the NVIDIA switch), its reference is
switched, so it is not lost. Only if policy.json requires a signature for this image; if the
verification fails, the old one stays (we try again next time).
"""
import json
import subprocess
import sys
from pathlib import Path

DONE = Path("/var/lib/sloth-os/signed-updates-done")
NVIDIA_STATE = Path("/var/lib/sloth-os/nvidia-auto")
POLICY = Path("/etc/containers/policy.json")
UNVERIFIED = "ostree-unverified-registry:"
SIGNED = "ostree-image-signed:docker://"
OURS = ("ghcr.io/sloth-os-linux/sloth-os", "ghcr.io/sloth-os-linux/sloth-os-nvidia")


def done(reason):
    DONE.parent.mkdir(parents=True, exist_ok=True)
    DONE.write_text(reason + "\n")
    print(reason)
    return 0


def main():
    if DONE.exists():
        return 0
    try:
        if NVIDIA_STATE.read_text().strip() == "downloading":
            print("The NVIDIA version is being downloaded, later.")
            return 0
    except OSError:
        pass
    status = json.loads(subprocess.run(["rpm-ostree", "status", "--json"], capture_output=True, text=True,
                                       timeout=120).stdout or "{}")
    deployments = status.get("deployments", [])
    if not deployments:
        return 1
    # the first one starts at the next start (the prepared one if there is one; otherwise the current one)
    ref = deployments[0].get("container-image-reference", "")
    if ref.startswith(SIGNED):
        return done("already signature-verified")
    if not ref.startswith(UNVERIFIED):
        return done(f"not a container reference: {ref}")
    image = ref[len(UNVERIFIED):]
    repo = image.rsplit(":", 1)[0]
    if repo not in OURS:
        return done(f"not a Sloth OS image: {image}")
    try:
        rules = json.loads(POLICY.read_text()).get("transports", {}).get("docker", {}).get(repo, [])
    except (OSError, ValueError):
        rules = []
    if not rules or rules[0].get("type") != "sigstoreSigned":
        print(f"policy.json has no signature rule for this yet: {repo}; again after the next update.")
        return 0
    r = subprocess.run(["nmcli", "--terse", "--fields", "CONNECTIVITY", "general"], capture_output=True, text=True)
    if r.stdout.strip() not in ("full", "unknown"):
        print("No internet, trying again later.")
        return 0
    target = SIGNED + image
    print(f"Switching: {ref} -> {target}")
    r = subprocess.run(["nice", "-n", "19", "ionice", "-c", "3", "rpm-ostree", "rebase", target])
    if r.returncode != 0:
        print("Failed (keeping the unverified one), trying again later.", file=sys.stderr)
        return 1
    return done(f"switched: {target}")


if __name__ == "__main__":
    sys.exit(main())
