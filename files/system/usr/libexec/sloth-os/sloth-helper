#!/usr/bin/python3 -I
"""Sloth OS administrator helper: the GUI tools do their root operations through it.

It can only be started with pkexec (polkit: org.slothos.helper, graphical password prompt).
Every operation is fixed in advance and the parameters are checked strictly;
it cannot run arbitrary commands.

Operations:
  secureboot-status          Secure Boot state and whether the Sloth OS key is enrolled (JSON)
  secureboot-enroll          prepares enrolling the key for the next restart
  boot-menu hidden|visible   hides the GRUB boot menu / always shows it
  pin <index> | unpin <index>  keeps / releases a system version
  set-default <index>        this (already installed) version starts at the next restart
  admin-policy               the calling user's password-free administrator settings (JSON on the input:
                             {"topics": [...], "sudo": bool, "autologin": bool})
  login-feature fingerprint|securitykey on|off   signing in with a fingerprint / security key (authselect)
  login-repair                                   turns with-altfiles back on if authselect removed it
                                                 (at startup, sloth-login-repair.service)
  domain-join <domain> <user>                    joins an Active Directory domain (password on the input)
  domain-leave                                   leaves the domain
  registry-login <registry> <user>               signs in to an image registry for updates and switching
                                                 images (token on the input; /etc/ostree/auth.json)
  registry-logout <registry>                     signs out
  pin-set                                        a PIN for the calling user (the PIN on the input, 4–8 digits);
                                                 turns on the with-sloth-pin feature of the "sloth" authselect profile
  pin-remove                                     deletes the calling user's PIN
  zram default|more|off                          memory compression (zram swap) size from the next start
  snapshots on|off                               automatic backup of your own files (hourly snapshot)
  snapshots-keep 2w|1m|3m                        how long saved states are kept (2 weeks, 1 month, 3 months)
  snapshot-now                                   back up now (home-snapshots take --now)
  snapshots-delete-all                           deletes all saved states
  factory-reset keep|all                         prepares resetting the computer (factory-reset
                                                 prepare; JSON on the input, JSON lines on the output)
  factory-reset-cancel                           withdraws a reset that has not been done yet
  update-time default|<0-23>                     the hour the automatic system update (rpm-ostreed-automatic.timer)
                                                 runs, instead of the base image's triggers (an hour after start,
                                                 daily, 4:00)
  share-add                                      shares a folder of the calling user on the home network, always
                                                 (JSON on the input: {"name", "path", "write", "guests",
                                                 "password"}; without guests, a Samba password is needed the
                                                 first time)
  share-remove <name>                            stops sharing the calling user's folder
  net-limit off|<kbit/s> <unit> always|updates   the download speed limit (/etc/sloth-os/net-limit.json; the unit
                                                 the user chose: kbit, KB, Mbit, MB), put on or off at once
                                                 (/usr/libexec/sloth-os/net-limit)

The operations on versions (pin, unpin, set-default) and update-time are also available under the name
sloth-helper-versions: that is a separate polkit action (org.slothos.helper.versions), so it can be put
under the "updates" topic, not under booting. net-limit alone is available as sloth-helper-netlimit, without a
password (org.slothos.helper.netlimit): it only slows the computer's downloads down. share-add and share-remove
are available only as sloth-helper-sharing (org.slothos.helper.sharing), which always asks for the password.
"""
import json
import os
import pwd
import re
import subprocess
import sys
import tempfile

SB_KEY = "/etc/pki/akmods/certs/akmods-ublue.der"
# Started as sloth-helper-versions, only the operations on versions are allowed
VERSIONS_ONLY = os.path.basename(sys.argv[0]) == "sloth-helper-versions"
# Started as sloth-helper-backup, only "Back up now" (without a password, see org.slothos.helper.backup)
BACKUP_ONLY = os.path.basename(sys.argv[0]) == "sloth-helper-backup"
# Started as sloth-helper-sharing, only folder sharing (always with the password, see org.slothos.helper.sharing);
# folder sharing is not available through the other names
SHARING_ONLY = os.path.basename(sys.argv[0]) == "sloth-helper-sharing"
# Started as sloth-helper-netlimit, only the download speed limit (without a password, see org.slothos.helper.netlimit)
NETLIMIT_ONLY = os.path.basename(sys.argv[0]) == "sloth-helper-netlimit"
# The Universal Blue key's enrollment password; the user types this on the blue screen
SB_PASSWORD = "universalblue"


def run(cmd, **kw):
    return subprocess.run(cmd, capture_output=True, text=True, timeout=120, **kw)


def secureboot_status():
    sb = run(["mokutil", "--sb-state"])
    enabled = "enabled" in (sb.stdout + sb.stderr).lower()
    enrolled = None
    pending = False
    if os.path.exists(SB_KEY):
        t = run(["mokutil", "--test-key", SB_KEY])
        out = (t.stdout + t.stderr).lower()
        enrolled = "already enrolled" in out
        pending = "already in the enrollment request" in out
    return {"secureBoot": enabled, "keyPresent": os.path.exists(SB_KEY),
            "enrolled": enrolled, "pending": pending}


def secureboot_enroll():
    if not os.path.exists(SB_KEY):
        return {"ok": False, "error": "no key"}
    run(["mokutil", "--timeout", "-1"])
    r = run(["mokutil", "--import", SB_KEY], input=f"{SB_PASSWORD}\n{SB_PASSWORD}\n")
    ok = r.returncode == 0 or "already" in (r.stdout + r.stderr).lower()
    return {"ok": ok, "error": "" if ok else (r.stderr or r.stdout).strip()}


def boot_menu(mode):
    # The state is on the EFI partition; GRUB reads it in /boot/grub2/custom.cfg (see boot-env)
    value = "0" if mode == "hidden" else "1"
    run(["/usr/libexec/sloth-os/boot-env", "ensure-config"])
    r = run(["/usr/libexec/sloth-os/boot-env", "set", f"sloth_show_menu={value}"])
    os.makedirs("/var/lib/sloth-os", exist_ok=True)
    # Marker file so the GUI can see the state without a password (grubenv is readable by root only)
    marker = "/var/lib/sloth-os/boot-menu-visible"
    if mode == "visible":
        open(marker, "w").close()
    elif os.path.exists(marker):
        os.unlink(marker)
    return {"ok": r.returncode == 0, "error": r.stderr.strip()}


def pin(index, unpin=False):
    cmd = ["ostree", "admin", "pin"] + (["--unpin"] if unpin else []) + [str(index)]
    r = run(cmd)
    return {"ok": r.returncode == 0, "error": r.stderr.strip()}


def set_default(index):
    r = run(["ostree", "admin", "set-default", str(index)])
    return {"ok": r.returncode == 0, "error": r.stderr.strip()}


# --- Password-free administrator by topic ------------------------------------------

POLICY = "/etc/sloth-os/admin-policy.json"
POLKIT_RULES = "/etc/polkit-1/rules.d/49-sloth-admin.rules"
SUDOERS = "/etc/sudoers.d/49-sloth-nopasswd"
AUTOLOGIN = ["/etc/plasmalogin.conf.d/90-sloth-autologin.conf", "/etc/sddm.conf.d/90-sloth-autologin.conf"]

# Topic -> polkit actions. An item ending in "." is a prefix (every action under it).
TOPICS = {
    "software": ["org.freedesktop.Flatpak.", "org.freedesktop.packagekit."],
    "updates": ["org.projectatomic.rpmostree1.upgrade", "org.projectatomic.rpmostree1.repo-refresh",
                "org.projectatomic.rpmostree1.rollback", "org.projectatomic.rpmostree1.cleanup",
                "org.slothos.helper.versions", "org.freedesktop.fwupd."],
    "network": ["org.freedesktop.NetworkManager.", "org.bluez.", "org.freedesktop.ModemManager1.",
                "org.opensuse.cupspkhelper.mechanism.", "org.freedesktop.udisks2.filesystem-mount",
                "org.freedesktop.udisks2.eject-media", "org.freedesktop.udisks2.power-off-drive"],
    "datetime": ["org.freedesktop.timedate1.", "org.freedesktop.locale1.", "org.freedesktop.hostname1."],
    "services": ["org.freedesktop.systemd1.manage-units", "org.freedesktop.systemd1.manage-unit-files",
                 "org.freedesktop.systemd1.reload-daemon", "org.projectatomic.rpmostree1.rebase"],
    "disks": ["org.freedesktop.udisks2.", "org.kde.kpmcore."],
    "users": ["org.freedesktop.accounts.", "org.freedesktop.home1."],
    "system": ["org.projectatomic.rpmostree1.", "org.slothos.helper", "org.freedesktop.login1.set-reboot-",
               "org.freedesktop.systemd1."],
}


def _js(value):
    return json.dumps(value, ensure_ascii=True)


def _write(path, text, mode=0o644):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path))
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(text)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def _render_rules(users):
    allowed = {u: sorted({a for t in cfg.get("topics", []) for a in TOPICS.get(t, [])})
               for u, cfg in users.items() if cfg.get("topics")}
    if not allowed:
        return None
    return f"""// Written by Sloth Center (Account and security): these actions need no password.
// Do not edit by hand; the source: {POLICY}
polkit.addRule(function(action, subject) {{
    var allowed = {_js(allowed)};
    var list = allowed[subject.user];
    if (!list || !subject.local || !subject.active || !subject.isInGroup("wheel"))
        return polkit.Result.NOT_HANDLED;
    for (var i = 0; i < list.length; i++) {{
        var a = list[i];
        if (a.charAt(a.length - 1) == "." ? action.id.indexOf(a) == 0 : action.id == a)
            return polkit.Result.YES;
    }}
    return polkit.Result.NOT_HANDLED;
}});
"""


def _apply_sudoers(users):
    names = sorted(u for u, cfg in users.items() if cfg.get("sudo"))
    if not names:
        if os.path.exists(SUDOERS):
            os.unlink(SUDOERS)
        return True
    text = "# Written by Sloth Center (Account and security): sudo without a password.\n"
    text += "".join(f"{n} ALL=(ALL) NOPASSWD: ALL\n" for n in names)
    fd, tmp = tempfile.mkstemp()
    with os.fdopen(fd, "w") as f:
        f.write(text)
    ok = run(["visudo", "-c", "-f", tmp]).returncode == 0
    if ok:
        _write(SUDOERS, text, 0o440)
    os.unlink(tmp)
    return ok


def _apply_autologin(users):
    name = next((u for u, cfg in users.items() if cfg.get("autologin")), None)
    for path in AUTOLOGIN:
        if name:
            _write(path, f"# Written by Sloth Center (Account and security).\n[Autologin]\nUser={name}\nSession=plasma.desktop\n")
        elif os.path.exists(path):
            os.unlink(path)


def admin_policy(request):
    uid = os.environ.get("PKEXEC_UID", "")
    if not uid.isdigit():
        return {"ok": False, "error": "pkexec only"}
    user = pwd.getpwuid(int(uid)).pw_name
    topics = request.get("topics", [])
    if not isinstance(topics, list) or not all(t in TOPICS for t in topics):
        return {"ok": False, "error": "unknown topic"}
    in_wheel = user in subprocess.run(["getent", "group", "wheel"], capture_output=True,
                                      text=True).stdout.strip().split(":")[-1].split(",")
    if (topics or request.get("sudo")) and not in_wheel:
        return {"ok": False, "error": "not an administrator"}
    try:
        policy = json.load(open(POLICY, encoding="utf-8"))
    except (OSError, ValueError):
        policy = {"users": {}}
    users = policy.setdefault("users", {})
    autologin = bool(request.get("autologin"))
    if autologin:  # only one user can sign in automatically at a time
        for cfg in users.values():
            cfg["autologin"] = False
    users[user] = {"topics": sorted(set(topics)), "sudo": bool(request.get("sudo")), "autologin": autologin}
    users = {u: c for u, c in users.items() if c["topics"] or c["sudo"] or c["autologin"]}
    policy["users"] = users
    _write(POLICY, json.dumps(policy, indent=2, ensure_ascii=False) + "\n")
    rules = _render_rules(users)
    if rules:
        _write(POLKIT_RULES, rules)
    elif os.path.exists(POLKIT_RULES):
        os.unlink(POLKIT_RULES)
    if not _apply_sudoers(users):
        return {"ok": False, "error": "sudoers"}
    _apply_autologin(users)
    return {"ok": True, "error": ""}


# --- Sign-in methods ------------------------------------------------------------------

LOGIN_FEATURES = {"fingerprint": "with-fingerprint", "securitykey": "with-pam-u2f"}
DOMAIN_RE = re.compile(r"^[A-Za-z0-9]([A-Za-z0-9-]{0,62}\.)+[A-Za-z]{2,63}$")
DOMAIN_USER_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")


# On an Atomic system the system users (e.g. "plasmalogin", the login screen's user) are in /usr/lib/passwd,
# and they are only visible through nss-altfiles. authselect rewrites /etc/nsswitch.conf on every change,
# and without with-altfiles it removes it: then the login screen does not even start (2026-10-20, real machine:
# after turning on fingerprint + PIN; reproduced in a VM). So we always keep it on.
ALTFILES = "with-altfiles"


def _needs_altfiles(profile="local"):
    """Only where the system users live in /usr/lib/passwd, and only if the profile has the feature at all: Fedora
    44's "local" profile no longer has it (it reads altfiles by itself), enabling it there fails at every boot."""
    if not os.path.isfile("/usr/lib/passwd"):
        return False
    return ALTFILES in run(["authselect", "list-features", profile]).stdout.split()


def keep_altfiles():
    """If with-altfiles is missing from the selected authselect profile, turns it on (at startup too: login-repair)."""
    current = run(["authselect", "current", "--raw"]).stdout.split()
    if not current or ALTFILES in current[1:] or not _needs_altfiles(current[0]):
        return {"ok": True, "changed": False}
    r = run(["authselect", "enable-feature", ALTFILES])
    return {"ok": r.returncode == 0, "error": r.stderr.strip(), "changed": True}


def login_feature(name, on):
    feature = LOGIN_FEATURES[name]
    if not run(["authselect", "current", "--raw"]).stdout.strip():
        # no authselect profile yet: we start with Fedora's default, backing up the existing files
        extra = [ALTFILES] if _needs_altfiles() else []
        r = run(["authselect", "select", "local", *extra, "--force", "--backup=sloth-os"])
        if r.returncode != 0:
            return {"ok": False, "error": r.stderr.strip()}
    r = run(["authselect", "enable-feature" if on else "disable-feature", feature])
    fixed = keep_altfiles()
    # On the real machine authselect may return an error code even though it switched the feature (2026-10-21: red
    # error message, but fingerprint got turned on): what matters is whether it really ends up that way
    done = (feature in run(["authselect", "current", "--raw"]).stdout.split()[1:]) == on
    return {"ok": done and fixed["ok"], "error": (r.stderr or r.stdout).strip()[-500:] or fixed.get("error", "")}


def domain_join(domain, user, password):
    r = run(["realm", "join", "--user", user, domain], input=password + "\n")
    keep_altfiles()  # realm selects the sssd profile, likewise without with-altfiles
    return {"ok": r.returncode == 0, "error": (r.stderr or r.stdout).strip()[-500:]}


def domain_leave():
    r = run(["realm", "leave"])
    return {"ok": r.returncode == 0, "error": (r.stderr or r.stdout).strip()[-500:]}


# --- Image registry (private GitHub packages from the developer panel) ----------------------------------

OSTREE_AUTH = "/etc/ostree/auth.json"
REGISTRY_RE = re.compile(r"^(ghcr\.io|quay\.io|docker\.io)$")
REGISTRY_USER_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9-]{0,38}$")
TOKEN_RE = re.compile(r"^[A-Za-z0-9_]{20,255}$")


def _read_auth():
    try:
        with open(OSTREE_AUTH, encoding="utf-8") as f:
            data = json.load(f)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def registry_login(registry, user, token):
    """rpm-ostree / bootc read the private registry's credentials from this (readable by root only)."""
    if not TOKEN_RE.match(token):
        return {"ok": False, "error": "bad token"}
    import base64
    data = _read_auth()
    data.setdefault("auths", {})[registry] = {"auth": base64.b64encode(f"{user}:{token}".encode()).decode()}
    os.makedirs(os.path.dirname(OSTREE_AUTH), exist_ok=True)
    _write(OSTREE_AUTH, json.dumps(data, indent=2) + "\n", mode=0o600)
    return {"ok": True}


def registry_logout(registry):
    data = _read_auth()
    if registry in data.get("auths", {}):
        del data["auths"][registry]
        _write(OSTREE_AUTH, json.dumps(data, indent=2) + "\n", mode=0o600)
    return {"ok": True}


# --- PIN (sign-in; checked by /usr/libexec/sloth-os/pin-check) -------------------------

PIN_DIR = "/etc/sloth-os/pin"
PIN_STATE_DIR = "/var/lib/sloth-os/pin"
PIN_RE = re.compile(r"^\d{4,8}$")


def _caller():
    uid = os.environ.get("PKEXEC_UID", "")
    return pwd.getpwuid(int(uid)) if uid.isdigit() else None


def _weak_pin(pin):
    """Easy to guess: all the same digit, or a sequence going up / down one by one."""
    steps = {int(b) - int(a) for a, b in zip(pin, pin[1:])}
    return len(set(pin)) == 1 or steps in ({1}, {-1})


def _ensure_pin_profile(on):
    """The "sloth" authselect profile ("local" + with-sloth-pin), keeping the existing features."""
    current = run(["authselect", "current", "--raw"]).stdout.split()
    profile, features = (current[0], current[1:]) if current else ("", [])
    features = [f for f in features if f != "with-sloth-pin"] + (["with-sloth-pin"] if on else [])
    if _needs_altfiles() and ALTFILES not in features:
        features.append(ALTFILES)
    if profile in ("sloth", "vendor/sloth"):
        r = run(["authselect", "enable-feature" if on else "disable-feature", "with-sloth-pin"])
    elif on:
        r = run(["authselect", "select", "sloth", *features, "--force", "--backup=sloth-os-pin"])
    else:
        return keep_altfiles()
    fixed = keep_altfiles()
    return {"ok": r.returncode == 0 and fixed["ok"], "error": r.stderr.strip() or fixed.get("error", "")}


def pin_set(pin):
    pw = _caller()
    if pw is None:
        return {"ok": False, "error": "pkexec only"}
    if not PIN_RE.match(pin):
        return {"ok": False, "error": "bad PIN"}
    if _weak_pin(pin):
        return {"ok": False, "error": "weak PIN"}
    import hashlib
    import secrets
    salt = secrets.token_bytes(16)
    params = {"n": 2 ** 15, "r": 8, "p": 1}
    digest = hashlib.scrypt(pin.encode(), salt=salt, maxmem=128 * 1024 * 1024, dklen=32, **params)
    record = {"v": 1, "salt": salt.hex(), "hash": digest.hex(), "len": len(pin), **params}
    os.makedirs(PIN_DIR, mode=0o755, exist_ok=True)
    os.makedirs(PIN_STATE_DIR, mode=0o755, exist_ok=True)
    path = os.path.join(PIN_DIR, f"{pw.pw_name}.json")
    _write(path, json.dumps(record) + "\n", mode=0o640)
    # the lock screen checks in the user's name: their group can read it (the hash is scrypt, salted)
    os.chown(path, 0, pw.pw_gid)
    state = os.path.join(PIN_STATE_DIR, f"{pw.pw_name}.json")
    if os.path.exists(state):
        os.unlink(state)
    return _ensure_pin_profile(True)


def pin_remove():
    pw = _caller()
    if pw is None:
        return {"ok": False, "error": "pkexec only"}
    for path in (os.path.join(PIN_DIR, f"{pw.pw_name}.json"), os.path.join(PIN_STATE_DIR, f"{pw.pw_name}.json")):
        if os.path.exists(path):
            os.unlink(path)
    # if nobody has a PIN any more, the feature goes off too
    if not any(f.endswith(".json") for f in (os.listdir(PIN_DIR) if os.path.isdir(PIN_DIR) else [])):
        return _ensure_pin_profile(False)
    return {"ok": True}


# --- Memory compression (zram) -------------------------------------------------------------------

ZRAM_CONF = "/etc/systemd/zram-generator.conf"
ZRAM_MARK = "# sloth-os: "
# A Fedora alapja (/usr/lib/systemd/zram-generator.conf): zram-size = min(ram, 8192)
ZRAM_SIZES = {"more": "min(ram * 1.5, 24576)", "off": None}


def zram(mode):
    if mode == "default":
        if os.path.exists(ZRAM_CONF):
            with open(ZRAM_CONF, encoding="utf-8") as f:
                ours = f.readline().startswith(ZRAM_MARK)
            if ours:
                os.unlink(ZRAM_CONF)
            else:  # a hand-written file: set it aside, do not delete it
                os.replace(ZRAM_CONF, ZRAM_CONF + ".bak")
        return {"ok": True}
    size = ZRAM_SIZES[mode]
    text = f"{ZRAM_MARK}{mode} (Sloth Center -> Advanced settings)\n"
    # a file without a zram device: no zram (according to the zram-generator documentation)
    if size:
        text += f"[zram0]\nzram-size = {size}\ncompression-algorithm = zstd\n"
    _write(ZRAM_CONF, text)
    return {"ok": True}


# --- When the automatic update runs (Sloth Center → Updates) -----------------------------------------------

# rpm-ostreed-automatic.timer downloads and prepares the system update. The base image runs it an hour after start,
# a day after its last run and daily at 4:00; Persistent=true makes a missed run happen at the next start
UPDATE_TIMER_UNIT = "rpm-ostreed-automatic.timer"
# systemd applies the drop-ins of every folder in the order of their file names: "zz-" comes after Universal Blue's
# override.conf (OnCalendar 4:00), so ours clears that too ("50-" came before it and the 4:00 stayed, 2026-10-28)
UPDATE_TIME_CONF = f"/etc/systemd/system/{UPDATE_TIMER_UNIT}.d/zz-sloth-time.conf"


def update_time(hour):
    """hour: "default" (the base image's triggers) or 0–23: then only at that hour (or at the next start)."""
    if hour == "default":
        try:
            os.unlink(UPDATE_TIME_CONF)
        except FileNotFoundError:
            pass
    else:
        os.makedirs(os.path.dirname(UPDATE_TIME_CONF), exist_ok=True)
        # an empty value clears the base image's triggers (systemd.timer), the last line sets ours
        _write(UPDATE_TIME_CONF, "# sloth-os: Sloth Center -> Updates\n[Timer]\nOnBootSec=\nOnUnitInactiveSec=\n"
                                 f"OnCalendar=\nOnCalendar=*-*-* {int(hour):02d}:00:00\n")
    run(["systemctl", "daemon-reload"])
    # the timer works out its next run again (only if it is on: a switched-off timer stays off)
    run(["systemctl", "try-restart", UPDATE_TIMER_UNIT])
    return {"ok": True}


# --- The download speed limit (Sloth Center → System status; sloth_common.net_limit) ------------------------------

NET_LIMIT_CONF = "/etc/sloth-os/net-limit.json"
NET_LIMIT = "/usr/libexec/sloth-os/net-limit"
NET_LIMIT_UNITS = ("kbit", "KB", "Mbit", "MB")


def net_limit(kbit, unit, when):
    """kbit: "off" or the limit in kbit/s (64 – 10 000 000); unit: the one the user chose (only shown);
    when: "always" or "updates"."""
    if kbit == "off":
        try:
            os.unlink(NET_LIMIT_CONF)
        except FileNotFoundError:
            pass
    else:
        os.makedirs(os.path.dirname(NET_LIMIT_CONF), exist_ok=True)
        _write(NET_LIMIT_CONF, json.dumps({"kbit": int(kbit), "unit": unit, "when": when}) + "\n")
    r = subprocess.run([NET_LIMIT, "apply"], capture_output=True, text=True, timeout=60)
    return {"ok": r.returncode == 0}


# --- Sharing a folder on the home network (Sloth Center → Disks; /usr/libexec/sloth-os/file-sharing) -------------

FILE_SHARING = "/usr/libexec/sloth-os/file-sharing"
SHARE_NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$")


def _samba_has_password(user):
    r = run(["pdbedit", "-L"])
    return any(line.split(":")[0] == user for line in r.stdout.splitlines())


def share_add(request):
    pw = _caller()
    if pw is None:
        return {"ok": False, "error": "pkexec only"}
    name, path, password = request.get("name"), request.get("path"), request.get("password") or ""
    if not isinstance(name, str) or not SHARE_NAME_RE.match(name) or not isinstance(path, str) \
            or not isinstance(password, str) or len(password) > 127 or "\n" in password:
        return {"ok": False, "error": "bad input"}
    path = os.path.realpath(path)
    try:
        st = os.stat(path)
    except OSError:
        return {"ok": False, "error": "not owner"}
    # only the caller's own folder, never a system folder (Samba checks this too: usershare owner only)
    if not os.path.isdir(path) or st.st_uid != pw.pw_uid or path.count("/") < 2:
        return {"ok": False, "error": "not owner"}
    guests = request.get("guests") is True
    if not guests and not password and not _samba_has_password(pw.pw_name):
        return {"ok": False, "error": "password needed"}
    run([FILE_SHARING, "groups"])
    run(["usermod", "--append", "--groups", "usershares", pw.pw_name])
    if password:
        r = subprocess.run(["smbpasswd", "-s", "-a", pw.pw_name], input=f"{password}\n{password}\n",
                           capture_output=True, text=True)
        if r.returncode != 0:
            return {"ok": False, "error": r.stderr.strip()[-500:] or "smbpasswd"}
    acl = "Everyone:F" if request.get("write") else "Everyone:R"
    # as the user (runuser reads the groups again, so no new sign-in is needed)
    r = run(["runuser", "-u", pw.pw_name, "--", "net", "usershare", "add", name, path, "", acl,
             "guest_ok=y" if guests else "guest_ok=n"])
    if r.returncode != 0:
        return {"ok": False, "error": (r.stderr or r.stdout).strip()[-500:]}
    run([FILE_SHARING, "serve"])
    return {"ok": True}


def share_remove(name):
    pw = _caller()
    if pw is None:
        return {"ok": False, "error": "pkexec only"}
    r = run(["runuser", "-u", pw.pw_name, "--", "net", "usershare", "delete", name])
    run([FILE_SHARING, "serve"])
    return {"ok": r.returncode == 0, "error": (r.stderr or r.stdout).strip()[-500:]}


# --- Backing up your own files (Sloth Center → File backup; home-snapshots does the work) ------------------

SNAPSHOTS_CONF = "/etc/sloth-os/snapshots.json"
HOME_SNAPSHOTS = "/usr/libexec/sloth-os/home-snapshots"
FACTORY_RESET = "/usr/libexec/sloth-os/factory-reset"


def snapshots_config(**changes):
    try:
        with open(SNAPSHOTS_CONF, encoding="utf-8") as f:
            cfg = json.load(f)
        cfg = cfg if isinstance(cfg, dict) else {}
    except (OSError, ValueError):
        cfg = {}
    cfg.update(changes)
    _write(SNAPSHOTS_CONF, json.dumps(cfg, indent=2) + "\n")
    return {"ok": True}


def home_snapshots(*args):
    r = subprocess.run([HOME_SNAPSHOTS, *args], capture_output=True, text=True, timeout=600)
    try:
        return json.loads(r.stdout.strip().splitlines()[-1])
    except (ValueError, IndexError):
        return {"ok": False, "error": r.stderr.strip()[-500:]}


def main(argv):
    if os.geteuid() != 0:
        print(json.dumps({"ok": False, "error": "root needed"}))
        return 1
    if not argv:
        return 2
    op, args = argv[0], argv[1:]
    if (VERSIONS_ONLY and op not in ("pin", "unpin", "set-default", "update-time")) or (BACKUP_ONLY and (op, args) != ("snapshot-now", [])) \
            or (NETLIMIT_ONLY and op != "net-limit") or (SHARING_ONLY != (op in ("share-add", "share-remove"))):
        print(json.dumps({"ok": False, "error": "unknown operation"}))
        return 2
    if op == "secureboot-status" and not args:
        result = secureboot_status()
    elif op == "secureboot-enroll" and not args:
        result = secureboot_enroll()
    elif op == "boot-menu" and args in (["hidden"], ["visible"]):
        result = boot_menu(args[0])
    elif op in ("pin", "unpin") and len(args) == 1 and re.fullmatch(r"\d{1,2}", args[0]):
        result = pin(int(args[0]), unpin=(op == "unpin"))
    elif op == "set-default" and len(args) == 1 and re.fullmatch(r"\d{1,2}", args[0]):
        result = set_default(int(args[0]))
    elif op == "update-time" and len(args) == 1 and re.fullmatch(r"default|1?\d|2[0-3]", args[0]):
        result = update_time(args[0])
    elif op == "net-limit" and len(args) == 3 and (args[0] == "off" or (
            re.fullmatch(r"[1-9]\d{1,7}", args[0]) and 64 <= int(args[0]) <= 10_000_000)) \
            and args[1] in NET_LIMIT_UNITS and args[2] in ("always", "updates"):
        result = net_limit(*args)
    elif op == "login-feature" and len(args) == 2 and args[0] in LOGIN_FEATURES and args[1] in ("on", "off"):
        result = login_feature(args[0], args[1] == "on")
    elif op == "domain-join" and len(args) == 2 and DOMAIN_RE.match(args[0]) and DOMAIN_USER_RE.match(args[1]):
        result = domain_join(args[0], args[1], sys.stdin.readline().rstrip("\n"))
    elif op == "domain-leave" and not args:
        result = domain_leave()
    elif op == "registry-login" and len(args) == 2 and REGISTRY_RE.match(args[0]) and REGISTRY_USER_RE.match(args[1]):
        result = registry_login(args[0], args[1], sys.stdin.readline().strip())
    elif op == "registry-logout" and len(args) == 1 and REGISTRY_RE.match(args[0]):
        result = registry_logout(args[0])
    elif op == "pin-set" and not args and not VERSIONS_ONLY:
        result = pin_set(sys.stdin.readline().strip())
    elif op == "pin-remove" and not args and not VERSIONS_ONLY:
        result = pin_remove()
    elif op == "zram" and args in (["default"], ["more"], ["off"]) and not VERSIONS_ONLY:
        result = zram(args[0])
    elif op == "snapshots" and args in (["on"], ["off"]) and not VERSIONS_ONLY:
        result = snapshots_config(enabled=args[0] == "on")
    elif op == "snapshots-keep" and args in (["2w"], ["1m"], ["3m"]) and not VERSIONS_ONLY:
        result = snapshots_config(keep=args[0])
    elif op == "snapshot-now" and not args and not VERSIONS_ONLY:
        result = home_snapshots("take", "--now")
    elif op == "snapshots-delete-all" and not args and not VERSIONS_ONLY:
        result = home_snapshots("delete-all")
    elif op == "factory-reset" and args in (["keep"], ["all"]) and not VERSIONS_ONLY:
        # the process prints its steps line by line, so it produces the output directly (it reads the input too)
        sys.stdout.flush()
        os.execv(FACTORY_RESET, [FACTORY_RESET, "prepare", args[0]])
    elif op == "factory-reset-cancel" and not args and not VERSIONS_ONLY:
        r = subprocess.run([FACTORY_RESET, "cancel"], capture_output=True, text=True, timeout=600)
        try:
            result = json.loads(r.stdout.strip().splitlines()[-1])
        except (ValueError, IndexError):
            result = {"ok": False, "error": r.stderr.strip()[-500:]}
    elif op == "share-add" and not args and not VERSIONS_ONLY:
        try:
            request = json.loads(sys.stdin.read(4096) or "{}")
        except ValueError:
            request = None
        result = share_add(request) if isinstance(request, dict) else {"ok": False, "error": "bad input"}
    elif op == "share-remove" and len(args) == 1 and SHARE_NAME_RE.match(args[0]) and not VERSIONS_ONLY:
        result = share_remove(args[0])
    elif op == "login-repair" and not args and not VERSIONS_ONLY:
        result = keep_altfiles()
    elif op == "admin-policy" and not args and not VERSIONS_ONLY:
        try:
            request = json.loads(sys.stdin.read(4096) or "{}")
        except ValueError:
            request = None
        result = admin_policy(request) if isinstance(request, dict) else {"ok": False, "error": "bad input"}
    else:
        print(json.dumps({"ok": False, "error": "unknown operation"}))
        return 2
    print(json.dumps(result))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
