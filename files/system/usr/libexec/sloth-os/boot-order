#!/usr/bin/python3 -I
"""Next to Windows: if Windows (after a bigger update) put itself at the front of the boot order,
Sloth OS goes back to first place (otherwise the machine would start Windows directly, without the Sloth OS menu).

It runs at startup (sloth-boot-order.service). It only touches the order if "Windows Boot
Manager" is in first place and there is a "Sloth OS" entry (the installer names it so); it leaves everything else
alone (e.g. a USB stick the user put first). The Windows entry stays, and can be started from the Sloth OS menu.
"""
import re
import subprocess
import sys

OURS = "Sloth OS"
WINDOWS = "Windows Boot Manager"


def main():
    r = subprocess.run(["efibootmgr"], capture_output=True, text=True)
    if r.returncode != 0:
        return 0
    order, labels = [], {}
    for line in r.stdout.splitlines():
        if line.startswith("BootOrder:"):
            order = [x.strip() for x in line.split(":", 1)[1].split(",") if x.strip()]
        m = re.match(r"Boot([0-9A-Fa-f]{4})(\*?) (.*?)(\t|$)", line)
        if m:
            labels[m.group(1).upper()] = (m.group(3).strip(), m.group(2) == "*")
    order = [x.upper() for x in order]
    ours = [n for n in order if labels.get(n, ("", False)) == (OURS, True)]
    if not order or not ours or labels.get(order[0], ("",))[0] != WINDOWS:
        return 0
    new = [ours[0]] + [n for n in order if n != ours[0]]
    r = subprocess.run(["efibootmgr", "--quiet", "--bootorder", ",".join(new)], capture_output=True, text=True)
    print(f"Boot order: {','.join(order)} -> {','.join(new)}"
          + ("" if r.returncode == 0 else f" (failed: {r.stderr.strip()})"))
    return r.returncode


if __name__ == "__main__":
    sys.exit(main())
