#!/usr/bin/python3 -I
"""On an NVIDIA machine, the NVIDIA version automatically (only the AMD/Intel one fits on the installer ISO).

It runs in the background after the first starts (sloth-nvidia-auto.timer), once: if there is an NVIDIA graphics card and the
AMD/Intel version is running, it downloads and prepares the NVIDIA version (rpm-ostree rebase), which runs from the next
restart. Until then the open driver (nouveau) drives the card. If Secure Boot is on,
it also prepares enrolling the key (at the restart the machine asks for confirmation on a blue screen;
Sloth Center's Drivers page shows it step by step).
The state is in the /var/lib/sloth-os/nvidia-auto file; the user side notifies from it
(sloth-center/sloth_center/nvidia_notify.py): downloading | ready | ready-mok | failed.
If it has already run once (or there is no NVIDIA card), it does not run again: if the user later switches back by hand
in Sloth Center, we do not overwrite that.
"""
import json
import os
import subprocess
import sys
from pathlib import Path

STATE_DIR = Path("/var/lib/sloth-os")
DONE = STATE_DIR / "nvidia-auto-done"
STATE = STATE_DIR / "nvidia-auto"
SB_KEY = "/etc/pki/akmods/certs/akmods-ublue.der"
SB_PASSWORD = "universalblue"   # the same as in sloth-helper secureboot-enroll


def set_state(value):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    tmp = STATE.with_suffix(".tmp")
    tmp.write_text(value + "\n")
    tmp.chmod(0o644)
    tmp.replace(STATE)


def done(reason):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    DONE.write_text(reason + "\n")
    print(reason)
    return 0


def has_nvidia():
    for dev in Path("/sys/bus/pci/devices").iterdir():
        try:
            vendor = (dev / "vendor").read_text().strip()
            klass = (dev / "class").read_text().strip()
        except OSError:
            continue
        if vendor == "0x10de" and klass.startswith("0x03"):
            return True
    return False


def booted_image():
    out = subprocess.run(["rpm-ostree", "status", "--json"], capture_output=True, text=True, timeout=120).stdout
    for d in json.loads(out or "{}").get("deployments", []):
        if d.get("booted"):
            return d.get("container-image-reference", "")
    return ""


def online():
    r = subprocess.run(["nmcli", "--terse", "--fields", "CONNECTIVITY", "general"], capture_output=True, text=True)
    return r.stdout.strip() in ("full", "unknown")


def secure_boot_needs_key():
    sb = subprocess.run(["mokutil", "--sb-state"], capture_output=True, text=True).stdout.lower()
    if "enabled" not in sb or not os.path.exists(SB_KEY):
        return False
    t = subprocess.run(["mokutil", "--test-key", SB_KEY], capture_output=True, text=True)
    return "already enrolled" not in (t.stdout + t.stderr).lower()


def main():
    if DONE.exists():
        return 0
    if not has_nvidia():
        return done("no NVIDIA graphics card")
    image = booted_image()
    if "/sloth-os-nvidia:" in image:
        return done("the NVIDIA version is already running")
    if "/sloth-os:" not in image:
        return done(f"not the official Sloth OS image running ({image}), not switching")
    if not online():
        print("No internet, trying again later.")
        return 0
    target = image.replace("/sloth-os:", "/sloth-os-nvidia:", 1)
    print(f"Switching: {image} -> {target}")
    set_state("downloading")
    r = subprocess.run(["nice", "-n", "19", "ionice", "-c", "3", "rpm-ostree", "rebase", target])
    if r.returncode != 0:
        set_state("failed")
        print("Failed, trying again next time.", file=sys.stderr)
        return 1
    mok = False
    if secure_boot_needs_key():
        subprocess.run(["mokutil", "--timeout", "-1"], capture_output=True)
        k = subprocess.run(["mokutil", "--import", SB_KEY], input=f"{SB_PASSWORD}\n{SB_PASSWORD}\n",
                           capture_output=True, text=True)
        mok = k.returncode == 0 or "already" in (k.stdout + k.stderr).lower()
    set_state("ready-mok" if mok else "ready")
    return done("the NVIDIA version is prepared, it runs after a restart")


if __name__ == "__main__":
    sys.exit(main())
