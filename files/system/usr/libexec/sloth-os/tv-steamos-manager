#!/usr/bin/python3 -I
"""TV mode (/usr/libexec/sloth-os/tv-session): a stand-in for Valve's steamos-manager, only for switching sessions.

Steam's power menu → Switch to Desktop calls, on the session bus, com.steampowered.SteamOSManager1 (object
/com/steampowered/SteamOSManager1, interface com.steampowered.SteamOSManager1.SessionManagement1) SwitchToDesktopMode(),
a method without arguments; the interface also has SwitchToGameMode(). Checked against polaris'
src/steamos_session.h, which checks the real steamos-manager's interface (2026-11-16; Valve's own repository refuses
automated reading). Without the service Steam got org.freedesktop.DBus.Error.ServiceUnknown and waited for ever at
"Switching to desktop…" (the HP, its console-linux.txt).

SwitchToDesktopMode leaves the same note as tv-shim/steamos-session-select ($XDG_RUNTIME_DIR/sloth-tv/
switch-to-desktop) and answers at once; tv-session then closes Steam (10 s for it to close by itself) and the desktop
starts. SwitchToGameMode: already in it, nothing to do. Runs only while the TV session runs.
"""
import os
import sys
import time

from gi.repository import Gio, GLib

NAME = "com.steampowered.SteamOSManager1"
PATH = "/com/steampowered/SteamOSManager1"
# DefaultLoginMode: the interface has this property too (framemate's crates/agent/src/steamos.rs reads it); its type
# is not known for sure, a string ("game" / "desktop") is the likely one. tv-session logs every message Steam sends
# here (~/.cache/sloth-os/tv-dbus.log), to see what else Steam asks for.
XML = """<node>
  <interface name="com.steampowered.SteamOSManager1.SessionManagement1">
    <method name="SwitchToDesktopMode"/>
    <method name="SwitchToGameMode"/>
    <property name="DefaultLoginMode" type="s" access="readwrite"/>
  </interface>
</node>"""
login_mode = "game"
NOTES = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}", "sloth-tv")


def on_call(_conn, _sender, _path, _iface, method, _params, invocation):
    if method == "SwitchToDesktopMode":
        try:
            os.makedirs(NOTES, exist_ok=True)
            with open(os.path.join(NOTES, "switch-to-desktop"), "a", encoding="utf-8") as f:
                f.write(time.strftime("%F %T") + " SessionManagement1.SwitchToDesktopMode\n")
        except OSError as e:
            print(f"tv-steamos-manager: {e}", file=sys.stderr)
    invocation.return_value(None)


class _NoReply:
    """For on_call from a property change: there is no method call to answer."""
    def return_value(self, _value):
        pass


def main():
    node = Gio.DBusNodeInfo.new_for_xml(XML)
    loop = GLib.MainLoop()

    def get_property(_conn, _sender, _path, _iface, name):
        return GLib.Variant("s", login_mode) if name == "DefaultLoginMode" else None

    def set_property(_conn, _sender, _path, _iface, name, value):
        global login_mode
        if name == "DefaultLoginMode":
            login_mode = value.unpack()
            if login_mode == "desktop":       # perhaps Steam's way of asking for the desktop
                on_call(None, None, None, None, "SwitchToDesktopMode", None, _NoReply())
        return True

    log_path = os.path.join(os.path.expanduser("~/.cache/sloth-os"), "tv-steamos-manager.log")
    os.makedirs(os.path.dirname(log_path), exist_ok=True)
    log = open(log_path, "w", encoding="utf-8", buffering=1)

    def every_message(_conn, message, incoming):
        """Everything that reaches this service, whatever it asks (to see what Steam wants on Switch to Desktop)."""
        if incoming and message.get_message_type() != Gio.DBusMessageType.SIGNAL:
            log.write(f"{time.strftime('%T')} {message.get_sender()} {message.get_interface()} "
                      f"{message.get_member()} {message.get_path()} {message.get_signature()}\n")
        return message

    def on_bus(conn, _name):
        conn.add_filter(every_message)
        conn.register_object(PATH, node.interfaces[0], on_call, get_property, set_property)

    Gio.bus_own_name(Gio.BusType.SESSION, NAME, Gio.BusNameOwnerFlags.NONE, on_bus, None,
                     lambda *_: loop.quit())       # the name taken by someone else: nothing to stand in for
    loop.run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
