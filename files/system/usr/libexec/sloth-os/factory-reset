#!/usr/bin/python3 -I
"""Resetting the computer (the equivalent of Windows' "Reset this PC"); runs as root.

In two steps, because the system settings and the accounts can only be reset safely while
nobody is using them yet:

  prepare keep|all   from Sloth Center (sloth-helper factory-reset): downloads the latest version, removes the
                     system packages and kernel parameters added by hand (these apply to the new, prepared
                     version), then records the task. Input is JSON: {"backup_name": …},
                     in "Remove everything" (all) mode also the new account ({"username", "fullname", "password_hash"}).
                     Prints JSON line by line: {"stage": …}, and at the end {"ok": …, "error": …}.
  cancel             withdraws the recorded reset (the prepared version is deleted too)
  boot-request       at startup, before boot (sloth-boot-reset.service): if "Reset this PC" was chosen in the
                     boot menu, records it (keep mode; without download and packages, with the version on the
                     machine), and the boot step does it
  boot-title         the boot menu entry's label in the system language (sloth-boot-ok writes it to the EFI partition)
  boot               on the next start, before login (sloth-factory-reset.service), under the Plymouth animation:
                     apps removed, /etc back to the factory state; in "keep" mode the desktop settings go to the
                     "Old settings" folder, in "all" mode every account and file is deleted, and the new account is
                     created (sloth-first-user). At the end it restarts the computer, so everything starts with clean settings.

The old system version stays in the boot menu: if the new one does not start, you can go back to it.
"""
import json
import logging
import os
import pwd
import re
import shutil
import subprocess
import sys
import time
import tomllib
from pathlib import Path

sys.path.insert(0, "/usr/lib/sloth-os/common")

log = logging.getLogger("factory-reset")

STATE = Path("/var/lib/sloth-os/factory-reset.json")             # readable by everyone (Sloth Center reads it)
ACCOUNT = Path("/var/lib/sloth-os/factory-reset-account.json")   # root only (password hash)
FIRST_USER = Path("/etc/sloth-os/first-user.json")
HOME_ROOT = Path("/var/home")
HOME_SNAPSHOTS = "/usr/libexec/sloth-os/home-snapshots"
BOOT_ENV = "/usr/libexec/sloth-os/boot-env"
KARGS_D = Path("/usr/lib/bootc/kargs.d")
CENTER_TRANSLATIONS = Path("/usr/lib/sloth-os/sloth-center/sloth_center/translations")

NAME_RE = re.compile(r"^[a-z_][a-z0-9_-]{0,31}$")
BACKUP_RE = re.compile(r"^[^/\x00\n]{1,64}$")

# /etc: these stay in both modes (the installer wrote them, the machine's own IDs, or maintained by the system)
ETC_KEEP = (
    "passwd", "passwd-", "shadow", "shadow-", "group", "group-", "gshadow", "gshadow-",
    "subuid", "subuid-", "subgid", "subgid-",
    "machine-id", "machine-info", "hostname", "locale.conf", "vconsole.conf", "localtime", "adjtime",
    "fstab", "crypttab", "X11/xorg.conf.d/00-keyboard.conf", "xdg/kxkbrc",
    "kernel", "ostree", "selinux", "lvm", "ld.so.cache", "udev/hwdb.bin", ".updated", ".pwd.lock",
    "resolv.conf", "sloth-os/first-user.json",
)
ETC_KEEP_PREFIX = ("ssh/ssh_host_",)
# in "keep" mode these stay too: Wi-Fi, the file backup settings
ETC_KEEP_FILES_MODE = ("NetworkManager/system-connections", "sloth-os/snapshots.json")
# On a domain-joined machine the login settings too (in "keep" mode; otherwise the domain accounts
# could not sign in)
ETC_KEEP_DOMAIN = ("sssd", "krb5.conf", "krb5.conf.d", "krb5.keytab", "realmd.conf", "authselect", "pam.d",
                   "nsswitch.conf")

# Kernel parameters: these came from the installer or the system, they stay (the rest were added in Sloth Center)
# (the NVIDIA image's parameters are not in kargs.d, so the drivers' parameters also stay, by name)
KARGS_KEEP_PREFIX = ("root=", "rootflags=", "ostree=", "rw", "ro", "BOOT_IMAGE=", "rd.luks", "luks.", "resume=",
                     "rd.vconsole.", "vconsole.", "rd.lvm", "rd.md", "rd.dm", "rd.auto", "rd.driver.blacklist=",
                     "modprobe.blacklist=", "nvidia", "initcall_blacklist=")


def emit(**kw):
    print(json.dumps(kw), flush=True)


def run(cmd, check=True, **kw):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, **kw)
    except OSError as e:
        # at startup it must not stop halfway because of a missing helper program (with check=False)
        r = subprocess.CompletedProcess(cmd, 127, "", str(e))
    if check and r.returncode != 0:
        raise RuntimeError(f"{cmd[0]}: {(r.stderr or r.stdout).strip()[-400:]}")
    return r


# --- Preparation (prepare) ------------------------------------------------------------------------------------

def rpm_ostree(*args, ok_codes=(0,)):
    """An rpm-ostree command; if another operation is running (e.g. the automatic update), we wait for it."""
    for _ in range(90):
        r = run(["rpm-ostree", *args], check=False)
        if r.returncode in ok_codes:
            return r
        err = (r.stderr or r.stdout).strip()
        if "in progress" not in err.lower():
            raise RuntimeError(f"rpm-ostree {args[0]}: {err[-400:]}")
        time.sleep(10)
    raise RuntimeError(f"rpm-ostree {args[0]}: another operation did not finish")


def default_kargs(kargs_d=KARGS_D):
    """The image's own kernel parameters (/usr/lib/bootc/kargs.d/*.toml)."""
    out = set()
    for f in sorted(kargs_d.glob("*.toml")) if kargs_d.is_dir() else []:
        try:
            out.update(tomllib.loads(f.read_text()).get("kargs", []))
        except (OSError, ValueError) as e:
            log.warning("%s: %s", f, e)
    return out


def kargs_to_delete(current, defaults):
    keys = {a.split("=", 1)[0] for a in defaults}
    return [a for a in current
            if a not in defaults and a.split("=", 1)[0] not in keys and not a.startswith(KARGS_KEEP_PREFIX)]


def check_account(acc):
    user, full, pwhash = acc.get("username", ""), acc.get("fullname", ""), acc.get("password_hash", "")
    return (isinstance(user, str) and isinstance(full, str) and isinstance(pwhash, str) and NAME_RE.match(user)
            and pwhash.startswith("$6$") and "\n" not in full and ":" not in full and len(full) <= 128
            and ":" not in pwhash and "\n" not in pwhash)


def write_private(path, data, mode):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(data, f)
    os.chmod(tmp, mode)
    tmp.replace(path)


def prepare(mode, request):
    backup = request.get("backup_name") or "Old settings"
    if not isinstance(backup, str) or not BACKUP_RE.match(backup) or backup.startswith("."):
        return {"ok": False, "error": "bad-request"}
    account = request.get("account") or {}
    if mode == "all" and not check_account(account):
        return {"ok": False, "error": "bad-account"}
    try:
        emit(stage="download")
        rpm_ostree("upgrade", ok_codes=(0, 77))
        emit(stage="packages")
        r = rpm_ostree("reset", ok_codes=(0, 1))
        if r.returncode == 1 and "no change" not in (r.stderr + r.stdout).lower():
            raise RuntimeError(f"rpm-ostree reset: {r.stderr.strip()[-400:]}")
        emit(stage="kargs")
        current = rpm_ostree("kargs").stdout.split()
        remove = kargs_to_delete(current, default_kargs())
        if remove:
            log.info("kernel parameters removed: %s", remove)
            rpm_ostree("kargs", *[f"--delete={a}" for a in remove])
    except RuntimeError as e:
        log.error("%s", e)
        return {"ok": False, "error": str(e)}
    if mode == "all":
        write_private(ACCOUNT, {k: account[k] for k in ("username", "fullname", "password_hash")}, 0o600)
    else:
        ACCOUNT.unlink(missing_ok=True)
    write_private(STATE, {"mode": mode, "backup_name": backup, "requested": int(time.time())}, 0o644)
    return {"ok": True}


def cancel():
    STATE.unlink(missing_ok=True)
    ACCOUNT.unlink(missing_ok=True)
    # the prepared version (downloaded, without packages and parameters) goes too: everything stays in the old one
    run(["rpm-ostree", "cleanup", "--pending"], check=False)
    return {"ok": True}


# --- Resetting /etc (boot) ---------------------------------------------------------------------------------

def kept(rel, keep):
    return rel in keep or any(rel.startswith(k + "/") for k in keep) or rel.startswith(ETC_KEEP_PREFIX)


def same(a, b):
    """Whether the two entries are the same (type, link target, contents, permissions, owner)."""
    try:
        sa, sb = os.lstat(a), os.lstat(b)
    except OSError:
        return False
    if (sa.st_mode, sa.st_uid, sa.st_gid) != (sb.st_mode, sb.st_uid, sb.st_gid):
        return False
    if os.path.islink(a):
        return os.readlink(a) == os.readlink(b)
    if os.path.isdir(a):
        return True
    if sa.st_size != sb.st_size:
        return False
    with open(a, "rb") as fa, open(b, "rb") as fb:
        while True:
            ca, cb = fa.read(65536), fb.read(65536)
            if ca != cb:
                return False
            if not ca:
                return True


def remove(path):
    if os.path.isdir(path) and not os.path.islink(path):
        shutil.rmtree(path)
    elif os.path.lexists(path):
        os.unlink(path)


def copy_entry(src, dst):
    """Copies a file / link / empty folder with all its attributes (SELinux label included)."""
    remove(dst)
    if os.path.isdir(src) and not os.path.islink(src):
        os.mkdir(dst)
        run(["cp", "-a", "--attributes-only", "--no-dereference", src + "/.", dst], check=False)
        st = os.lstat(src)
        os.chown(dst, st.st_uid, st.st_gid)
        os.chmod(dst, st.st_mode & 0o7777)
    else:
        run(["cp", "-a", "--no-dereference", src, dst])


def reset_etc(etc, defaults, keep):
    """Resets /etc to the factory state (defaults: the current version's /usr/etc). Whatever is different or
    missing in the factory one comes back; whatever only exists here is deleted; the ones in keep stay untouched."""
    etc, defaults = str(etc), str(defaults)
    restored = removed = 0
    for root, dirs, files in os.walk(defaults):
        for name in sorted(dirs + files):
            src = os.path.join(root, name)
            rel = os.path.relpath(src, defaults)
            dst = os.path.join(etc, rel)
            if kept(rel, keep):
                if name in dirs:
                    dirs.remove(name)
                continue
            is_dir = os.path.isdir(src) and not os.path.islink(src)
            if is_dir:
                if not (os.path.isdir(dst) and not os.path.islink(dst)):
                    copy_entry(src, dst)
                    restored += 1
                elif not same(src, dst):
                    st = os.lstat(src)
                    os.chown(dst, st.st_uid, st.st_gid)
                    os.chmod(dst, st.st_mode & 0o7777)
            elif not same(src, dst):
                copy_entry(src, dst)
                restored += 1
        # we do not enter linked folders (os.walk would not either, but they are in the dirs list)
        dirs[:] = [d for d in dirs if not os.path.islink(os.path.join(root, d))]
    for root, dirs, files in os.walk(etc):
        for name in sorted(dirs + files):
            path = os.path.join(root, name)
            rel = os.path.relpath(path, etc)
            if kept(rel, keep):
                if name in dirs:
                    dirs.remove(name)
                continue
            if not os.path.lexists(os.path.join(defaults, rel)):
                if name in dirs and any(k.startswith(rel + "/") for k in keep):
                    continue  # it contains something that stays (e.g. sloth-os/snapshots.json): only the rest is deleted
                remove(path)
                removed += 1
                if name in dirs:
                    dirs.remove(name)
        dirs[:] = [d for d in dirs if not os.path.islink(os.path.join(root, d))]
    return restored, removed


def etc_keep(mode, etc="/etc"):
    keep = set(ETC_KEEP)
    if mode == "keep":
        keep.update(ETC_KEEP_FILES_MODE)
        if os.path.exists(os.path.join(etc, "sssd/sssd.conf")):
            keep.update(ETC_KEEP_DOMAIN)
    return keep


# --- Accounts and home folders (boot) -----------------------------------------------------------------------------

def local_users(passwd="/etc/passwd"):
    """The local (non-system) accounts: name, uid."""
    out = []
    for line in Path(passwd).read_text().splitlines():
        parts = line.split(":")
        if len(parts) >= 7 and parts[2].isdigit() and 1000 <= int(parts[2]) < 60000:
            out.append((parts[0], int(parts[2])))
    return out


def homes(root=HOME_ROOT):
    """The home folders (without hidden folders, e.g. .snapshots)."""
    try:
        return sorted(p for p in root.iterdir() if p.is_dir() and not p.is_symlink() and not p.name.startswith("."))
    except OSError:
        return []


def is_subvolume(path):
    try:
        return os.lstat(path).st_ino == 256 and os.path.isdir(path)
    except OSError:
        return False


def delete_tree(path):
    if is_subvolume(path):
        r = run(["btrfs", "subvolume", "delete", "--recursive", str(path)], check=False)
        if r.returncode == 0:
            return
    run(["rm", "-rf", "--", str(path)], check=False)


def free_name(parent, name):
    path, n = parent / name, 2
    while os.path.lexists(path):
        path, n = parent / f"{name} {n}", n + 1
    return path


def move_desktop_settings(home, backup_name):
    """The desktop and app settings (~/.config) go to the "Old settings" folder; Plasma starts with its defaults,
    and Sloth Welcome appears again too (the welcome-done marker is also in ~/.config)."""
    config = home / ".config"
    if not config.is_dir() or config.is_symlink():
        return None
    st = os.lstat(home)
    backup = free_name(home, backup_name)
    backup.mkdir(mode=0o700)
    os.chown(backup, st.st_uid, st.st_gid)
    os.rename(config, backup / "config")
    return backup


def uninstall_user_flatpaks(home):
    if not (home / ".local/share/flatpak").is_dir():
        return
    st = os.lstat(home)
    r = run(["setpriv", f"--reuid={st.st_uid}", f"--regid={st.st_gid}", "--clear-groups", "--",
             "env", f"HOME={home}", "flatpak", "uninstall", "--user", "--all", "--noninteractive"], check=False)
    log.info("user apps (%s): %s", home.name, (r.stdout or r.stderr).strip()[-300:])


def delete_accounts():
    run([HOME_SNAPSHOTS, "delete-all"], check=False)
    for name, _uid in local_users():
        r = run(["userdel", "--force", name], check=False)
        log.info("account deleted: %s (%s)", name, r.returncode)
        for p in (f"/var/spool/mail/{name}", f"/var/lib/AccountsService/users/{name}",
                  f"/var/lib/AccountsService/icons/{name}"):
            remove(p)
    for p in sorted(HOME_ROOT.iterdir()) if HOME_ROOT.is_dir() else []:
        delete_tree(p)


# --- Message under the Plymouth animation ---------------------------------------------------------------------------

def boot_text(text):
    """From Sloth Center's translations, in the system language (the key is the English text)."""
    try:
        lang = re.search(r'^LANG="?([A-Za-z_]+)', Path("/etc/locale.conf").read_text(), re.M).group(1)
    except (OSError, AttributeError):
        return text
    for code in (lang, lang.split("_")[0]):
        try:
            return json.loads((CENTER_TRANSLATIONS / f"{code}.json").read_text(encoding="utf-8")).get(text) or text
        except (OSError, ValueError):
            continue
    return text


def plymouth(text):
    run(["plymouth", "display-message", "--text=" + text], check=False)


def step(fn, *args):
    """One step among many: if it throws, the others still run, and the machine starts."""
    try:
        return fn(*args)
    except Exception:  # noqa: BLE001
        log.exception("%s failed", fn.__name__)
        return None


def boot():
    try:
        state = json.loads(STATE.read_text())
    except (OSError, ValueError):
        return 0
    mode, backup = state.get("mode"), state.get("backup_name", "Old settings")
    if mode not in ("keep", "all") or not BACKUP_RE.match(backup):
        STATE.unlink(missing_ok=True)
        return 1
    # It must not run again (if something goes wrong, the machine should still start)
    STATE.unlink()
    plymouth(boot_text("Resetting this PC… This may take a few minutes, don't turn off the computer."))
    log.info("resetting: %s", mode)
    try:
        account = json.loads(ACCOUNT.read_text()) if mode == "all" else None
    except (OSError, ValueError):
        account = None
    if mode == "all" and not (account and check_account(account)):
        log.error("the new account's data is missing, the accounts stay")
        mode = "keep"

    if mode == "all":
        # the new account's data first: if something goes wrong, signing in must still be possible (resetting /etc keeps it)
        step(write_private, FIRST_USER, {"username": account["username"], "fullname": account["fullname"],
                                         "password_hash": account["password_hash"]}, 0o600)
    if mode == "keep":
        # Better safe than sorry: a fresh saved state of the files before touching anything (if File backup works on
        # the machine; in this mode the saved states stay, and can be brought back from "Previous versions")
        r = step(run, [HOME_SNAPSHOTS, "take", "--now"], False)
        log.info("saved state before: %s", r.stdout.strip() if r else "")
        for home in homes():
            step(uninstall_user_flatpaks, home)
            log.info("%s: settings -> %s", home.name, step(move_desktop_settings, home, backup))
    run(["flatpak", "uninstall", "--system", "--all", "--noninteractive"], check=False)
    run(["flatpak", "uninstall", "--system", "--unused", "--noninteractive"], check=False)
    if mode == "all":
        step(delete_accounts)

    log.info("/etc: reset, deleted: %s", step(reset_etc, "/etc", "/usr/etc", etc_keep(mode)))
    step(remove, "/var/lib/sloth-os/pin")
    ACCOUNT.unlink(missing_ok=True)
    run(["restorecon", "-R", "/etc"], check=False)
    # As on first boot: the services enabled by the factory defaults
    run(["systemctl", "preset-all", "--preset-mode=enable-only"], check=False)
    run(["sync"], check=False)
    plymouth(boot_text("Done. Restarting…"))
    run(["systemctl", "--no-block", "reboot"], check=False)
    return 0


def boot_request():
    """Records the reset requested from the boot menu (sloth_reset=keep on the EFI partition) for the boot step."""
    r = run([BOOT_ENV, "take-reset"], check=False)
    if (r.stdout or "").strip() != "keep" or STATE.exists():
        return 0
    log.info("resetting from the boot menu (keep)")
    ACCOUNT.unlink(missing_ok=True)
    write_private(STATE, {"mode": "keep", "backup_name": boot_text("Old settings"),
                          "requested": int(time.time()), "source": "boot-menu"}, 0o644)
    return 0


def boot_title():
    """"Reset this PC (Keep my files)" in the system language. GRUB's font does not know every script:
    if the label is not in Latin letters, in English."""
    title = f"{boot_text('Reset this PC')} ({boot_text('Keep my files')})"
    if any(ord(ch) > 0x24F for ch in title):
        title = "Reset this PC (Keep my files)"
    return title


def main(argv):
    logging.basicConfig(level=logging.INFO, format="%(name)s: %(message)s", stream=sys.stderr)
    if os.geteuid() != 0:
        emit(ok=False, error="root needed")
        return 1
    if len(argv) == 2 and argv[0] == "prepare" and argv[1] in ("keep", "all"):
        try:
            request = json.loads(sys.stdin.read(8192) or "{}")
        except ValueError:
            request = None
        emit(**(prepare(argv[1], request) if isinstance(request, dict) else {"ok": False, "error": "bad-request"}))
        return 0
    if argv == ["cancel"]:
        emit(**cancel())
        return 0
    if argv == ["boot"]:
        return boot()
    if argv == ["boot-request"]:
        return boot_request()
    if argv == ["boot-title"]:
        print(boot_title())
        return 0
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
