#!/usr/bin/env python3
"""Turns Proton on in Steam for every game ("Steam Play for all other titles").

It runs at login (sloth-steam-proton-default.service, a user service).
It writes the CompatToolMapping "0" entry into Steam's config.vdf, which is the
"Enable Steam Play for all other titles" switch in Steam's settings.

- It sets it only once: afterwards a marker file keeps it from touching it, so if the
  user turns it off, it stays that way.
- If Steam is running, it does nothing (Steam would overwrite config.vdf on exit);
  it tries again at the next login.
- If the user has already set something, it does not overwrite it.
"""
import os
import subprocess
import sys
from pathlib import Path

STEAM_APP = "com.valvesoftware.Steam"
# The name "proton_experimental" does not change with Proton versions, so it does not go out of date.
DEFAULT_TOOL = "proton_experimental"

HOME = Path.home()
CONFIG = HOME / ".var/app" / STEAM_APP / ".local/share/Steam/config/config.vdf"
STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "sloth-os"
MARKER = STATE_DIR / "steam-proton-default.done"


# --- A minimal VDF (Valve KeyValues) reader/writer that keeps the order ---------------

def tokenize(text):
    i, n = 0, len(text)
    while i < n:
        c = text[i]
        if c.isspace():
            i += 1
        elif text.startswith("//", i):
            while i < n and text[i] != "\n":
                i += 1
        elif c in "{}":
            yield c
            i += 1
        elif c == '"':
            i += 1
            buf = []
            while i < n and text[i] != '"':
                if text[i] == "\\" and i + 1 < n:
                    buf.append(text[i:i + 2])
                    i += 2
                else:
                    buf.append(text[i])
                    i += 1
            i += 1
            yield ("str", "".join(buf))
        else:
            start = i
            while i < n and not text[i].isspace() and text[i] not in '{}"':
                i += 1
            yield ("str", text[start:i])


def parse(text):
    """Returns a list: [(key, value)], where the value is a str or such a list."""
    tokens = list(tokenize(text))
    pos = 0

    def block():
        nonlocal pos
        items = []
        while pos < len(tokens):
            tok = tokens[pos]
            if tok == "}":
                pos += 1
                return items
            if tok == "{":
                raise ValueError("unexpected '{'")
            key = tok[1]
            pos += 1
            nxt = tokens[pos]
            if nxt == "{":
                pos += 1
                items.append((key, block()))
            else:
                items.append((key, nxt[1]))
                pos += 1
        return items

    return block()


def dump(items, depth=0):
    out = []
    tab = "\t" * depth
    for key, value in items:
        if isinstance(value, list):
            out.append(f'{tab}"{key}"\n{tab}{{\n{dump(value, depth + 1)}{tab}}}\n')
        else:
            out.append(f'{tab}"{key}"\t\t"{value}"\n')
    return "".join(out)


def child(items, key, create=False):
    """Case-insensitive lookup (Steam reads it like that too)."""
    for k, v in items:
        if k.lower() == key.lower() and isinstance(v, list):
            return v
    if create:
        new = []
        items.append((key, new))
        return new
    return None


# --------------------------------------------------------------------------

def steam_running():
    try:
        out = subprocess.run(["flatpak", "ps", "--columns=application"],
                             capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return False
    return STEAM_APP in out.split()


def steam_installed():
    return subprocess.run(["flatpak", "info", STEAM_APP],
                          capture_output=True).returncode == 0


def main():
    if MARKER.exists():
        return 0
    if not steam_installed():
        print("Steam is not installed, nothing to do.")
        return 0
    if steam_running():
        print("Steam is running, trying again at the next login.")
        return 0

    items = parse(CONFIG.read_text(encoding="utf-8", errors="replace")) if CONFIG.exists() else []
    steam = child(child(child(child(items, "InstallConfigStore", True),
                              "Software", True), "Valve", True), "Steam", True)
    mapping = child(steam, "CompatToolMapping", True)

    if child(mapping, "0") is None:
        mapping.append(("0", [("name", DEFAULT_TOOL), ("config", ""), ("priority", "75")]))
        CONFIG.parent.mkdir(parents=True, exist_ok=True)
        if CONFIG.exists():
            CONFIG.with_suffix(".vdf.sloth-backup").write_bytes(CONFIG.read_bytes())
        tmp = CONFIG.with_suffix(".vdf.tmp")
        tmp.write_text(dump(items), encoding="utf-8")
        tmp.replace(CONFIG)
        print(f"Steam Play turned on for every game ({DEFAULT_TOOL}).")
    else:
        print("Steam Play is already set, not touching it.")

    STATE_DIR.mkdir(parents=True, exist_ok=True)
    MARKER.touch()
    return 0


if __name__ == "__main__":
    sys.exit(main())
