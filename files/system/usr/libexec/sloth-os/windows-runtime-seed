#!/usr/bin/bash
# Copies the bundled Proton and Steam Linux Runtime into the user's folder (files/scripts/windows-runtime.sh),
# where umu-launcher looks for them. Without downloading, a few seconds; afterwards the first .exe starts
# without internet too. It only copies what is still missing (it does not overwrite a newer version already downloaded).
# The .exe handler (sloth_exe/runner.py) and sloth-windows-prepare call it before umu.
set -euo pipefail

SRC=/usr/share/sloth-os/windows-runtime
DATA="${XDG_DATA_HOME:-$HOME/.local/share}"
COMPAT="$DATA/Steam/compatibilitytools.d"
RUNTIME="$DATA/umu/steamrt3"

[[ -d "$SRC" ]] || exit 0

# Proton: if there is no UMU-Proton at all yet (umu picks the latest of them)
if ! compgen -G "$COMPAT/UMU-Proton-*/proton" >/dev/null; then
    for proton in "$SRC"/UMU-Proton-*; do
        mkdir -p "$COMPAT"
        tmp="$(mktemp -d "$COMPAT/.sloth-seed.XXXXXX")"
        cp -a --reflink=auto "$proton" "$tmp/"
        mv "$tmp/$(basename "$proton")" "$COMPAT/"
        rmdir "$tmp"
        echo "Proton copied in: $(basename "$proton")"
    done
fi

# Runtime: if there is no finished copy (umu looks at the .installed.ok marker file; older umu installed without a
# marker file, which is fine too if the platform folder exists). An unfinished, empty folder is replaced
if [[ ! -f "$RUNTIME/.installed.ok" ]] && ! compgen -G "$RUNTIME/sniper_platform_*" >/dev/null; then
    mkdir -p "$DATA/umu"
    tmp="$(mktemp -d "$DATA/umu/.sloth-seed.XXXXXX")"
    cp -a --reflink=auto "$SRC/steamrt3" "$tmp/"
    ln -sfn _v2-entry-point "$tmp/steamrt3/umu"
    echo ok > "$tmp/steamrt3/.installed.ok"
    rm -rf "$RUNTIME"
    mv "$tmp/steamrt3" "$RUNTIME"
    rmdir "$tmp"
    echo "Runtime copied in: $(grep -m1 -o 'sniper_platform_[0-9.]*' "$RUNTIME/VERSIONS.txt" || echo steamrt3)"
fi
