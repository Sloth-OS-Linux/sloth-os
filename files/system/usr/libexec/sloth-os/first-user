#!/usr/bin/python3 -I
"""Creates the first user account on first boot (instead of KDE Plasma Setup).

The Sloth OS installer writes the account's data into the installed system (/etc/sloth-os/first-user.json,
readable by root only; the password only as an SHA-512 hash). This service creates the account as an
administrator (wheel group) before the login screen, then deletes the file.
Other disks the installer erased for programs and games ("disks": their mount points under /var/mnt) are given
to this user, so the .exe handler and Steam can put things there without a password.
"""
import json
import os
import re
import subprocess
import sys
import time

SPEC = "/etc/sloth-os/first-user.json"
NAME_RE = re.compile(r"^[a-z_][a-z0-9_-]{0,31}$")
MOUNT_RE = re.compile(r"^/var/mnt/[a-z0-9-]{1,40}$")


def give_disks(user, mounts):
    """The empty, freshly made disks belong to the user (they are mounted with nofail, maybe a little later)."""
    for mount in mounts:
        if not isinstance(mount, str) or not MOUNT_RE.match(mount):
            continue
        for _ in range(30):
            if os.path.ismount(mount):
                break
            time.sleep(0.5)
        else:
            print(f"not mounted: {mount}", file=sys.stderr)
            continue
        subprocess.run(["chown", f"{user}:{user}", mount], capture_output=True)
        subprocess.run(["restorecon", mount], capture_output=True)


def main():
    try:
        with open(SPEC, encoding="utf-8") as f:
            spec = json.load(f)
    except (OSError, ValueError) as e:
        print(f"not readable: {e}", file=sys.stderr)
        return 1
    user, full, pwhash = spec.get("username", ""), spec.get("fullname", ""), spec.get("password_hash", "")
    if not NAME_RE.match(user) or not pwhash.startswith("$6$") or "\n" in full or ":" in full:
        print("bad account data", file=sys.stderr)
        return 1
    if subprocess.run(["getent", "passwd", user], capture_output=True).returncode != 0:
        r = subprocess.run(["useradd", "--create-home", "--groups", "wheel", "--comment", full,
                            "--password", pwhash, user], capture_output=True, text=True)
        if r.returncode != 0:
            print(f"useradd: {r.stderr.strip()}", file=sys.stderr)
            return 1
    give_disks(user, spec.get("disks") or [])
    os.unlink(SPEC)
    return 0


if __name__ == "__main__":
    sys.exit(main())
