#!/usr/bin/python3 -I
"""Checks the PIN for signing in (pam_exec expose_authtok; the with-sloth-pin feature of the authselect "sloth" profile).

The typed password comes on standard input. If it is not all digits, it is not a PIN: we pass it on right away to the
password check (pam_unix), and it does not count as a failure either. The PIN is only accepted locally, in allowed
services (the login and lock screens, administrator approval); never for a remote login.

The check itself is done by the PIN's keeper (/usr/libexec/sloth-os/pin-verifier, root, behind sloth-pin.socket):
the PIN unlocks a secret sealed in the TPM (or, without a TPM, a root-only hash), and it counts the wrong tries.
This side runs in the user's name too (the lock screen), so it cannot see any of that; it only asks.
Exit code: 0 = right PIN, anything else = no (pam_unix comes next).
"""
import json
import os
import re
import socket
import sys

SOCKET = os.environ.get("SLOTH_PIN_SOCKET", "/run/sloth-os/pin.sock")
# Local services where the PIN is accepted (for the others, e.g. ssh, only the password)
SERVICES = {"login", "sddm", "plasmalogin", "plasma-login", "kde", "kscreensaver", "kscreenlocker",
            "polkit-1", "sudo", "sudo-i", "su", "su-l"}


def main():
    user = os.environ.get("PAM_USER", "")
    service = os.environ.get("PAM_SERVICE", "")
    rhost = os.environ.get("PAM_RHOST", "")
    if not re.fullmatch(r"[a-z_][a-z0-9_.-]{0,31}", user) or service not in SERVICES:
        return 1
    if rhost and rhost not in ("localhost", "127.0.0.1", "::1"):
        return 1
    token = sys.stdin.buffer.read(64).split(b"\0", 1)[0].strip(b"\r\n")
    if not re.fullmatch(rb"\d{4,8}", token):
        return 1  # this is a password, not a PIN
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as conn:
        conn.settimeout(30)  # a TPM can take a second or two
        conn.connect(SOCKET)
        conn.sendall(json.dumps({"user": user, "pin": token.decode(), "service": service}).encode() + b"\n")
        answer = conn.recv(16)
    return 0 if answer.strip() == b"ok" else 1


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:  # an error must never let anyone in, nor block the password login
        sys.exit(1)
