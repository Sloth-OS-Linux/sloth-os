#!/usr/bin/python3 -I
"""Updates the apps installed as GitHub packages (e.g. ArtCraft) in the background.

Flathub does not update these, so once a day we check whether there is a newer release.
If there is, we download it, check the SHA256 sum, and reinstall it (the settings
and saves stay in the app's own folder). A user service:
sloth-github-bundle-update.timer
"""
import logging
import os
import sys

sys.path.insert(0, "/usr/lib/sloth-os/sloth-welcome")
sys.path.insert(0, "/usr/lib/sloth-os/common")

import gi  # noqa: E402

gi.require_version("Flatpak", "1.0")
from gi.repository import Flatpak, Gio, GLib  # noqa: E402

from sloth_welcome import catalog  # noqa: E402
from sloth_welcome.installer import (bundle_versions, download_latest_bundle,  # noqa: E402
                                     latest_release, save_bundle_version)

logging.basicConfig(level=logging.INFO, format="%(message)s")
log = logging.getLogger("sloth-bundle-update")


def installed(inst, app_id):
    try:
        inst.get_installed_ref(Flatpak.RefKind.APP, app_id, None, None, None)
        return True
    except GLib.Error:
        return False


def main():
    inst = Flatpak.Installation.new_user(None)
    versions = bundle_versions()
    for cat in catalog.CATEGORIES:
        for app in cat["apps"]:
            if app.get("source") != "github-bundle" or not installed(inst, app["id"]):
                continue
            try:
                release = latest_release(app)
            except Exception as e:  # no network: tomorrow then
                log.info("%s: could not query (%s)", app["name"], e)
                continue
            tag = release.get("tag_name", "")
            if tag and tag == versions.get(app["id"]):
                log.info("%s is up to date (%s)", app["name"], tag)
                continue
            path = None
            try:
                path, tag = download_latest_bundle(app, release=release)
                txn = Flatpak.Transaction.new_for_installation(inst, None)
                txn.add_default_dependency_sources()
                txn.set_reinstall(True)
                txn.add_install_bundle(Gio.File.new_for_path(path), None)
                txn.run(None)
                save_bundle_version(app["id"], tag)
                log.info("%s updated: %s", app["name"], tag)
            except Exception as e:
                log.warning("updating %s failed: %s", app["name"], e)
            finally:
                if path:
                    try:
                        os.unlink(path)
                    except OSError:
                        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
