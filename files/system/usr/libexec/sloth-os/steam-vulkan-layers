#!/usr/bin/env bash
# Installs the MangoHud and gamescope Flatpak Vulkan layers for the Steam Flatpak's
# current runtime version (e.g. 26.08). The host RPMs (mangohud, gamescope)
# are not visible inside the Flatpak Steam, so these layers are needed.
# The runtime version is asked from Steam on every run, so after a Steam
# runtime change (e.g. 26.08 -> 27.08) the layers follow by themselves.
set -euo pipefail

STEAM=com.valvesoftware.Steam
LAYERS=(
  org.freedesktop.Platform.VulkanLayer.MangoHud
  org.freedesktop.Platform.VulkanLayer.gamescope
)

if ! flatpak info --system "$STEAM" >/dev/null 2>&1; then
  echo "Steam is not installed, nothing to do."
  exit 0
fi

# pl. "org.freedesktop.Platform/x86_64/26.08" -> "26.08"
branch="$(flatpak info --system --show-runtime "$STEAM" | cut -d/ -f3)"
if [[ -z "$branch" ]]; then
  echo "Could not determine Steam's runtime version." >&2
  exit 1
fi

missing=()
for layer in "${LAYERS[@]}"; do
  if ! flatpak info --system "${layer}//${branch}" >/dev/null 2>&1; then
    missing+=("${layer}//${branch}")
  fi
done

if (( ${#missing[@]} == 0 )); then
  echo "The Vulkan layers are up to date (${branch})."
  exit 0
fi

echo "Installing: ${missing[*]}"
flatpak install --system --noninteractive flathub "${missing[@]}"

# The layers of the old runtime version that are no longer used are removed by Flatpak's
# own cleanup (flatpak uninstall --unused).
flatpak uninstall --system --noninteractive --unused || true
