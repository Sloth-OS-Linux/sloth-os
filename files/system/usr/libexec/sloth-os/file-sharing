#!/usr/bin/python3 -I
"""Sharing a folder on the home network (Dolphin → Properties → Share), without a terminal.

The usershares group lets Dolphin create share definitions, not access files. At startup, before the login screen,
the group is copied into /etc/group and human accounts are added so Dolphin can share without a separate setup step.
Samba can read only home folders and folders that are actually shared (not the whole system), and only the local
network can connect (never the internet, not even over IPv6).

groups: at startup, before the login screen: make the usershares group visible to usermod, then add human accounts.
serve:  whenever the shared folders change (sloth-file-sharing.path): a shared folder on another disk gets Samba's
        SELinux label (samba_share_t), the firewall lets Samba in from the local network and wsdd starts, so the
        computer shows up in Windows' Network window. Samba stays ready for Dolphin's Share tab; when nothing is
        shared, the firewall closes and wsdd stops. smb.conf exports no other folders. Each account's shares and
        whether it has a Samba password go into STATUS/<uid>.json (readable by that account only), for Sloth Center.
"""
import json
import grp
import os
import re
import subprocess
import sys

GROUP = "usershares"
SHARES = "/var/lib/samba/usershares"
STATUS = "/run/sloth-os/sharing"


def ensure_group():
    with open("/etc/group", encoding="utf-8") as f:
        if any(line.startswith(GROUP + ":") for line in f):
            return
    try:
        with open("/usr/lib/group", encoding="utf-8") as f:
            line = next((l for l in f if l.startswith(GROUP + ":")), None)
    except OSError:
        line = None
    if line is None:
        subprocess.run(["groupadd", "--system", GROUP], check=False)
        return
    gid = line.split(":")[2]
    with open("/etc/group", "a", encoding="utf-8") as f:
        f.write(f"{GROUP}:x:{gid}:\n")
    try:
        with open("/etc/gshadow", encoding="utf-8") as f:
            present = any(l.startswith(GROUP + ":") for l in f)
        if not present:
            with open("/etc/gshadow", "a", encoding="utf-8") as f:
                f.write(f"{GROUP}:!::\n")
    except OSError:
        pass


# the local network's addresses: home and office ranges, IPv6 link-local and unique local (no global addresses)
LOCAL = [("ipv4", "10.0.0.0/8"), ("ipv4", "172.16.0.0/12"), ("ipv4", "192.168.0.0/16"),
         ("ipv6", "fe80::/10"), ("ipv6", "fc00::/7")]


def read_shares():
    """The shares (one file per share in SHARES, "key=value" lines), with the uid of the account that shared it
    (the owner of the share's file)."""
    shares = []
    try:
        names = sorted(os.listdir(SHARES))
    except OSError:
        return shares
    for name in names:
        file = os.path.join(SHARES, name)
        try:
            uid = os.stat(file).st_uid
            with open(file, encoding="utf-8", errors="replace") as f:
                fields = dict(line.rstrip("\n").split("=", 1) for line in f if "=" in line)
        except OSError:
            continue
        if fields.get("path"):
            groups = []
            groups_by_gid = {group.gr_gid: group for group in grp.getgrall()}
            for ace in fields.get("usershare_acl", "").rstrip(",").split(","):
                principal, separator, permission = ace.partition(":")
                if not separator:
                    continue
                group = None
                if principal.startswith("S-1-22-2-"):
                    try:
                        group = groups_by_gid.get(int(principal.removeprefix("S-1-22-2-")))
                    except ValueError:
                        continue
                elif principal.startswith("S-1-5-21-"):
                    try:
                        result = subprocess.run(["wbinfo", "--sid-to-gid", principal],
                                                capture_output=True, text=True, timeout=15)
                        group = groups_by_gid.get(int(result.stdout.strip())) if result.returncode == 0 else None
                    except (OSError, ValueError, subprocess.SubprocessError):
                        continue
                if group is not None:
                    groups.append({"name": group.gr_name, "write": permission.upper() == "F"})
            shares.append({"name": fields.get("sharename", name), "path": fields["path"], "uid": uid,
                           "write": fields.get("usershare_acl", "").rstrip(",").endswith(":F"),
                           "guests": fields.get("guest_ok") == "y", "groups": groups})
    return shares


def write_status(shares):
    """For Sloth Center: each account's shares and whether it has a Samba password."""
    with_password = set()
    r = subprocess.run(["pdbedit", "-L"], capture_output=True, text=True)
    for line in r.stdout.splitlines():
        parts = line.split(":")
        if len(parts) > 1 and parts[1].isdigit():
            with_password.add(int(parts[1]))
    os.makedirs(STATUS, mode=0o755, exist_ok=True)
    uids = with_password | {s["uid"] for s in shares}
    for old in os.listdir(STATUS):
        if old.removesuffix(".json").isdigit() and int(old.removesuffix(".json")) not in uids:
            os.unlink(os.path.join(STATUS, old))
    for uid in uids:
        mine = [{k: s[k] for k in ("name", "path", "write", "guests", "groups")} for s in shares if s["uid"] == uid]
        path = os.path.join(STATUS, f"{uid}.json")
        tmp = path + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump({"shares": mine, "password": uid in with_password}, f)
        os.chown(tmp, uid, -1)
        os.chmod(tmp, 0o600)
        os.replace(tmp, path)


def label(path, uid):
    """Samba may read this folder and what is in it, nothing else; it stays so after a relabel too.
    Only a person's own folder: the group's members can write a share's file by hand too, and a path like /etc
    must never get the label."""
    path = os.path.realpath(path)
    if path.startswith(("/var/home/", "/home/")):
        return  # home folders: samba_enable_home_dirs
    try:
        st = os.stat(path)
    except OSError:
        return
    if uid < 1000 or st.st_uid != uid or not os.path.isdir(path) or path.count("/") < 3:
        return
    rule = re.escape(path) + "(/.*)?"
    if subprocess.run(["semanage", "fcontext", "--add", "--type", "samba_share_t", rule],
                      capture_output=True).returncode != 0:
        subprocess.run(["semanage", "fcontext", "--modify", "--type", "samba_share_t", rule], capture_output=True)
    subprocess.run(["restorecon", "-R", path], capture_output=True)


def firewall(action):
    # runtime only: the next startup asks again, and only if something is still shared
    for family, net in LOCAL:
        for service in ("samba", "wsdd", "wsdd-http"):
            subprocess.run(["firewall-cmd", f"--{action}-rich-rule=rule family={family} source address={net} "
                            f"service name={service} accept"], capture_output=True)


def serve():
    shares = read_shares()
    write_status(shares)
    if not shares:
        subprocess.run(["systemctl", "stop", "wsdd.service"], check=False)
        firewall("remove")
        return
    for share in shares:
        label(share["path"], share["uid"])
    subprocess.run(["setsebool", "samba_enable_home_dirs=1"], capture_output=True)
    firewall("add")
    subprocess.run(["systemctl", "start", "smb.service", "wsdd.service"], check=False)


if __name__ == "__main__":
    mode = sys.argv[1] if len(sys.argv) > 1 else ""
    if mode == "groups":
        ensure_group()
    elif mode == "serve":
        serve()
    else:
        sys.exit("usage: file-sharing groups|serve")
