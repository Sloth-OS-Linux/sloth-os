#!/usr/bin/bash
# Prepares the Windows programs' runner (Proton + runtime), so the first .exe
# starts at once and later works without internet too. It also keeps it fresh: umu-launcher
# checks on every run whether there is a newer Proton.
# A user timer starts it (sloth-windows-prepare.timer): a few minutes after login,
# then every 6 hours. It opens no window, the output only goes to the log
# (journalctl --user -u sloth-windows-prepare).
set -euo pipefail

# Copying in the bundled Proton and runtime (without internet too); then umu only looks for the update
/usr/libexec/sloth-os/windows-runtime-seed || true

# Without internet there is nothing to do; we try again next time
if [[ "$(nmcli --terse --fields CONNECTIVITY general 2>/dev/null || echo full)" != "full" ]]; then
    echo "No internet, trying again later."
    exit 0
fi

# An empty start in a temporary folder deleted right away: this downloads Proton and the
# runtime. Without a display, so no window appears at all.
# (also the leftover of an interrupted earlier run: the .exe handler stops it if the user installs meanwhile)
rm -rf "${XDG_CACHE_HOME:-$HOME/.cache}"/sloth-windows-prepare.??????
prefix="$(mktemp -d "${XDG_CACHE_HOME:-$HOME/.cache}/sloth-windows-prepare.XXXXXX")"
trap 'rm -rf "$prefix"' EXIT
env -u DISPLAY -u WAYLAND_DISPLAY \
    WINEPREFIX="$prefix" GAMEID=umu-default STORE=none PROTON_VERB=waitforexitandrun \
    WINEDEBUG=-all WINEDLLOVERRIDES="winemenubuilder.exe=d;mshtml=d" \
    nice -n 19 ionice -c 2 -n 7 umu-run wineboot --init
echo "The Windows programs' runner is ready."

# The umu database for recognizing programs (sloth_exe/identify.py); it replaces the copy that comes with the system
db="${XDG_CACHE_HOME:-$HOME/.cache}/sloth-os/umu-database.csv"
mkdir -p "$(dirname "$db")"
if curl -fsSL --max-time 60 -o "$db.new" \
        https://raw.githubusercontent.com/Open-Wine-Components/umu-database/main/umu-database.csv \
        && head -1 "$db.new" | grep -q '^TITLE,'; then
    mv "$db.new" "$db"
else
    rm -f "$db.new"
fi

# Shared knowledge: what worked on other Sloth OS machines (sloth_exe/community.py); a static file from GitHub
kb="${XDG_CACHE_HOME:-$HOME/.cache}/sloth-os/knowledge.json"
if curl -fsSL --max-time 60 -o "$kb.new" \
        https://raw.githubusercontent.com/Sloth-OS-Linux/sloth-os-knowledge/main/knowledge.json \
        && head -c 1 "$kb.new" | grep -q '{'; then
    mv "$kb.new" "$kb"
else
    rm -f "$kb.new"
fi

# Recipes: proven settings of known programs (sloth_common/apps/recipes.py); it replaces the one with the system
# if newer. The machine checks them again when loading (only allowed fields and values)
recipes="${XDG_CACHE_HOME:-$HOME/.cache}/sloth-os/recipes.json"
if curl -fsSL --max-time 60 -o "$recipes.new" \
        https://raw.githubusercontent.com/Sloth-OS-Linux/sloth-os-knowledge/main/recipes.json \
        && head -c 1 "$recipes.new" | grep -q '{'; then
    mv "$recipes.new" "$recipes"
else
    rm -f "$recipes.new"
fi

# Deleting the old Proton versions (what worked for a program, and one spare, stay), and if the user
# turned sharing on, sending the queued reports
sloth-exe --maintenance || true
