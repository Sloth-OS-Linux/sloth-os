#!/usr/bin/bash
# Előkészíti a Windows-programok futtatóját (Proton + futtatókörnyezet), hogy az első .exe
# azonnal induljon, és később internet nélkül is menjen. Frissen is tartja: az umu-launcher
# minden futáskor megnézi, van-e újabb Proton.
# Felhasználói időzítő indítja (sloth-windows-prepare.timer): bejelentkezés után pár perccel,
# utána 6 óránként. Ablakot nem nyit, a kimenet csak a naplóba megy
# (journalctl --user -u sloth-windows-prepare).
set -euo pipefail

# A gyári Proton és futtatókörnyezet bemásolása (internet nélkül is); utána az umu csak a frissítést keresi
/usr/libexec/sloth-os/windows-runtime-seed || true

# Internet nélkül nincs mit tenni; a következő alkalommal újra próbáljuk
if [[ "$(nmcli --terse --fields CONNECTIVITY general 2>/dev/null || echo full)" != "full" ]]; then
    echo "Nincs internet, később újra próbálom."
    exit 0
fi

# Egy ideiglenes, rögtön törölt mappában egy üres indítás: ez tölti le a Protont és a
# futtatókörnyezetet. Kijelző nélkül, így semmilyen ablak nem jelenik meg.
# (egy megszakított korábbi futás maradéka is: az .exe kezelő leállítja, ha a felhasználó közben telepít)
rm -rf "${XDG_CACHE_HOME:-$HOME/.cache}"/sloth-windows-prepare.??????
prefix="$(mktemp -d "${XDG_CACHE_HOME:-$HOME/.cache}/sloth-windows-prepare.XXXXXX")"
trap 'rm -rf "$prefix"' EXIT
env -u DISPLAY -u WAYLAND_DISPLAY \
    WINEPREFIX="$prefix" GAMEID=umu-default STORE=none PROTON_VERB=waitforexitandrun \
    WINEDEBUG=-all WINEDLLOVERRIDES="winemenubuilder.exe=d;mshtml=d" \
    nice -n 19 ionice -c 2 -n 7 umu-run wineboot --init
echo "A Windows-programok futtatója kész."

# A programok felismeréséhez az umu adatbázisa (sloth_exe/identify.py); a rendszerrel jövő példányt váltja
db="${XDG_CACHE_HOME:-$HOME/.cache}/sloth-os/umu-database.csv"
mkdir -p "$(dirname "$db")"
if curl -fsSL --max-time 60 -o "$db.new" \
        https://raw.githubusercontent.com/Open-Wine-Components/umu-database/main/umu-database.csv \
        && head -1 "$db.new" | grep -q '^TITLE,'; then
    mv "$db.new" "$db"
else
    rm -f "$db.new"
fi

# Közös tudás: ami más Sloth OS-es gépeken bevált (sloth_exe/community.py); statikus fájl a GitHubról
kb="${XDG_CACHE_HOME:-$HOME/.cache}/sloth-os/knowledge.json"
if curl -fsSL --max-time 60 -o "$kb.new" \
        https://raw.githubusercontent.com/Sloth-OS-Linux/sloth-os-knowledge/main/knowledge.json \
        && head -c 1 "$kb.new" | grep -q '{'; then
    mv "$kb.new" "$kb"
else
    rm -f "$kb.new"
fi

# Receptek: ismert programok bevált beállításai (sloth_common/apps/recipes.py); a rendszerrel jövőt váltja,
# ha újabb. A gép betöltéskor újra ellenőrzi őket (csak engedélyezett mezők és értékek)
recipes="${XDG_CACHE_HOME:-$HOME/.cache}/sloth-os/recipes.json"
if curl -fsSL --max-time 60 -o "$recipes.new" \
        https://raw.githubusercontent.com/Sloth-OS-Linux/sloth-os-knowledge/main/recipes.json \
        && head -c 1 "$recipes.new" | grep -q '{'; then
    mv "$recipes.new" "$recipes"
else
    rm -f "$recipes.new"
fi

# A régi Proton-verziók törlése (ami egy programnak bevált, és egy tartalék, marad), és ha a felhasználó
# bekapcsolta a megosztást, a sorban álló jelentések elküldése
sloth-exe --maintenance || true
