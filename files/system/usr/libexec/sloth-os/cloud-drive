#!/usr/bin/python3 -I
"""Cloud storage (OneDrive, Google Drive) as a folder in the home folder, without a terminal (rclone).

Like Windows' OneDrive ("Files On-Demand"): in the ~/OneDrive (or ~/Google Drive) folder every file is visible,
but only what is opened gets downloaded; the opened ones stay in the local cache. Signing in happens in the
browser (with rclone's own local callback). Per user, without a password.

  cloud-drive add onedrive|gdrive     signing in (in the browser) and mounting; output: JSON
  cloud-drive remove onedrive|gdrive  unmounting and deleting the sign-in (the files in the cloud stay)
  cloud-drive list                    the configured storages (JSON)

Mounting is done by the sloth-cloud@<name>.service user service (by itself at login).
Sloth Center (Account and security → Cloud storage) calls it.
"""
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

HOME = Path.home()
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "rclone" / "rclone.conf"
# service -> (rclone type, the setting's name, the folder's name in the home folder)
SERVICES = {
    "onedrive": ("onedrive", "OneDrive", "OneDrive"),
    "gdrive": ("drive", "GoogleDrive", "Google Drive"),
}
LOGIN_TIMEOUT_S = 600   # the user has this much time to sign in in the browser


def rclone(*args, timeout=60):
    return subprocess.run(["rclone", "--config", str(CONFIG), *args], capture_output=True, text=True,
                          timeout=timeout)


def unit(remote):
    return f"sloth-cloud@{remote}.service"


def configured():
    r = rclone("listremotes")
    return {line.rstrip(":") for line in r.stdout.split()} if r.returncode == 0 else set()


def answer(question):
    """The obvious answer to the setup's questions: browser sign-in, otherwise the default
    (OneDrive: personal / business drive and the first drive; Google Drive: full access)."""
    option = question.get("Option") or {}
    if option.get("Name") == "config_is_local":
        return "true"
    value = option.get("DefaultStr") or option.get("ValueStr") or ""
    if not value and option.get("Examples"):
        value = option["Examples"][0].get("Value", "")
    return value


def add(service):
    kind, remote, folder = SERVICES[service]
    if remote in configured():
        rclone("config", "delete", remote)
    CONFIG.parent.mkdir(parents=True, exist_ok=True)
    r = rclone("config", "create", remote, kind, "--non-interactive")
    for _ in range(20):
        try:
            question = json.loads(r.stdout or "{}")
        except ValueError:
            return {"ok": False, "error": (r.stderr or r.stdout).strip()[-500:]}
        if question.get("Error"):
            return {"ok": False, "error": question["Error"]}
        state = question.get("State", "")
        if not state:
            break
        # with the browser sign-in rclone waits until the user is done
        r = rclone("config", "update", remote, "--continue", "--non-interactive",
                   "--state", state, "--result", answer(question), timeout=LOGIN_TIMEOUT_S)
    if remote not in configured():
        return {"ok": False, "error": "signing in did not finish"}
    (HOME / folder).mkdir(exist_ok=True)
    subprocess.run(["systemctl", "--user", "enable", "--now", unit(remote)], capture_output=True)
    return {"ok": True, "folder": str(HOME / folder)}


def remove(service):
    _kind, remote, folder = SERVICES[service]
    subprocess.run(["systemctl", "--user", "disable", "--now", unit(remote)], capture_output=True)
    rclone("config", "delete", remote)
    path = HOME / folder
    try:
        path.rmdir()  # only if empty (it is after unmounting); the local files are not touched
    except OSError:
        pass
    shutil.rmtree(Path(os.environ.get("XDG_CACHE_HOME", HOME / ".cache")) / "rclone" / "vfs" / remote,
                  ignore_errors=True)
    return {"ok": True}


def listing():
    have = configured()
    out = []
    for service, (_kind, remote, folder) in SERVICES.items():
        active = subprocess.run(["systemctl", "--user", "is-active", "--quiet", unit(remote)]).returncode == 0
        out.append({"service": service, "configured": remote in have, "mounted": active,
                    "folder": str(HOME / folder)})
    return out


def mount(remote):
    """Started by sloth-cloud@<name>.service: rclone runs in this same process (it also sends the systemd notification)."""
    folder = next(f for _k, r, f in SERVICES.values() if r == remote)
    path = HOME / folder
    path.mkdir(exist_ok=True)
    os.execvp("rclone", ["rclone", "--config", str(CONFIG), "mount", f"{remote}:", str(path),
                         # the opened files stay in the local cache (without internet too), for 30 days
                         "--vfs-cache-mode", "full", "--vfs-cache-max-age", "720h", "--vfs-cache-max-size", "20G",
                         "--dir-cache-time", "5m", "--poll-interval", "1m"])


def main(argv):
    if len(argv) == 3 and argv[1] == "mount" and argv[2] in {r for _k, r, _f in SERVICES.values()}:
        mount(argv[2])
    if len(argv) == 2 and argv[1] == "list":
        print(json.dumps(listing()))
        return 0
    if len(argv) == 3 and argv[1] in ("add", "remove") and argv[2] in SERVICES:
        result = add(argv[2]) if argv[1] == "add" else remove(argv[2])
        print(json.dumps(result))
        return 0 if result["ok"] else 1
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
