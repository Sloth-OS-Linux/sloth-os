#!/usr/bin/bash
# In Dolphin's Devices list the system's root (composefs, an "overlay" mount on /) showed up as a nameless,
# 128 TB drive. Of the overlay mounts KDE Solid only shows the one mounted on /, and it can only be hidden with the
# x-gvfs-hide option, which it reads from /etc/fstab. We add this line if it is missing.
# Because of noauto the system does not mount it, and because of ro systemd-remount-fs remounting does not change anything either
# (tried in a VM, 2026-10-19). The other lines of /etc/fstab (e.g. bootc's /boot line) are not touched.
set -euo pipefail

FSTAB=/etc/fstab
LINE="composefs / overlay ro,noauto,x-gvfs-hide 0 0"

[[ "$(findmnt -no FSTYPE /)" == overlay ]] || exit 0
[[ -f $FSTAB ]] && grep -qE '^[^#[:space:]]+[[:space:]]+/[[:space:]]+overlay[[:space:]]' "$FSTAB" && exit 0

{
    echo "# Sloth OS: the system's root must not show as a drive in Dolphin (/usr/libexec/sloth-os/hide-root-overlay)"
    echo "$LINE"
} >> "$FSTAB"
echo "/etc/fstab extended: $LINE"
