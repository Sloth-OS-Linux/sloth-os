#!/usr/bin/python3 -I
"""sloth-helper's operations on versions (pin, unpin, set-default) with a separate polkit action
(org.slothos.helper.versions), so that in the password-free setting they belong among "updates"."""
import runpy

# The name goes in as a global: runpy.run_path sets sys.argv[0] to the path it runs, so a name put there is lost
runpy.run_path("/usr/libexec/sloth-os/sloth-helper", init_globals={"HELPER_NAME": "sloth-helper-versions"},
               run_name="__main__")
