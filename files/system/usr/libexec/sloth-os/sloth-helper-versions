#!/usr/bin/python3 -I
"""sloth-helper's operations on versions (pin, unpin, set-default) with a separate polkit action
(org.slothos.helper.versions), so that in the password-free setting they belong among "updates"."""
import runpy
import sys

sys.argv[0] = "sloth-helper-versions"
runpy.run_path("/usr/libexec/sloth-os/sloth-helper", run_name="__main__")
