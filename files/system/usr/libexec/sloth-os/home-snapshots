#!/usr/bin/python3 -I
"""Automatic backup of your own files: Btrfs snapshots of /var/home (runs as root).

  layout          at startup, before login (sloth-home-layout.service): /var/home becomes a separate subvolume,
                  and so do the big, re-downloadable folders (sloth_common.snapshots.EXCLUDED), so they stay out of
                  the backup. The installer does not create subvolumes, so on existing machines this converts once.
  take            hourly (sloth-home-snapshot.timer): a snapshot, if it is turned on and there is enough space;
                  then thinning out the old ones
  take --now      by hand (Sloth Center, "Back up now", through sloth-helper)
  delete-all      deletes all saved states (Sloth Center)

The conversion: a new subvolume, the contents reflinked into it (instant, takes no new space), then the two
swap places in a single step (mv --exchange). The old copy is deleted only after the swap, so after an interrupted
conversion everything is in its old place on the next start, and it starts over.
take and delete-all print JSON ({"ok": …, "error": …}).
"""
import datetime
import json
import logging
import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, "/usr/lib/sloth-os/common")
from sloth_common import snapshots as snap  # noqa: E402

log = logging.getLogger("home-snapshots")

NEW_SUFFIX, OLD_SUFFIX = ".sloth-new", ".sloth-old"
# This much free space must always remain (10% of the disk, but at least 3 GB); if there is less, the oldest
# saved states are deleted, and if that is still not enough, no new one is made
MIN_FREE_RATIO, MIN_FREE_BYTES = 0.10, 3 * 1024 ** 3
# In the hourly run a new snapshot is made after this much time (after "Back up now" another one should not come right away)
MIN_INTERVAL = datetime.timedelta(minutes=50)


def run(cmd, check=True):
    r = subprocess.run(cmd, capture_output=True, text=True)
    if check and r.returncode != 0:
        raise RuntimeError(f"{' '.join(map(str, cmd))}: {r.stderr.strip()}")
    return r


# --- Conversion (layout) ---------------------------------------------------------------------------

def side(path, suffix):
    return path.with_name(f".{path.name.lstrip('.')}{suffix}")


def mounted_under(path):
    prefix = os.path.realpath(path).rstrip("/") + "/"
    with open("/proc/self/mountinfo", encoding="utf-8") as f:
        points = [line.split()[4].replace(r"\040", " ") for line in f]
    return any(p.startswith(prefix) for p in points)


def delete_tree(path):
    """Deletes a folder or subvolume, together with the subvolumes in it (these look like separate devices,
    so there is no --one-file-system; instead nothing may be mounted below it)."""
    if mounted_under(path):
        raise RuntimeError(f"something is mounted below it, not deleting: {path}")
    if snap.is_subvolume(path):
        run(["btrfs", "subvolume", "delete", "--recursive", str(path)])
    else:
        run(["rm", "-rf", "--", str(path)])


def copy_attrs(src, dst):
    """The folder's own owner, permissions, SELinux label and ACL (cp -a carries the contents')."""
    st = os.lstat(src)
    os.chown(dst, st.st_uid, st.st_gid)
    os.chmod(dst, st.st_mode & 0o7777)
    for attr in ("security.selinux", "system.posix_acl_access", "system.posix_acl_default"):
        try:
            os.setxattr(dst, attr, os.getxattr(src, attr))
        except OSError:
            pass


def recover(path):
    """Cleans up the traces of an earlier, interrupted conversion."""
    new, old = side(path, NEW_SUFFIX), side(path, OLD_SUFFIX)
    if os.path.lexists(old) and not os.path.lexists(path):
        # interrupted during the two-step swap: the original goes back in its place
        log.info("restoring the original: %s", path)
        os.rename(old, path)
    if os.path.lexists(new):
        log.info("deleting an unfinished copy: %s", new)
        delete_tree(new)
    if os.path.lexists(old):
        log.info("deleting the old copy: %s", old)
        delete_tree(old)


def convert(path):
    """Turns an existing folder into a subvolume (its place and contents stay the same)."""
    new, old = side(path, NEW_SUFFIX), side(path, OLD_SUFFIX)
    log.info("converting to a subvolume: %s", path)
    run(["btrfs", "subvolume", "create", str(new)])
    try:
        copy_attrs(path, new)
        # instant with reflink; where that does not work (e.g. no-copy-on-write files), a plain copy
        run(["cp", "-a", "--reflink=auto", "--", f"{path}/.", f"{new}/"])
        os.sync()
        exchanged = run(["mv", "--exchange", "--no-target-directory", "--", str(new), str(path)], check=False)
        if exchanged.returncode != 0:
            # two renames; if interrupted meanwhile, recover() keeps the old one and deletes the new one
            log.info("mv --exchange: %s; in two steps", exchanged.stderr.strip())
            os.rename(path, old)
            os.rename(new, path)
            os.rename(old, new)
    except Exception:
        if os.path.lexists(old) and not os.path.lexists(path):
            os.rename(old, path)
        if os.path.lexists(new) and snap.is_subvolume(new):
            delete_tree(new)
        raise
    # after the swap the old folder is under the name "new"
    os.rename(new, old)
    os.sync()
    delete_tree(old)


def create(path, owner_of):
    """An excluded folder that does not exist yet (e.g. ~/.cache) is created as a subvolume right away."""
    run(["btrfs", "subvolume", "create", str(path)])
    st = os.lstat(owner_of)
    os.chown(path, st.st_uid, st.st_gid)
    os.chmod(path, 0o700)
    run(["restorecon", str(path)], check=False)


def excluded_dirs(home):
    for pattern in snap.EXCLUDED:
        if "*" in pattern:
            yield from home.glob(pattern)
        else:
            yield home / pattern


def layout():
    if snap.fs_type(snap.HOME_ROOT) != "btrfs":
        log.info("/var/home is not Btrfs: nothing to do")
        return 0
    failed = False
    if not snap.is_subvolume(snap.HOME_ROOT):
        try:
            recover(snap.HOME_ROOT)
            convert(snap.HOME_ROOT)
            run(["restorecon", str(snap.HOME_ROOT)], check=False)
        except Exception as e:  # the old one stays; again on the next start
            log.error("converting /var/home failed: %s", e)
            return 1
    try:
        recover(snap.HOME_ROOT)
    except Exception as e:  # only the old copy remained; take tries too
        log.error("deleting the old /var/home failed: %s", e)
    for home in sorted(snap.HOME_ROOT.iterdir()):
        if home.name.startswith(".") or home.is_symlink() or not home.is_dir():
            continue
        for path in excluded_dirs(home):
            try:
                if path.is_symlink():
                    continue
                recover(path)
                if path.is_dir():
                    if not snap.is_subvolume(path):
                        convert(path)
                elif path.name == ".cache" and not os.path.lexists(path):
                    create(path, home)
            except Exception as e:
                log.error("%s: %s", path, e)
                failed = True
    return 1 if failed else 0


# --- Snapshots ---------------------------------------------------------------------------------

def low_space():
    st = os.statvfs(snap.HOME_ROOT)
    free, total = st.f_bavail * st.f_frsize, st.f_blocks * st.f_frsize
    return free < max(MIN_FREE_RATIO * total, MIN_FREE_BYTES)


def delete(names):
    for name in names:
        log.info("deleting: %s", name)
        run(["btrfs", "subvolume", "delete", str(snap.SNAP_DIR / name)], check=False)


def free_space():
    """When space is low, deletes the oldest ones (the newest stays). A deleted snapshot's space is only freed in the
    background, so we wait after each one (subvolume sync) before measuring again."""
    while low_space():
        existing = snap.list_snapshots()
        if len(existing) <= 1:
            return False
        delete([existing[-1][0]])
        run(["btrfs", "subvolume", "sync", str(snap.SNAP_DIR)], check=False)
    return True


def prune(cfg):
    existing = snap.list_snapshots()
    keep = snap.to_keep(existing, snap.KEEP_DAYS[cfg["keep"]])
    delete([name for name, _when in existing if name not in keep])


def ensure_snap_dir():
    if snap.is_subvolume(snap.SNAP_DIR):
        return
    run(["btrfs", "subvolume", "create", str(snap.SNAP_DIR)])
    # everyone can enter; inside the snapshots the old permissions apply (everyone only sees their own files)
    os.chmod(snap.SNAP_DIR, 0o755)
    run(["restorecon", str(snap.SNAP_DIR)], check=False)


def take(now_requested):
    if snap.state() != "ready":
        return {"ok": False, "error": "not-ready"}
    # the old copy of an unfinished conversion (next to /var/home), if it could not be deleted at startup
    recover(snap.HOME_ROOT)
    cfg = snap.load_config()
    if not cfg["enabled"] and not now_requested:
        prune(cfg)
        return {"ok": True, "error": ""}
    ensure_snap_dir()
    if not free_space():
        log.warning("low on free space, no new snapshot is made")
        return {"ok": False, "error": "no-space"}
    now = datetime.datetime.now(datetime.timezone.utc)
    existing = snap.list_snapshots()
    if not now_requested and existing and now - existing[0][1] < MIN_INTERVAL:
        return {"ok": True, "error": ""}
    name = snap.make_name(now)
    if not os.path.lexists(snap.SNAP_DIR / name):
        run(["btrfs", "subvolume", "snapshot", "-r", str(snap.HOME_ROOT), str(snap.SNAP_DIR / name)])
        log.info("snapshot: %s", name)
    prune(cfg)
    return {"ok": True, "error": "", "name": name}


def delete_all():
    delete([name for name, _when in snap.list_snapshots()])
    return {"ok": True, "error": ""}


def main(argv):
    logging.basicConfig(level=logging.INFO, format="%(message)s")
    if os.geteuid() != 0:
        print(json.dumps({"ok": False, "error": "root needed"}))
        return 1
    if argv == ["layout"]:
        return layout()
    if argv in (["take"], ["take", "--now"]):
        try:
            result = take(argv == ["take", "--now"])
        except Exception as e:
            log.error("%s", e)
            result = {"ok": False, "error": str(e)}
    elif argv == ["delete-all"]:
        result = delete_all()
    else:
        print(__doc__, file=sys.stderr)
        return 2
    print(json.dumps(result))
    return 0 if result["ok"] else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
