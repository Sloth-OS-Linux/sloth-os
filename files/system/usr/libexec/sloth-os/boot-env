#!/usr/bin/env bash
# A boot menü állapota az EFI partíción (EFI/fedora/sloth-boot.env), lásd /usr/lib/sloth-os/grub-custom.cfg.
#
#   boot-env set KULCS=ÉRTÉK...   beállítás (ha a fájl nincs meg, létrehozza)
#   boot-env ensure-config        a /boot/grub2/custom.cfg pótlása vagy frissítése, ha hiányzik vagy eltér
#                                 (nem a saját telepítővel telepített gépeken, és ha a sablon frissült)
#   boot-env set-title SZÖVEG     a boot menü „Alaphelyzetbe állítás” pontjának felirata (sloth_reset_title)
#   boot-env take-reset           ha a boot menüben az alaphelyzetet választották (sloth_reset=keep): kiírja,
#                                 hogy "keep", és törli a jelzést (sloth-boot-reset.service)
#
# Az EFI partíciót a rendszer nem csatolja; ha kell, ideiglenesen csatoljuk, és utána leválasztjuk.
set -euo pipefail

ESP_TYPE=c12a7328-f81f-11d2-ba4b-00a0c93ec93b
TEMPLATE=/usr/lib/sloth-os/grub-custom.cfg

find_esp() {
  local root disk
  root=$(findmnt -no SOURCE /sysroot 2>/dev/null || findmnt -no SOURCE /)
  root=${root%%[*}   # btrfs: /dev/sda3[/subvol]
  # a lemez az ősök közül (titkosításnál a gyökér /dev/mapper/…, a szülője a partíció, csak annak a szülője a lemez)
  disk=$(lsblk -nspo NAME,TYPE "$root" | awk '$2 == "disk" { sub(/^.*\//, "", $1); print $1; exit }')
  [[ -n $disk ]] || return 1
  # Windows mellett két EFI partíció is van a lemezen: a Sloth OS sajátja az "EFI-SYSTEM" nevű
  # (a telepítő így hozza létre); ha nincs ilyen, az első
  lsblk -lnpo PATH,PARTTYPE,PARTLABEL "/dev/$disk" |
    awk -v t="$ESP_TYPE" 'tolower($2) == t { if ($3 == "EFI-SYSTEM") { print $1; found = 1; exit } if (!first) first = $1 }
                          END { if (!found && first) print first }'
}

with_esp() {  # with_esp <parancs...>: a parancs az ESP csatolási pontját kapja $ESP-ként
  local dev mnt
  mnt=$(findmnt -no TARGET /boot/efi 2>/dev/null || true)
  if [[ -n $mnt ]]; then
    ESP=$mnt "$@"
    return
  fi
  dev=$(find_esp) || true
  [[ -n $dev ]] || { echo "Nincs EFI partíció." >&2; return 1; }
  mnt=$(mktemp -d /run/sloth-esp.XXXXXX)
  mount -t vfat "$dev" "$mnt"
  local rc=0
  ESP=$mnt "$@" || rc=$?
  umount "$mnt"
  rmdir "$mnt"
  return $rc
}

set_values() {
  local env="$ESP/EFI/fedora/sloth-boot.env" changed=0 kv
  [[ -d $ESP/EFI/fedora ]] || { echo "Nincs EFI/fedora mappa." >&2; return 1; }
  [[ -f $env ]] || grub2-editenv "$env" create
  for kv in "$@"; do
    # ne írjunk feleslegesen az EFI partícióra
    grub2-editenv "$env" list | grep -qxF "$kv" || changed=1
  done
  if (( changed )); then
    grub2-editenv "$env" set "$@"
  fi
}

ensure_config() {
  cmp -s "$TEMPLATE" /boot/grub2/custom.cfg && return 0
  [[ -d /boot/grub2 ]] || return 0
  # a /boot csak olvasható; saját névtérben átmenetileg írhatóvá tesszük (mint az rpm-ostree)
  unshare -m sh -c "mount -o remount,rw /boot && install -m 0644 '$TEMPLATE' /boot/grub2/custom.cfg"
}

case "${1:-}" in
  set)
    shift
    for kv in "$@"; do
      [[ $kv =~ ^sloth_[a-z_]+=[01]$ ]] || { echo "Rossz érték: $kv" >&2; exit 2; }
    done
    with_esp set_values "$@"
    ;;
  ensure-config)
    ensure_config
    ;;
  set-title)
    title=${2:-}
    # a GRUB menüpont felirata: egy sor, idézőjel, dollár és visszaper nélkül
    [[ -n $title && ${#title} -le 80 && $title != *[\"\$\\\`]* && $title != *$'\n'* ]] || { echo "Rossz felirat" >&2; exit 2; }
    with_esp sh -c 'env="$ESP/EFI/fedora/sloth-boot.env"; [ -f "$env" ] || exit 0
      grub2-editenv "$env" list | grep -qxF "sloth_reset_title=$1" || grub2-editenv "$env" set "sloth_reset_title=$1"' _ "$title"
    ;;
  take-reset)
    with_esp sh -c 'env="$ESP/EFI/fedora/sloth-boot.env"; [ -f "$env" ] || exit 0
      if grub2-editenv "$env" list | grep -qx "sloth_reset=keep"; then grub2-editenv "$env" unset sloth_reset; echo keep; fi'
    ;;
  *)
    echo "Használat: boot-env set KULCS=ÉRTÉK... | ensure-config | set-title SZÖVEG | take-reset" >&2
    exit 2
    ;;
esac
