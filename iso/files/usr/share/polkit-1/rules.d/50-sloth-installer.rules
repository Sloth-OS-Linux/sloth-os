// Az élő rendszer felhasználójának (liveuser, jelszó nélkül) ne kelljen jelszót megadnia a telepítéshez.
// Csak a telepítő ISO-n van meg; a telepített rendszerbe nem kerül.
polkit.addRule(function (action, subject) {
    if (action.id === "org.slothos.installer.install" && subject.user === "liveuser" && subject.active) {
        return polkit.Result.YES;
    }
});
