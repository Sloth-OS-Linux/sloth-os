#!/usr/bin/python3 -I
"""The privileged part of the Sloth OS installer (runs with pkexec; only present in the live system).

  sloth-install-helper install --disk /dev/X --locale hu_HU.UTF-8 --keyboard hu --timezone Europe/Budapest \
                             --username anna --fullname "Anna Kiss"      (the password on standard input)
                             [--beside-windows --size-gib 120]
  sloth-install-helper probe --disk /dev/X     survey of the disk for installing next to Windows (JSON)

By default it erases the whole disk, partitions it, and installs the Sloth OS image packed into the ISO
(bootc install to-filesystem), then writes the chosen language, keyboard and time zone, and the
account details (the account is created on first boot by the sloth-first-user service).
bootc unpacks the layers temporarily into /var/tmp; in the live system that is in RAM, so for the
duration of the install a temporary work partition at the end of the disk is put over /var/tmp (as an overlay).
At the end this partition is deleted, and the system partition takes its place.
The output is JSON lines for the UI:
  {"stage": "partition", "progress": 10}   a known stage (the UI translates it)
  {"done": true}                            done
  {"error": "error.bad_disk"}               an error (translation key)
The raw output goes to /tmp/sloth-install.log.

Next to Windows (--beside-windows): Windows stays. If the disk has enough free space, Sloth OS goes
there; otherwise the identified Windows system partition is shrunk (ntfsresize), and Sloth OS goes into the
freed space. Sloth OS gets its own EFI partition (Windows' boot files are not touched), the boot
menu includes Windows (and the menu is shown), and the hardware clock keeps local time, as in Windows.
Only on UEFI machines and GPT disks; a BitLocker-encrypted or not fully shut down (fast startup, hibernation)
Windows partition is never shrunk.

Other disks (--extra-disk keep:/dev/Y or erase:/dev/Y, any number): by default they are not touched. "keep"
mounts their Linux file systems as they are; "erase" makes one btrfs partition for programs and games (encrypted
too if the system is, with a key file on the encrypted system, so there is only one password at boot). Both are
mounted under /var/mnt with nofail. A disk with Windows data (NTFS, BitLocker) is never changed.
Dry run without erasing anything (for testing the UI): SLOTH_INSTALL_DRY_RUN=1
"""
import argparse
import glob
import json
import os
import re
import secrets
import shutil
import subprocess
import sys
import tempfile
import threading
import time
import traceback
import zoneinfo
from pathlib import Path

LOG = Path("/tmp/sloth-install.log")
# The system uses these names; they cannot be user accounts
RESERVED_USERS = {"root", "bin", "daemon", "adm", "lp", "sync", "shutdown", "halt", "mail", "operator",
                  "games", "ftp", "nobody", "systemd-network", "dbus", "polkitd", "sddm", "plasmalogin",
                  "liveuser", "admin", "wheel", "users"}
IMAGE_CONF = Path("/usr/share/sloth-os/installer/image.conf")
TARGET = Path("/run/sloth-install/target")      # the system partition is mounted here
SCRATCH = Path("/run/sloth-install/scratch")    # the temporary work partition
SCRATCH_BYTES = 10 * 1024**3                     # for the unpacked layers (measured peak ~2.1 GB + headroom)
# bootc copies each layer to /var/tmp (the work partition) whole before importing it: a squashed image is one
# layer of the full image size (1.0.2: 13.8 GB, "no space left on device" on the 10 GB partition), so then it
# has to be bigger. verify_image sets it.
scratch_bytes = SCRATCH_BYTES

MIN_BESIDE_BYTES = 40 * 1024**3                  # next to Windows, Sloth OS needs at least this much
WINDOWS_RESERVE = 20 * 1024**3                   # after shrinking, Windows keeps this much free space
ESP_MIB = 512
BOOT_MIB = 1024    # separate /boot with encryption (GRUB cannot open LUKS2; the kernel lives here)
MIB = 1024**2
CRYPT_NAME = "sloth-root"
CRYPT_DEV = Path("/dev/mapper") / CRYPT_NAME

# GPT partition types
BIOS_BOOT = "21686148-6449-6e6f-744e-656564454649"
ESP_TYPE = "c12a7328-f81f-11d2-ba4b-00a0c93ec93b"
ROOT_X86_64 = "4f68bce3-e8cd-4db1-96e7-fbcaf984b709"
LINUX_DATA = "0fc63daf-8483-4772-8e79-3d69d8477de4"
MS_BASIC_DATA = "ebd0a0a2-b9e5-4433-87c0-68b6b72699c7"

# bootc output -> stage and approximate percentage (the first match wins). The copy progress is
# computed not from the output but from the space used on the system partition (copy_progress).
STAGES = [
    (("initializing ostree", "ostree layout", "sysroot"), "prepare", 20),
    (("fetching", "layer", "importing", "deploying", "pulling"), "copy", 25),
    (("bootloader", "bootupd", "grub"), "bootloader", 85),
    (("installation complete",), "finishing", 90),
]


def emit(**msg):
    print(json.dumps(msg), flush=True)


def log(line):
    with LOG.open("a", encoding="utf-8") as f:
        f.write(line.rstrip() + "\n")


def fail(key, detail=""):
    if detail:
        log(f"HIBA: {detail}")
    emit(error=key)
    sys.exit(1)


# --- Input validation (we run as root: nothing is accepted blindly) ---------

def whole_disk(path):
    """Only a whole disk is accepted, and not the live system's own drive."""
    if not re.fullmatch(r"/dev/[a-zA-Z0-9]+", path or ""):
        return False
    out = subprocess.run(["lsblk", "--noheadings", "--nodeps", "--output", "TYPE,RO", path],
                         capture_output=True, text=True).stdout.split()
    if out[:2] != ["disk", "0"]:
        return False
    live = subprocess.run(["findmnt", "--noheadings", "--output", "SOURCE", "/run/initramfs/live"],
                          capture_output=True, text=True).stdout.strip()
    if live:
        # the whole chain upwards: with Ventoy the source is /dev/mapper/ventoy on a partition of the stick
        chain = subprocess.run(["lsblk", "--inverse", "--noheadings", "--raw", "--output", "PATH", live],
                               capture_output=True, text=True).stdout.split()
        if path in {live, *chain}:
            return False
    return True


def parse_keyboard(value):
    """"us,ru" -> (["us", "ru"], ["", ""]); "us(intl)" -> (["us"], ["intl"])."""
    layouts, variants = [], []
    for item in (value or "").split(","):
        m = re.fullmatch(r"([a-z]{2,6})(?:\(([a-z0-9_]{1,20})\))?", item)
        if not m:
            return None
        layouts.append(m.group(1))
        variants.append(m.group(2) or "")
    return (layouts, variants) if layouts else None


# --- Installation --------------------------------------------------------------------

def image_refs():
    conf = dict(line.split("=", 1) for line in IMAGE_CONF.read_text().split("\n") if "=" in line)
    return conf["SOURCE_IMGREF"], conf["TARGET_IMGREF"]


def verify_image():
    """Checks the image to install before anything on the disk is touched: if it is missing or incomplete
    (a damaged USB stick, a broken ISO), the installation stops here, and the disk stays as it was."""
    try:
        source, _ = image_refs()
    except (OSError, KeyError, ValueError) as e:
        fail("error.image_broken", f"image.conf: {e}")
    name = source.split(":", 1)[1]
    for tool in ("bootc", "podman"):
        if not shutil.which(tool):
            fail("error.image_broken", f"missing: {tool}")
    info = json.loads(run(["podman", "image", "inspect", name], error="error.image_broken"))[0]
    layers = (info.get("RootFS") or {}).get("Layers") or []
    log(f"image: {info.get('Id')}, {len(layers)} layers")
    global scratch_bytes
    if len(layers) == 1:
        scratch_bytes = max(SCRATCH_BYTES, int(info.get("Size") or 0) * 11 // 10 + 1024**3)
        log(f"work partition: {scratch_bytes // MIB} MiB")
    # bootc looks for the layer the ostree.final-diffid label names; if it is not there (e.g. a wrongly squashed
    # image), bootc would stop only after the disk was erased ("Missing ostree.final-diffid")
    labels = info.get("Labels") or (info.get("Config") or {}).get("Labels") or {}
    final = labels.get("ostree.final-diffid")
    if final and final not in layers:
        fail("error.image_broken", f"the layer named by ostree.final-diffid is missing: {final}")
    # the parts bootc needs must be there and readable. Looked up in the layers' folders, not through
    # "podman image mount": in the live system that mount came back empty for the 280-layer image (1.0.2 on an HP)
    data = (info.get("GraphDriver") or {}).get("Data") or {}
    dirs = [Path(d) for d in [data.get("UpperDir")] + (data.get("LowerDir") or "").split(":") if d]
    missing_layers = [str(d) for d in dirs if not d.is_dir()]
    if not dirs or missing_layers:
        fail("error.image_broken", f"layer folders missing: {missing_layers or 'none listed'}")
    try:
        missing = [p for p in ("usr/bin/bootc", "usr/bin/bootupctl", "usr/lib/os-release", "usr/lib/ostree")
                   if not any((d / p).exists() for d in dirs)]
        kernels = [k for d in dirs for k in glob.glob(str(d / "usr/lib/modules/*/vmlinuz"))]
        if not kernels:
            missing.append("usr/lib/modules/*/vmlinuz")
        if missing:
            fail("error.image_broken", f"missing from the image: {', '.join(missing)}")
        for k in kernels:
            with open(k, "rb") as f:     # a read error from a damaged stick shows up here
                while f.read(4 * MIB):
                    pass
    except OSError as e:
        fail("error.image_broken", f"cannot read the image: {e}")
    log("image check: OK")


def release_disk(disk):
    """If something uses the disk (an automounted partition, swap), let it go."""
    out = json.loads(subprocess.run(["lsblk", "--json", "--tree", "--output", "PATH,MOUNTPOINTS,FSTYPE", disk],
                                    capture_output=True, text=True).stdout or "{}")
    stack = list(out.get("blockdevices", []))
    while stack:
        dev = stack.pop()
        stack.extend(dev.get("children") or [])
        if dev.get("fstype") == "swap":
            subprocess.run(["swapoff", dev["path"]], capture_output=True)
        for mp in dev.get("mountpoints") or []:
            if mp:
                subprocess.run(["umount", "--lazy", mp], capture_output=True)


def run(cmd, error="error.install_failed", **kwargs):
    """Runs a command with logging; if it fails, the UI shows the error page."""
    log("$ " + " ".join(cmd))
    r = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, **kwargs)
    if r.stdout.strip():
        log(r.stdout)
    if r.returncode != 0:
        fail(error, f"{cmd[0]} exit code: {r.returncode}")
    return r.stdout


def partitions(disk):
    """{partition number: device} on the disk, after udev has caught up."""
    run(["udevadm", "settle", "--timeout=30"])
    out = json.loads(run(["lsblk", "--json", "--tree", "--output", "PATH,PARTN", disk]) or "{}")
    found = {}
    for c in (c for d in out.get("blockdevices", []) for c in d.get("children") or []):
        n = c.get("partn")
        if not n:   # without udev's data the kernel's own number (sysfs)
            try:
                n = (Path("/sys/class/block") / Path(c["path"]).name / "partition").read_text().strip()
            except OSError:
                continue
        found[int(n)] = c["path"]
    return found


def partition(disk, encrypt=False):
    """A new GPT on the disk: BIOS boot, EFI, (with encryption /boot,) system, and the temporary work partition at the end."""
    size_mib = int(run(["lsblk", "--noheadings", "--nodeps", "--bytes", "--output", "SIZE", disk])) // 1024**2
    # 1 MiB at the start and 1 MiB at the end for the GPT; BIOS boot 1 MiB, EFI 512 MiB
    boot_mib = BOOT_MIB if encrypt else 0
    root_mib = size_mib - 2 - 1 - ESP_MIB - boot_mib - scratch_bytes // 1024**2 - 2
    if root_mib < 20 * 1024:
        fail("error.bad_disk", f"disk too small: {size_mib} MiB")
    run(["wipefs", "--all", "--force", disk])
    names = ["bios", "esp"] + (["boot"] if encrypt else []) + ["root", "scratch"]
    table = (
        "label: gpt\n"
        f"size=1MiB, type={BIOS_BOOT}, name=\"BIOS-BOOT\"\n"
        f"size={ESP_MIB}MiB, type={ESP_TYPE}, name=\"EFI-SYSTEM\"\n"
        + (f"size={boot_mib}MiB, type={LINUX_DATA}, name=\"boot\"\n" if encrypt else "")
        + f"size={root_mib}MiB, type={ROOT_X86_64}, name=\"root\"\n"
        f"type={LINUX_DATA}, name=\"sloth-install-tmp\"\n")
    run(["sfdisk", "--wipe", "always", "--wipe-partitions", "always", disk], input=table)
    parts = partitions(disk)
    if sorted(parts) != list(range(1, len(names) + 1)):
        fail("error.install_failed", f"unexpected partitions: {parts}")
    out = {name: parts[i + 1] for i, name in enumerate(names)}
    out["numbers"] = {name: i + 1 for i, name in enumerate(names)}
    return out


# --- Next to Windows ------------------------------------------------------------------

def table(disk):
    """The disk's partition table (sfdisk --json): label, sector size, partitions."""
    r = subprocess.run(["sfdisk", "--json", disk], capture_output=True, text=True)
    pt = json.loads(r.stdout or "{}").get("partitiontable", {}) if r.returncode == 0 else {}
    pt.setdefault("sectorsize", 512)
    pt.setdefault("partitions", [])
    return pt


def free_regions(pt):
    """The free areas (start sector, number of sectors), aligned to 1 MiB."""
    ss = pt["sectorsize"]
    align = MIB // ss
    first, last = pt.get("firstlba", align), pt.get("lastlba", 0)
    out, pos = [], first
    for p in sorted(pt["partitions"], key=lambda p: p["start"]):
        if p["start"] > pos:
            out.append((pos, p["start"] - pos))
        pos = max(pos, p["start"] + p["size"])
    if last + 1 > pos:
        out.append((pos, last + 1 - pos))
    aligned = []
    for start, size in out:
        a = -(-start // align) * align
        end = (start + size) // align * align
        if end > a:
            aligned.append((a, end - a))
    return aligned


def gap_after(pt, part):
    """The size in sectors of the free area right after the partition (if any)."""
    align = MIB // pt["sectorsize"]
    start = -(-(part["start"] + part["size"]) // align) * align
    return next((sz for st, sz in free_regions(pt) if st == start), 0)


def fstype(dev):
    return subprocess.run(["blkid", "-o", "value", "-s", "TYPE", dev], capture_output=True, text=True).stdout.strip()


def fs_uuid(dev):
    return subprocess.run(["blkid", "-o", "value", "-s", "UUID", dev], capture_output=True, text=True).stdout.strip()


# --- Other disks -----------------------------------------------------------------------

KEEP_FS = {"ext4", "btrfs", "xfs"}            # mounted as they are with "keep"
NEVER_CHANGE_FS = {"ntfs", "bitlocker"}        # Windows data: such a disk is never erased or mounted here


def disk_filesystems(disk):
    """[(device, file system)] on a disk: its partitions, or the disk itself without a partition table.
    The file system comes from blkid itself (lsblk's may be missing or stale without udev)."""
    out = json.loads(subprocess.run(["lsblk", "--json", "--output", "PATH", disk],
                                    capture_output=True, text=True).stdout or "{}")
    found, stack = [], list(out.get("blockdevices", []))
    while stack:
        dev = stack.pop(0)
        stack.extend(dev.get("children") or [])
        fs = fstype(dev["path"]).lower()
        if fs:
            found.append((dev["path"], fs))
    return found


def parse_extra(values, target):
    """The --extra-disk choices, checked again here (the UI offers only these too)."""
    extras = []
    for value in values:
        choice, _, path = value.partition(":")
        if choice not in ("keep", "erase") or path == target or not whole_disk(path) \
                or path in {d for _c, d in extras}:
            fail("error.bad_input", f"bad extra disk: {value}")
        fstypes = {fs for _dev, fs in disk_filesystems(path)}
        if fstypes & NEVER_CHANGE_FS:
            fail("error.bad_input", f"a disk with Windows data is never changed: {path}")
        if choice == "keep" and not fstypes & KEEP_FS:
            fail("error.bad_input", f"nothing to mount on: {path}")
        extras.append((choice, path))
    return extras


def _mount_name(base, used):
    """A mount point name under /var/mnt: lowercase letters, digits and dashes, unique."""
    name = re.sub(r"[^a-z0-9-]+", "-", base.lower()).strip("-")[:30] or "disk"
    out, n = name, 2
    while out in used:
        out, n = f"{name}-{n}", n + 1
    used.add(out)
    return out


def prepare_extra_disks(extras, encrypt, label):
    """Erases or keeps the other disks. What the new system needs (configure writes it):
    {"fstab": [lines], "crypttab": [lines], "keys": {file name: key}, "mounts": [names], "owned": [mount points]}."""
    result = {"fstab": [], "crypttab": [], "keys": {}, "mounts": [], "owned": []}
    used = set()
    options = "defaults,nofail,X-mount.mkdir,x-systemd.device-timeout=10s"
    for n, (choice, disk) in enumerate(extras, 1):
        release_disk(disk)
        if choice == "keep":
            for dev, fs in disk_filesystems(disk):
                if fs not in KEEP_FS:
                    continue
                name = subprocess.run(["blkid", "-o", "value", "-s", "LABEL", dev],
                                      capture_output=True, text=True).stdout.strip()
                name = _mount_name(name or os.path.basename(dev), used)
                result["fstab"].append(f"UUID={fs_uuid(dev)} /var/mnt/{name} {fs} {options} 0 0")
                result["mounts"].append(name)
            continue
        run(["wipefs", "--all", "--force", disk])
        run(["sfdisk", "--wipe", "always", "--wipe-partitions", "always", disk],
            input=f"label: gpt\ntype={LINUX_DATA}, name=\"sloth-data\"\n")
        part = partitions(disk).get(1)
        if not part:
            fail("error.install_failed", f"no partition on {disk}")
        dev, uuid, key = part, "", ""
        if encrypt:
            key, mapper = secrets.token_hex(32), f"sloth-extra-{n}"
            run(["cryptsetup", "luksFormat", "--type", "luks2", "--batch-mode", "--key-file=-", part],
                input=key, error="error.encrypt_failed")
            run(["cryptsetup", "open", "--allow-discards", "--key-file=-", part, mapper],
                input=key, error="error.encrypt_failed")
            uuid = run(["cryptsetup", "luksUUID", part]).strip()
            dev = f"/dev/mapper/{mapper}"
        run(["mkfs.btrfs", "--force", "--label", label, dev])
        fsid = fs_uuid(dev)
        if encrypt:
            subprocess.run(["cryptsetup", "close", mapper], capture_output=True)
            result["keys"][f"luks-{uuid}.key"] = key
            result["crypttab"].append(f"luks-{uuid} UUID={uuid} /etc/sloth-os/keys/luks-{uuid}.key nofail,discard")
        name = _mount_name("data", used)
        result["fstab"].append(f"UUID={fsid} /var/mnt/{name} btrfs {options},compress=zstd:1 0 0")
        result["mounts"].append(name)
        result["owned"].append(f"/var/mnt/{name}")
    return result


def windows_esps(disk):
    """Windows EFI partitions on this disk; a different disk's boot loader must not be paired with it."""
    found = []
    for p in table(disk)["partitions"]:
        if (p.get("type") or "").lower() != ESP_TYPE or fstype(p["node"]) != "vfat":
            continue
        mnt = Path(tempfile.mkdtemp(prefix="sloth-esp-"))
        try:
            if subprocess.run(["mount", "-o", "ro", p["node"], str(mnt)], capture_output=True).returncode:
                continue
            try:
                found_bootloader = (mnt / "EFI/Microsoft/Boot/bootmgfw.efi").is_file()
            finally:
                subprocess.run(["umount", str(mnt)], capture_output=True)
            if found_bootloader:
                uuid = fs_uuid(p["node"])
                if uuid:
                    found.append({"path": p["node"], "uuid": uuid})
        finally:
            mnt.rmdir()
    return found


def has_windows_system_files(dev):
    """Only treat an NTFS volume as Windows after finding its OS loader and registry hive.

    A data-only NTFS partition is not a safe substitute for C:. If either marker cannot be read, do not shrink it.
    """
    for path in ("Windows/System32/winload.efi", "Windows/System32/config/SYSTEM"):
        try:
            r = subprocess.run(["ntfscat", dev, path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                               timeout=15)
        except (OSError, subprocess.SubprocessError):
            return False
        if r.returncode != 0:
            return False
    return True


def hibernated(dev):
    """Windows was shut down with hibernation or fast startup: hiberfil.sys starts with "hibr" (not "wake" or empty).

    Then Windows would write its old state back from the memory image on its next start, and the partition
    changed in the meantime would be ruined. ntfsresize --info does not check this (it opens read-only), so we
    check it separately, read-only (ntfscat, without mounting).
    """
    try:
        proc = subprocess.Popen(["ntfscat", dev, "hiberfil.sys"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        head = proc.stdout.read(4)
        proc.kill()
        proc.wait()
    except OSError:
        return False
    log(f"hiberfil.sys eleje ({dev}): {head!r}")
    return head.lower() == b"hibr"


def ntfs_info(dev):
    """(minimum size in bytes or None, problem: "" | "hibernated" | "dirty" | "unknown") according to ntfsresize."""
    if hibernated(dev):
        return None, "hibernated"
    r = subprocess.run(["ntfsresize", "--info", "--no-progress-bar", dev], capture_output=True, text=True)
    text = (r.stdout + r.stderr)
    log(f"ntfsresize --info {dev}: {r.returncode}\n{text}")
    low = text.lower()
    if "hibernat" in low or "unsafe state" in low or "fast restart" in low:
        return None, "hibernated"
    if "scheduled for check" in low or "dirty" in low or "chkdsk" in low:
        return None, "dirty"
    m = re.search(r"you might resize at (\d+) bytes", low)
    if r.returncode != 0 or not m:
        return None, "unknown"
    return int(m.group(1)), ""


def probe(disk):
    """The options for installing next to Windows: how much space Sloth OS can get, and what prevents it."""
    pt = table(disk)
    ss = pt["sectorsize"]
    info = {"uefi": Path("/sys/firmware/efi").is_dir(), "gpt": pt.get("label") == "gpt",
            "windowsEsp": "", "free": 0, "shrinkable": 0, "max": 0, "problems": [], "bitlocker": False}
    if not info["uefi"]:
        info["problems"].append("not_uefi")
    if not info["gpt"]:
        info["problems"].append("not_gpt")
    if info["problems"]:
        return info
    release_disk(disk)
    windows_esps_found = windows_esps(disk)
    # Refuse ambiguous/missing Windows boot files; pairing an NTFS volume with an EFI partition from another disk
    # could make the new boot menu point at the wrong Windows installation.
    if len(windows_esps_found) != 1:
        info["problems"].append("unknown")
        return info
    info["windowsEsp"] = windows_esps_found[0]["uuid"]
    regions = free_regions(pt)
    info["free"] = max((size * ss for _s, size in regions), default=0)
    types = {p["node"]: fstype(p["node"]) for p in pt["partitions"]}
    info["bitlocker"] = any(t.lower() == "bitlocker" for t in types.values())
    ntfs = [p for p in pt["partitions"] if types.get(p["node"]) == "ntfs"]
    windows = [p for p in ntfs if has_windows_system_files(p["node"])]
    if len(windows) == 1:
        win = windows[0]
        size = win["size"] * ss
        minimum, problem = ntfs_info(win["node"])
        if problem:
            info["problems"].append(problem)
        else:
            after = gap_after(pt, win) * ss
            shrink = max(0, size - minimum - WINDOWS_RESERVE) // MIB * MIB
            info["windows"] = {"path": win["node"], "size": size, "min": minimum, "after": after}
            info["shrinkable"] = shrink + after if shrink else 0
    elif not windows and not ntfs and info["bitlocker"]:
        # A locked BitLocker Windows volume cannot be inspected or resized. It can only proceed if
        # the user already freed enough unallocated space; the UI warns about the recovery key.
        info["problems"].append("bitlocker")
    else:
        info["problems"].append("unknown")
    info["max"] = max(info["free"], info["shrinkable"])
    if info["max"] < MIN_BESIDE_BYTES and not set(info["problems"]) & {"hibernated", "dirty", "bitlocker"}:
        info["problems"].append("no_space")
    return info


# Why installing next to Windows is not possible -> the UI's error message (translation key; the same
# explanation that the disk selection page shows)
BESIDE_PROBLEMS = ("not_uefi", "not_gpt", "hibernated", "dirty", "unknown", "bitlocker", "no_space")
BESIDE_ERRORS = {p: f"disk.beside.{p}" for p in BESIDE_PROBLEMS if p != "bitlocker"}


def partition_beside(disk, size_bytes, encrypt=False):
    """Where Sloth OS goes next to Windows: the existing free space, or shrinking the Windows partition.

    -> (partitions {"esp", "root", "scratch"} by device and partition number, the FS-UUID of the Windows EFI)
    """
    info = probe(disk)
    blocking = [p for p in info["problems"] if p in BESIDE_ERRORS]
    if blocking:
        fail(BESIDE_ERRORS[blocking[0]], f"cannot install next to Windows: {info}")
    if size_bytes > info["max"]:
        fail(BESIDE_ERRORS["no_space"], f"not enough space: {size_bytes} (max {info['max']})")
    pt = table(disk)
    ss = pt["sectorsize"]
    need = size_bytes // ss
    region = next(((st, sz) for st, sz in sorted(free_regions(pt), key=lambda r: r[1]) if sz >= need), None)
    if region is None:
        # Shrinking: the end of the Windows partition moves forward, and the freed space follows it
        win = info.get("windows")
        if not win:
            fail(BESIDE_ERRORS["no_space"], "no Windows partition that can be shrunk")
        part = next(p for p in pt["partitions"] if p["node"] == win["path"])
        align = MIB // ss
        after = gap_after(pt, part)
        shrink = -(-(need - after) // align) * align
        new_size = (part["size"] - shrink) // align * align
        if new_size * ss < win["min"] + WINDOWS_RESERVE:
            fail(BESIDE_ERRORS["no_space"], f"cannot shrink by this much: {shrink * ss}")
        emit(stage="shrink", progress=8)
        # it cannot have changed since the survey, but at this step we would rather check twice
        if hibernated(win["path"]):
            fail(BESIDE_ERRORS["hibernated"], "Windows is hibernated")
        # a dry run first, then for real; then the partition gets smaller too (its start stays)
        run(["ntfsresize", "--no-action", "--no-progress-bar", "--size", str(new_size * ss), win["path"]],
            error="error.beside_shrink_failed")
        run(["ntfsresize", "--force", "--no-progress-bar", "--size", str(new_size * ss), win["path"]],
            error="error.beside_shrink_failed")
        run(["sfdisk", "--no-reread", "-N", str(partnum(disk, part["node"])), disk],
            input=f"start={part['start']}, size={new_size}\n", error="error.beside_shrink_failed")
        run(["partx", "--update", disk], error="error.beside_shrink_failed")
        pt = table(disk)
        region = next(((st, sz) for st, sz in free_regions(pt) if sz >= need), None)
        if region is None:
            fail("error.install_failed", "still not enough space after shrinking")
    # in order: EFI, (with encryption /boot,) system, work partition
    layout = [("esp", ESP_MIB * MIB // ss, ESP_TYPE, "EFI-SYSTEM")]
    if encrypt:
        layout.append(("boot", BOOT_MIB * MIB // ss, LINUX_DATA, "boot"))
    scratch = scratch_bytes // ss
    root = need - sum(size for _n, size, _t, _l in layout) - scratch
    layout += [("root", root, ROOT_X86_64, "root"), ("scratch", scratch, LINUX_DATA, "sloth-install-tmp")]
    script, starts, pos = "", {}, region[0]
    for name, size, ptype, label in layout:
        script += f"start={pos}, size={size}, type={ptype}, name=\"{label}\"\n"
        starts[name] = pos
        pos += size
    run(["sfdisk", "--append", "--no-reread", disk], input=script)
    run(["partx", "--update", disk])
    run(["udevadm", "settle", "--timeout=30"])
    by_start = {p["start"]: p for p in table(disk)["partitions"]}
    try:
        new = {name: by_start[st] for name, st in starts.items()}
    except KeyError:
        fail("error.install_failed", f"the new partitions did not appear: {sorted(by_start)}")
    parts = {name: p["node"] for name, p in new.items()}
    parts["numbers"] = {name: partnum(disk, p["node"]) for name, p in new.items()}
    return parts, info["windowsEsp"]


def partnum(disk, node):
    # The number comes straight from the kernel. lsblk also listed the encrypted layer open on the partition
    # (/dev/mapper/sloth-root, without a number), first (2026-10-21, real machine with encryption: TypeError, the install failed)
    name = os.path.basename(os.path.realpath(node))
    try:
        return int(Path(f"/sys/class/block/{name}/partition").read_text())
    except (OSError, ValueError):
        fail("error.install_failed", f"not a partition: {node} ({disk})")


def mount_target(root, esp, scratch, boot=None):
    TARGET.mkdir(parents=True, exist_ok=True)
    SCRATCH.mkdir(parents=True, exist_ok=True)
    run(["mount", root, str(TARGET)])
    if boot:
        (TARGET / "boot").mkdir()
        run(["mount", boot, str(TARGET / "boot")])
    (TARGET / "boot/efi").mkdir(parents=True)
    run(["mount", esp, str(TARGET / "boot/efi")])
    run(["mount", scratch, str(SCRATCH)])


def format_and_mount(parts, passphrase=""):
    """File systems (with encryption, LUKS2 on the system partition), and mounting the target.

    The password reaches cryptsetup only on standard input (without a line ending: that is how it will
    have to be typed at boot too). TRIM (discard) is enabled in the header (--persistent).
    """
    run(["mkfs.fat", "-F", "32", "-n", "EFI-SYSTEM", parts["esp"]])
    if parts.get("boot"):
        run(["mkfs.ext4", "-F", "-q", "-L", "boot", parts["boot"]])
    root_dev = parts["root"]
    if passphrase:
        emit(stage="encrypt", progress=12)
        run(["cryptsetup", "luksFormat", "--type", "luks2", "--batch-mode", "--key-file=-", parts["root"]],
            input=passphrase, error="error.encrypt_failed")
        run(["cryptsetup", "open", "--allow-discards", "--persistent", "--key-file=-", parts["root"], CRYPT_NAME],
            input=passphrase, error="error.encrypt_failed")
        parts["luks_uuid"] = run(["cryptsetup", "luksUUID", parts["root"]]).strip()
        root_dev = str(CRYPT_DEV)
    parts["root_dev"] = root_dev
    # the label is the drive's name in Dolphin's device list (booting uses the UUID)
    run(["mkfs.btrfs", "--force", "--label", "Sloth OS", root_dev])
    run(["mkfs.ext4", "-F", "-q", "-L", "sloth-tmp", parts["scratch"]])
    mount_target(root_dev, parts["esp"], parts["scratch"], parts.get("boot"))


def image_size(source):
    """The unpacked size of the image to install, in bytes (for estimating progress)."""
    name = source.split(":", 1)[1]
    r = subprocess.run(["podman", "image", "inspect", "--format", "{{.Size}}", name],
                       capture_output=True, text=True)
    try:
        return int(r.stdout.strip())
    except ValueError:
        return 12 * 1024**3


def copy_progress(stop, expected, progress):
    """During the copy, the progress bar follows the space used on the system partition (25–80%)."""
    st = os.statvfs(TARGET)
    base = (st.f_blocks - st.f_bfree) * st.f_frsize
    while not stop.wait(2):
        st = os.statvfs(TARGET)
        used = (st.f_blocks - st.f_bfree) * st.f_frsize - base
        pct = 25 + int(55 * min(1.0, used / expected))
        if pct > progress[0]:
            progress[0] = pct
            emit(stage="copy", progress=pct)


def run_bootc(kargs=()):
    source, target = image_refs()
    cmd = ["bootc", "install", "to-filesystem",
           "--source-imgref", source, "--target-imgref", target,
           # while the repository is private, the live system cannot check that updates are available
           "--skip-fetch-check",
           *[f"--karg={k}" for k in kargs],
           str(TARGET)]
    log("$ " + " ".join(cmd))
    # The unpacked layers should go to the work partition, not to /var/tmp in RAM. bootc ignores
    # TMPDIR and uses the /var/tmp of the system (PID 1), so for the duration of the install the
    # work partition is mounted system-wide over /var/tmp (finish_partitions removes it).
    # As an overlay, not a bind mount: that way, according to systemd, /var/tmp's source is "overlay", not the partition.
    # With a bind mount, var-tmp.mount was bound to the partition, and when the partition was deleted, systemd stopped it,
    # and with it basic.target (RequiresMountsFor=/var/tmp) and the whole live desktop, installer included.
    for d in ("upper", "work"):
        (SCRATCH / d).mkdir(exist_ok=True)
    run(["mount", "-t", "overlay", "overlay", "-o",
         f"lowerdir=/var/tmp,upperdir={SCRATCH}/upper,workdir={SCRATCH}/work", "/var/tmp"])
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1)
    progress = [20]
    stop = threading.Event()
    watcher = None
    for line in proc.stdout:
        log(line)
        low = line.lower()
        for keys, stage, pct in STAGES:
            if any(k in low for k in keys):
                if stage == "copy" and watcher is None:
                    watcher = threading.Thread(target=copy_progress,
                                               args=(stop, image_size(source), progress), daemon=True)
                    watcher.start()
                if stage != "copy" and pct > progress[0]:
                    stop.set()
                    progress[0] = pct
                    emit(stage=stage, progress=pct)
                break
    stop.set()
    if proc.wait() != 0:
        fail("error.install_failed", f"bootc exit code: {proc.returncode}")


def hide_other_esps(disk, own_partn):
    """bootc (bootupd) installs the boot loader on the disk's first EFI partition, not on the mounted one: next to
    Windows that would be Windows' (2026-10-20, VM test: GRUB on the Windows EFI partition, ours empty, and the
    boot menu files went nowhere). For the duration of the install the type of the other EFI partitions is set to
    "Microsoft basic data" (their contents are not touched); restore_esps sets it back afterwards."""
    hidden = []
    try:
        for p in table(disk)["partitions"]:
            n = partnum(disk, p["node"])
            if n != own_partn and (p.get("type") or "").lower() == ESP_TYPE:
                # Record before changing it, so even a command that partially succeeds is restored on failure.
                hidden.append((n, p["node"]))
                run(["sfdisk", "--no-reread", "--part-type", disk, str(n), MS_BASIC_DATA])
    except BaseException:
        restore_esps(disk, hidden)
        raise
    if hidden:
        log(f"other EFI partitions hidden during the install: {hidden}")
        _refresh_parts(disk, [node for _n, node in hidden])
    return hidden


def restore_esps(disk, hidden):
    failed = []
    for n, _node in hidden:
        r = subprocess.run(["sfdisk", "--no-reread", "--part-type", disk, str(n), ESP_TYPE],
                           capture_output=True, text=True)
        log(f"EFI partition restored: {n} ({r.returncode}) {r.stderr.strip()}")
        if r.returncode:
            failed.append(n)
    if hidden:
        _refresh_parts(disk, [node for _n, node in hidden])
    if failed:
        fail("error.install_failed", f"could not restore EFI partition types: {failed}")


def _refresh_parts(disk, nodes):
    # the kernel and udev should see the new type too (bootupd searches using udev's data)
    subprocess.run(["partx", "--update", disk], capture_output=True)
    for node in nodes:
        subprocess.run(["udevadm", "trigger", "--action=change", node], capture_output=True)
    subprocess.run(["udevadm", "settle", "--timeout=30"], capture_output=True)


GRUB_CUSTOM = Path("/usr/lib/sloth-os/grub-custom.cfg")


def setup_boot_menu(windows_esp=""):
    """Hidden boot menu: bootupd's GRUB template would show the menu for 1 s on every boot.

    custom.cfg overrides this (shows it only after a failed boot); its state is on the EFI
    partition (sloth-boot.env). If this fails, the machine still boots, only the menu is visible.
    Next to Windows the menu is always shown (for a few seconds), and Windows is in it
    (EFI/fedora/sloth-windows.cfg: the Windows boot loader on its own EFI partition).
    """
    grub_dir = TARGET / "boot/grub2"
    efi_dir = TARGET / "boot/efi/EFI/fedora"
    if not grub_dir.is_dir() or not GRUB_CUSTOM.is_file():
        log("boot menu: no /boot/grub2 or template, the menu stays visible")
        return
    # At the end ("Finalizing filesystem root") bootc remounts the target read-only; it has to be
    # made writable again before writing (2026-10-15: without this, writing custom.cfg threw an exception and the helper stopped).
    for mp in (TARGET, TARGET / "boot", TARGET / "boot/efi"):
        if os.path.ismount(mp):
            r = subprocess.run(["mount", "-o", "remount,rw", str(mp)], capture_output=True, text=True)
            if r.returncode:
                log(f"boot menu: {mp} cannot be remounted writable: {r.stderr.strip()}")
    try:
        (grub_dir / "custom.cfg").write_bytes(GRUB_CUSTOM.read_bytes())
        if not efi_dir.is_dir():
            log(f"boot menu: ERROR, no {efi_dir} (did the boot loader go elsewhere?)")
        else:
            # GRUB environment block (grub2-editenv's format: 1024 bytes, the rest filled with #)
            show = "1" if windows_esp else "0"
            body = f"# GRUB Environment Block\nsloth_boot_pending=0\nsloth_show_menu={show}\n"
            (efi_dir / "sloth-boot.env").write_text(body + "#" * (1024 - len(body)), encoding="ascii")
            if windows_esp:
                (efi_dir / "sloth-windows.cfg").write_text(
                    'menuentry "Windows" --class windows --class os {\n'
                    "  insmod part_gpt\n  insmod fat\n  insmod chain\n"
                    f"  search --no-floppy --fs-uuid --set=root {windows_esp}\n"
                    "  chainloader /EFI/Microsoft/Boot/bootmgfw.efi\n}\n", encoding="ascii")
        log("boot menu: " + ("visible, with a Windows entry" if windows_esp else "hidden"))
    except OSError as e:
        log(f"boot menu: failed, the menu stays visible ({e})")


def finish_partitions(disk, parts, passphrase=""):
    """Unmounting, deleting the work partition, and growing the system partition into its place
    (on a whole disk up to the end of the disk, next to Windows up to the next partition)."""
    run(["sync"])
    for mp in ("/var/tmp", SCRATCH, TARGET / "boot/efi", TARGET / "boot", TARGET):
        subprocess.run(["umount", str(mp)], capture_output=True)
    release_disk(disk)  # bootc may leave something mounted too (e.g. /run/bootc/storage)
    root_n, scratch_n = str(parts["numbers"]["root"]), str(parts["numbers"]["scratch"])
    # The system partition grows by exactly the work partition's space (it comes right after it): on a whole disk
    # that is the end of the disk, next to Windows the size the user chose (any further free
    # space stays free)
    by_node = {p["node"]: p for p in table(disk)["partitions"]}
    root_p, scratch_p = by_node[parts["root"]], by_node[parts["scratch"]]
    if scratch_p["start"] != root_p["start"] + root_p["size"]:
        fail("error.install_failed", f"the work partition is not after the system partition: {root_p} {scratch_p}")
    run(["sfdisk", "--delete", disk, scratch_n])
    run(["sfdisk", "--no-reread", "-N", root_n, disk],
        input=f"start={root_p['start']}, size={root_p['size'] + scratch_p['size']}\n")
    # the kernel should see the new partition table too (next to Windows the whole table cannot always be
    # reread because of the Windows partitions, so we update partition by partition)
    if subprocess.run(["blockdev", "--rereadpt", disk], capture_output=True).returncode != 0:
        subprocess.run(["partx", "--delete", "--nr", scratch_n, disk], capture_output=True)
        run(["partx", "--update", "--nr", root_n, disk])
    run(["udevadm", "settle", "--timeout=30"])
    if parts.get("luks_uuid"):
        # the encrypted layer should follow the bigger partition too (the file system grows in configure)
        run(["cryptsetup", "resize", "--key-file=-", CRYPT_NAME], input=passphrase, error="error.configure_failed")
    return parts["root_dev"]


LOADER = r"\EFI\fedora\shimx64.efi"


def rename_boot_entry(disk, esp_partn):
    """The boot loader registers the system in the firmware as "Fedora"; we change that to "Sloth OS".

    efibootmgr cannot rename, so we create a new entry for the same loader
    and delete the old one. If anything fails, the old one stays: the machine still boots.
    The new entry goes to the front of the boot order (next to Windows too: the choice is in
    Sloth OS's menu). Windows' own entry is not touched.
    """
    if not Path("/sys/firmware/efi").is_dir():
        return
    listing = subprocess.run(["efibootmgr"], capture_output=True, text=True).stdout
    old = [line[4:8] for line in listing.splitlines()
           if line.startswith("Boot") and line[8:9] == "*" and "Fedora" in line]
    r = subprocess.run(["efibootmgr", "--create", "--disk", disk, "--part", str(esp_partn),
                        "--loader", LOADER, "--label", "Sloth OS"], capture_output=True, text=True)
    log(f"boot entry: {r.returncode} {r.stderr.strip()}")
    if r.returncode != 0:
        return
    for num in old:
        subprocess.run(["efibootmgr", "--bootnum", num, "--delete-bootnum"], capture_output=True)


def write(path, content):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content, encoding="utf-8")


# Console keyboard layout from the XKB name (where they differ); for non-Latin layouts US
CONSOLE_KEYMAPS = {"gb": "uk", "cz": "cz-qwertz", "sk": "sk-qwertz", "si": "slovene", "hr": "croat",
                   "latam": "la-latin1", "br": "br-abnt2", "ee": "et", "be": "be-latin1", "ca": "cf",
                   "pt": "pt-latin1", "tr": "trq", "jp": "jp106",
                   # no console layout of their own (the Latin base is US)
                   "kr": "us", "cn": "us", "tw": "us", "al": "us", "lv": "us"}


def console_keymap(layouts):
    """The layout of the console (and of the encrypted disk's password prompt): the chosen one, US for non-Latin ones."""
    console = layouts[0] if layouts[0] != "us" or len(layouts) == 1 else "us"
    return CONSOLE_KEYMAPS.get(console, console)


def password_hash(password):
    """SHA-512 crypt hash (the password only goes through standard input, it is not visible on the command line)."""
    r = subprocess.run(["openssl", "passwd", "-6", "-stdin"], input=password + "\n",
                       capture_output=True, text=True)
    if r.returncode != 0 or not r.stdout.startswith("$6$"):
        fail("error.configure_failed", "openssl passwd failed")
    return r.stdout.strip()


def configure(root_part, locale, layouts, variants, timezone, account, beside_windows=False, luks_uuid="",
              extra=None):
    """Writes the language, keyboard and time zone into the installed system's /etc (and the other disks' mounts)."""
    extra = extra or {"fstab": [], "crypttab": [], "keys": {}, "mounts": [], "owned": []}
    mnt = Path(tempfile.mkdtemp(prefix="sloth-install-"))
    log(f"root partition: {root_part}")
    subprocess.run(["mount", "-o", "subvolid=5", root_part, str(mnt)], check=True)
    try:
        # the system also gets the work partition's space
        run(["btrfs", "filesystem", "resize", "max", str(mnt)], error="error.configure_failed")
        etcs = glob.glob(f"{mnt}/ostree/deploy/*/deploy/*.0/etc") + \
            glob.glob(f"{mnt}/*/ostree/deploy/*/deploy/*.0/etc")
        if not etcs:
            fail("error.configure_failed", f"no ostree deployment on: {root_part}")
        etc = Path(etcs[0])
        deploy = etc.parent

        files = {
            etc / "locale.conf": f"LANG={locale}\n",
            etc / "vconsole.conf": f"KEYMAP={console_keymap(layouts)}\n",
            # the default of the login screen and of X11/Wayland (systemd-localed format)
            etc / "X11/xorg.conf.d/00-keyboard.conf": (
                'Section "InputClass"\n'
                '        Identifier "system-keyboard"\n'
                '        MatchIsKeyboard "on"\n'
                f'        Option "XkbLayout" "{",".join(layouts)}"\n'
                + (f'        Option "XkbVariant" "{",".join(variants)}"\n' if any(variants) else "")
                + ('        Option "XkbOptions" "grp:alt_shift_toggle"\n' if len(layouts) > 1 else "")
                + "EndSection\n"),
            # Plasma's default for every new user
            etc / "xdg/kxkbrc": (
                "[Layout]\n"
                f"LayoutList={','.join(layouts)}\n"
                f"VariantList={','.join(variants)}\n"
                + ("Options=grp:alt_shift_toggle\nResetOldOptions=true\n" if len(layouts) > 1 else "")
                + "Use=true\n"),
        }
        crypttab = [f"luks-{luks_uuid} UUID={luks_uuid} none discard"] if luks_uuid else []
        # The encrypted system partition (the initramfs opens it by rd.luks.uuid; Plymouth asks for the password),
        # then the other encrypted disks with their key files
        crypttab += extra["crypttab"]
        if crypttab:
            files[etc / "crypttab"] = "\n".join(crypttab) + "\n"
        if extra["fstab"]:
            fstab = etc / "fstab"
            old = fstab.read_text(encoding="utf-8") if fstab.exists() else ""
            files[fstab] = old + ("" if not old or old.endswith("\n") else "\n") + "\n".join(extra["fstab"]) + "\n"
        if beside_windows:
            # Windows keeps the hardware clock in local time: if we kept UTC, the clock would be off after every switch
            files[etc / "adjtime"] = "0.0 0 0.0\n0\nLOCAL\n"
        for path, content in files.items():
            write(path, content)
        keys = []
        for name, key in extra["keys"].items():
            keys.append(etc / "sloth-os/keys" / name)
            write(keys[-1], key)
            os.chmod(keys[-1], 0o400)
        if keys:
            os.chmod(keys[0].parent, 0o700)
        # the mount points in the stateroot's /var (X-mount.mkdir would make them too)
        var = deploy.parent.parent / "var"
        for name in extra["mounts"]:
            (var / "mnt" / name).mkdir(parents=True, exist_ok=True)
        # The account: created on first boot by the sloth-first-user service (as administrator); it also gets
        # the erased disks
        user_spec = etc / "sloth-os/first-user.json"
        write(user_spec, json.dumps({**account, "disks": extra["owned"]}, ensure_ascii=False))
        os.chmod(user_spec, 0o600)
        localtime = etc / "localtime"
        if localtime.is_symlink() or localtime.exists():
            localtime.unlink()
        localtime.symlink_to(f"../usr/share/zoneinfo/{timezone}")

        use_signed_updates(deploy)

        # SELinux labels according to the installed system's own policy
        contexts = deploy / "etc/selinux/targeted/contexts/files/file_contexts"
        if contexts.exists():
            r = subprocess.run(["setfiles", "-F", "-r", str(deploy), str(contexts),
                                *[str(p) for p in files], *[str(k) for k in keys],
                                *([str(keys[0].parent)] if keys else []),
                                str(localtime), str(user_spec.parent), str(user_spec)],
                               capture_output=True, text=True)
            log(f"setfiles: {r.returncode} {r.stderr.strip()}")
    finally:
        subprocess.run(["sync"])
        subprocess.run(["umount", str(mnt)])
        mnt.rmdir()


def use_signed_updates(deploy):
    """Updates should come with signature verification (ostree-image-signed).

    bootc writes an unverified reference (ostree-unverified-registry). If the installed image's
    containers-policy.json requires a signature for this image (BlueBuild signing module +
    signing-family.sh), we rewrite it; then an update can only come from an image signed with our key. If the
    rule is missing, the old one stays, because otherwise the machine would get no updates at all.
    """
    origin = deploy.with_name(deploy.name + ".origin")
    prefix = "container-image-reference=ostree-unverified-registry:"
    try:
        lines = origin.read_text(encoding="utf-8").splitlines()
        policy = json.loads((deploy / "etc/containers/policy.json").read_text(encoding="utf-8"))
    except (OSError, ValueError) as e:
        log(f"signed updates: not readable ({e}), keeping the unverified one")
        return
    out, changed = [], False
    for line in lines:
        if line.startswith(prefix):
            ref = line[len(prefix):]
            repo = ref.rsplit(":", 1)[0] if ":" in ref.rsplit("/", 1)[-1] else ref
            rules = policy.get("transports", {}).get("docker", {}).get(repo, [])
            if rules and rules[0].get("type") == "sigstoreSigned":
                line = f"container-image-reference=ostree-image-signed:docker://{ref}"
                changed = True
            else:
                log(f"signed updates: policy.json has no rule for: {repo}")
        out.append(line)
    if changed:
        origin.write_text("\n".join(out) + "\n", encoding="utf-8")
        log("signed updates: " + next(l for l in out if l.startswith("container-image-reference=")))


WINDOWS_HELPER = Path("/usr/share/sloth-os/windows-helper")


def place_windows_helper(disk):
    """Next to Windows: the Windows-side boot helper goes on the Windows Public Desktop (a "Sloth OS" folder).

    The user double-clicks it once in Windows, and from then on Windows puts Sloth OS back at the front of the
    boot order on every start. Only a convenience: if it fails (e.g. the partition is read-only), the install
    does not stop because of it, and it can be placed later from Sloth Center (Advanced settings).
    """
    if not WINDOWS_HELPER.is_dir():
        return
    out = subprocess.run(["lsblk", "--json", "--output", "PATH,FSTYPE", disk], capture_output=True, text=True)
    try:
        devices = json.loads(out.stdout).get("blockdevices", [])
    except ValueError:
        return
    for dev in devices:
        if dev.get("fstype") != "ntfs":
            continue
        mnt = Path(tempfile.mkdtemp(prefix="sloth-windows-"))
        try:
            if subprocess.run(["mount", "-t", "ntfs3", dev["path"], str(mnt)], capture_output=True).returncode:
                continue
            try:
                if (mnt / "Windows/System32").is_dir():
                    dest = mnt / "Users/Public/Desktop/Sloth OS"
                    dest.mkdir(parents=True, exist_ok=True)
                    for f in WINDOWS_HELPER.iterdir():
                        shutil.copyfile(f, dest / f.name)
                    log(f"Windows helper placed: {dev['path']}")
                    return
            except OSError as e:
                log(f"Windows helper: {e}")
            finally:
                subprocess.run(["umount", str(mnt)], capture_output=True)
        finally:
            try:
                mnt.rmdir()
            except OSError:
                pass


def dry_run(beside=False):
    for stage, pct in [("shrink", 8)] * beside + [("partition", 10), ("encrypt", 12), ("prepare", 20)] + [("copy", p) for p in range(25, 81, 5)] + \
            [("bootloader", 85), ("finishing", 90), ("configure", 95)]:
        time.sleep(1.5)
        emit(stage=stage, progress=pct)
    emit(done=True)


def main():
    parser = argparse.ArgumentParser(prog="sloth-install-helper")
    sub = parser.add_subparsers(dest="cmd", required=True)
    inst = sub.add_parser("install")
    inst.add_argument("--disk", required=True)
    inst.add_argument("--locale", required=True)
    inst.add_argument("--keyboard", required=True)
    inst.add_argument("--timezone", required=True)
    inst.add_argument("--username", required=True)
    inst.add_argument("--fullname", default="")
    inst.add_argument("--beside-windows", action="store_true")
    inst.add_argument("--size-gib", type=int, default=0)
    inst.add_argument("--encrypt", action="store_true", help="the encryption password is the 2nd line of the input")
    inst.add_argument("--extra-disk", action="append", default=[], help="keep:/dev/Y or erase:/dev/Y")
    inst.add_argument("--data-label", default="Sloth OS data", help="the erased disks' name (in Dolphin)")
    prb = sub.add_parser("probe")
    prb.add_argument("--disk", required=True)
    args = parser.parse_args()

    if args.cmd == "probe":
        if os.environ.get("SLOTH_INSTALL_DRY_RUN") == "1":
            print(json.dumps({"uefi": True, "gpt": True, "windowsEsp": "ABCD-1234", "free": 0,
                              "shrinkable": 200 * 1024**3, "max": 200 * 1024**3, "problems": [],
                              "bitlocker": False, "windows": {"size": 400 * 1024**3}}))
            return 0
        if os.geteuid() != 0:
            fail("error.not_authorized")
        if not whole_disk(args.disk):
            fail("error.bad_disk", f"disk cannot be installed to: {args.disk}")
        LOG.write_text(f"Sloth OS disk survey: {time.ctime()}\n", encoding="utf-8")
        print(json.dumps(probe(args.disk)), flush=True)
        return 0

    if os.environ.get("SLOTH_INSTALL_DRY_RUN") == "1":
        dry_run(args.beside_windows)
        return 0
    if os.geteuid() != 0:
        fail("error.not_authorized")
    if not whole_disk(args.disk):
        fail("error.bad_disk", f"disk cannot be installed to: {args.disk}")
    if args.beside_windows and not 40 <= args.size_gib <= 100000:
        fail("error.bad_input", f"bad size: {args.size_gib} GiB")
    if not re.fullmatch(r"[a-z]{2,3}(_[A-Z]{2})?\.UTF-8", args.locale):
        fail("error.bad_input", f"bad locale: {args.locale}")
    keyboard = parse_keyboard(args.keyboard)
    if not keyboard:
        fail("error.bad_input", f"bad keyboard: {args.keyboard}")
    if args.timezone not in zoneinfo.available_timezones():
        fail("error.bad_input", f"bad time zone: {args.timezone}")
    if not re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", args.username) or args.username in RESERVED_USERS:
        fail("error.bad_input", f"bad user name: {args.username}")
    if len(args.fullname) > 128 or any(c in args.fullname for c in ":\n,"):
        fail("error.bad_input", "bad full name")
    password = sys.stdin.readline().rstrip("\n")
    if not password:
        fail("error.bad_input", "empty password")
    passphrase = sys.stdin.readline().rstrip("\n") if args.encrypt else ""
    if args.encrypt and len(passphrase) < 8:
        fail("error.bad_input", "encryption password too short")
    account = {"username": args.username, "fullname": args.fullname, "password_hash": password_hash(password)}
    extras = parse_extra(args.extra_disk, args.disk)
    if not 0 < len(args.data_label) <= 60 or any(ord(c) < 32 for c in args.data_label):
        fail("error.bad_input", "bad data disk label")

    LOG.write_text(f"Sloth OS installation: {time.ctime()}\n", encoding="utf-8")
    emit(stage="verify", progress=2)
    verify_image()     # before the disk is touched: on failure, nothing has been erased
    emit(stage="partition", progress=5)
    # an earlier, interrupted attempt may have left the encrypted layer open
    subprocess.run(["umount", "-R", str(TARGET)], capture_output=True)
    if subprocess.run(["findmnt", "-n", "-o", "FSTYPE", "/var/tmp"], capture_output=True,
                      text=True).stdout.split()[-1:] == ["overlay"]:   # the top layer is the last line
        subprocess.run(["umount", "/var/tmp"], capture_output=True)
    subprocess.run(["cryptsetup", "close", CRYPT_NAME], capture_output=True)
    # The other disks first: if something goes wrong there, the system disk is still untouched
    extra = prepare_extra_disks(extras, args.encrypt, args.data_label)
    release_disk(args.disk)
    windows_esp = ""
    if args.beside_windows:
        parts, windows_esp = partition_beside(args.disk, args.size_gib * 1024**3, args.encrypt)
    else:
        parts = partition(args.disk, args.encrypt)
    format_and_mount(parts, passphrase)
    kargs = []
    if parts.get("luks_uuid"):
        # at boot this is what has to be opened, and the password is asked with the chosen keyboard layout
        kargs = [f"rd.luks.uuid=luks-{parts['luks_uuid']}", f"rd.vconsole.keymap={console_keymap(keyboard[0])}"]
    emit(stage="prepare", progress=20)
    hidden = hide_other_esps(args.disk, parts["numbers"]["esp"])
    try:
        run_bootc(kargs)
    finally:
        restore_esps(args.disk, hidden)
    setup_boot_menu(windows_esp)
    root_part = finish_partitions(args.disk, parts, passphrase)
    rename_boot_entry(args.disk, parts["numbers"]["esp"])
    if args.beside_windows:
        place_windows_helper(args.disk)
    emit(stage="configure", progress=95)
    configure(root_part, args.locale, *keyboard, args.timezone, account, beside_windows=args.beside_windows,
              luks_uuid=parts.get("luks_uuid", ""), extra=extra)
    if parts.get("luks_uuid"):
        subprocess.run(["cryptsetup", "close", CRYPT_NAME], capture_output=True)
    emit(done=True)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except subprocess.CalledProcessError as e:
        fail("error.configure_failed", str(e))
    except Exception:  # unexpected error: details go to the log, otherwise only the error page would show
        fail("error.install_failed", traceback.format_exc())
