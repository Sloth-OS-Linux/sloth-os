LOG = Path("/tmp/sloth-install.log")
# Ezeket a neveket a rendszer használja, nem lehet belőlük felhasználói fiók
RESERVED_USERS = {"root", "bin", "daemon", "adm", "lp", "sync", "shutdown", "halt", "mail", "operator",
                  "games", "ftp", "nobody", "systemd-network", "dbus", "polkitd", "sddm", "plasmalogin",
                  "liveuser", "admin", "wheel", "users"}
IMAGE_CONF = Path("/usr/share/sloth-os/installer/image.conf")
TARGET = Path("/run/sloth-install/target")      # ide csatoljuk a rendszerpartíciót
SCRATCH = Path("/run/sloth-install/scratch")    # az átmeneti munkapartíció
SCRATCH_BYTES = 10 * 1024**3                     # a kicsomagolt rétegeknek (mért csúcs ~2,1 GB + tartalék)

MIN_BESIDE_BYTES = 40 * 1024**3                  # Windows mellé legalább ennyi kell a Sloth OS-nek
WINDOWS_RESERVE = 20 * 1024**3                   # zsugorítás után ennyi szabad hely marad a Windowsnak
ESP_MIB = 512
BOOT_MIB = 1024    # titkosításnál külön /boot (a GRUB a LUKS2-t nem tudja kinyitni, a rendszermag itt van)
MIB = 1024**2
CRYPT_NAME = "sloth-root"
CRYPT_DEV = Path("/dev/mapper") / CRYPT_NAME

# GPT partíciótípusok
BIOS_BOOT = "21686148-6449-6e6f-744e-656564454649"
ESP_TYPE = "c12a7328-f81f-11d2-ba4b-00a0c93ec93b"
ROOT_X86_64 = "4f68bce3-e8cd-4db1-96e7-fbcaf984b709"
LINUX_DATA = "0fc63daf-8483-4772-8e79-3d69d8477de4"

# bootc kimenet -> lépés és körülbelüli százalék (az első egyező nyer). A másolás haladását
# nem a kimenetből, hanem a rendszerpartíción elfoglalt helyből számoljuk (copy_progress).
STAGES = [
    (("initializing ostree", "ostree layout", "sysroot"), "prepare", 20),
    (("fetching", "layer", "importing", "deploying", "pulling"), "copy", 25),
    (("bootloader", "bootupd", "grub"), "bootloader", 85),
    (("installation complete",), "finishing", 90),
]


def emit(**msg):
    print(json.dumps(msg), flush=True)


def log(line):
    with LOG.open("a", encoding="utf-8") as f:
        f.write(line.rstrip() + "\n")


def fail(key, detail=""):
    if detail:
        log(f"HIBA: {detail}")
    emit(error=key)
    sys.exit(1)


# --- Bemenetek ellenőrzése (root-ként futunk: semmit nem fogadunk el vakon) ---------

def whole_disk(path):
    """Csak teljes lemezt fogadunk el, ami nem az élő rendszer saját meghajtója."""
    if not re.fullmatch(r"/dev/[a-zA-Z0-9]+", path or ""):
        return False
    out = subprocess.run(["lsblk", "--noheadings", "--nodeps", "--output", "TYPE,RO", path],
                         capture_output=True, text=True).stdout.split()
    if out[:2] != ["disk", "0"]:
        return False
    live = subprocess.run(["findmnt", "--noheadings", "--output", "SOURCE", "/run/initramfs/live"],
                          capture_output=True, text=True).stdout.strip()
    if live:
        parent = subprocess.run(["lsblk", "--noheadings", "--nodeps", "--output", "PKNAME", live],
                                capture_output=True, text=True).stdout.strip()
        if path in (live, f"/dev/{parent}"):
            return False
    return True


def parse_keyboard(value):
    """"us,ru" -> (["us", "ru"], ["", ""]); "us(intl)" -> (["us"], ["intl"])."""
    layouts, variants = [], []
    for item in (value or "").split(","):
        m = re.fullmatch(r"([a-z]{2,6})(?:\(([a-z0-9_]{1,20})\))?", item)
        if not m:
            return None
        layouts.append(m.group(1))
        variants.append(m.group(2) or "")
    return (layouts, variants) if layouts else None


# --- Telepítés --------------------------------------------------------------------

def image_refs():
    conf = dict(line.split("=", 1) for line in IMAGE_CONF.read_text().split("\n") if "=" in line)
    return conf["SOURCE_IMGREF"], conf["TARGET_IMGREF"]


def release_disk(disk):
    """Ha valami használja a lemezt (automatikusan csatolt partíció, swap), elengedjük."""
    out = json.loads(subprocess.run(["lsblk", "--json", "--tree", "--output", "PATH,MOUNTPOINTS,FSTYPE", disk],
                                    capture_output=True, text=True).stdout or "{}")
    stack = list(out.get("blockdevices", []))
    while stack:
        dev = stack.pop()
        stack.extend(dev.get("children") or [])
        if dev.get("fstype") == "swap":
            subprocess.run(["swapoff", dev["path"]], capture_output=True)
        for mp in dev.get("mountpoints") or []:
            if mp:
                subprocess.run(["umount", "--lazy", mp], capture_output=True)


def run(cmd, error="error.install_failed", **kwargs):
    """Parancs futtatása naplózva; ha nem sikerül, a felület hibaoldalt mutat."""
    log("$ " + " ".join(cmd))
    r = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, **kwargs)
    if r.stdout.strip():
        log(r.stdout)
    if r.returncode != 0:
        fail(error, f"{cmd[0]} kilépési kód: {r.returncode}")
    return r.stdout


def partitions(disk):
    """{partíciószám: eszköz} a lemezen, az udev frissülése után."""
    run(["udevadm", "settle", "--timeout=30"])
    out = json.loads(run(["lsblk", "--json", "--tree", "--output", "PATH,PARTN", disk]) or "{}")
    return {int(c["partn"]): c["path"] for d in out.get("blockdevices", [])
            for c in d.get("children") or [] if c.get("partn")}


def partition(disk, encrypt=False):
    """Új GPT a lemezre: BIOS boot, EFI, (titkosításnál /boot,) rendszer és a végén az átmeneti munkapartíció."""
    size_mib = int(run(["lsblk", "--noheadings", "--nodeps", "--bytes", "--output", "SIZE", disk])) // 1024**2
    # 1 MiB az elején, 1 MiB a végén a GPT-nek; BIOS boot 1 MiB, EFI 512 MiB
    boot_mib = BOOT_MIB if encrypt else 0
    root_mib = size_mib - 2 - 1 - ESP_MIB - boot_mib - SCRATCH_BYTES // 1024**2 - 2
    if root_mib < 20 * 1024:
        fail("error.bad_disk", f"túl kicsi lemez: {size_mib} MiB")
    run(["wipefs", "--all", "--force", disk])
    names = ["bios", "esp"] + (["boot"] if encrypt else []) + ["root", "scratch"]
    table = (
        "label: gpt\n"
        f"size=1MiB, type={BIOS_BOOT}, name=\"BIOS-BOOT\"\n"
        f"size={ESP_MIB}MiB, type={ESP_TYPE}, name=\"EFI-SYSTEM\"\n"
        + (f"size={boot_mib}MiB, type={LINUX_DATA}, name=\"boot\"\n" if encrypt else "")
        + f"size={root_mib}MiB, type={ROOT_X86_64}, name=\"root\"\n"
        f"type={LINUX_DATA}, name=\"sloth-install-tmp\"\n")
    run(["sfdisk", "--wipe", "always", "--wipe-partitions", "always", disk], input=table)
    parts = partitions(disk)
    if sorted(parts) != list(range(1, len(names) + 1)):
        fail("error.install_failed", f"váratlan partíciók: {parts}")
    out = {name: parts[i + 1] for i, name in enumerate(names)}
    out["numbers"] = {name: i + 1 for i, name in enumerate(names)}
    return out


# --- Windows mellé ------------------------------------------------------------------

def table(disk):
    """A lemez partíciós táblája (sfdisk --json): címke, szektorméret, partíciók."""
    r = subprocess.run(["sfdisk", "--json", disk], capture_output=True, text=True)
    pt = json.loads(r.stdout or "{}").get("partitiontable", {}) if r.returncode == 0 else {}
    pt.setdefault("sectorsize", 512)
    pt.setdefault("partitions", [])
    return pt


def free_regions(pt):
    """A szabad területek (kezdő szektor, szektorok száma), 1 MiB-re igazítva."""
    ss = pt["sectorsize"]
    align = MIB // ss
    first, last = pt.get("firstlba", align), pt.get("lastlba", 0)
    out, pos = [], first
    for p in sorted(pt["partitions"], key=lambda p: p["start"]):
        if p["start"] > pos:
            out.append((pos, p["start"] - pos))
        pos = max(pos, p["start"] + p["size"])
    if last + 1 > pos:
        out.append((pos, last + 1 - pos))
    aligned = []
    for start, size in out:
        a = -(-start // align) * align
        end = (start + size) // align * align
        if end > a:
            aligned.append((a, end - a))
    return aligned


def gap_after(pt, part):
    """A partíció után közvetlenül következő szabad terület mérete szektorban (ha van)."""
    align = MIB // pt["sectorsize"]
    start = -(-(part["start"] + part["size"]) // align) * align
    return next((sz for st, sz in free_regions(pt) if st == start), 0)


def fstype(dev):
    return subprocess.run(["blkid", "-o", "value", "-s", "TYPE", dev], capture_output=True, text=True).stdout.strip()


def fs_uuid(dev):
    return subprocess.run(["blkid", "-o", "value", "-s", "UUID", dev], capture_output=True, text=True).stdout.strip()


def windows_esp():
    """A Windows rendszerindítóját tartalmazó EFI-partíció FS-UUID-ja, bármelyik lemezen
    (a boot menü Windows-bejegyzéséhez). Ha nincs, üres."""
    out = json.loads(subprocess.run(["lsblk", "--json", "--list", "--output", "PATH,PARTTYPE,FSTYPE"],
                                    capture_output=True, text=True).stdout or "{}")
    for p in out.get("blockdevices", []):
        if (p.get("parttype") or "").lower() != ESP_TYPE or p.get("fstype") != "vfat":
            continue
        mnt = Path(tempfile.mkdtemp(prefix="sloth-esp-"))
        try:
            if subprocess.run(["mount", "-o", "ro", p["path"], str(mnt)], capture_output=True).returncode:
                continue
            try:
                boot = mnt / "EFI"
                found = boot.is_dir() and any(f.name.lower() == "bootmgfw.efi"
                                              for f in boot.glob("*/*/*") if f.parent.parent.name.lower() == "microsoft")
            finally:
                subprocess.run(["umount", str(mnt)], capture_output=True)
            if found:
                return fs_uuid(p["path"])
        finally:
            mnt.rmdir()
    return ""


def hibernated(dev):
    """A Windows hibernált vagy gyors indítással állt le: a hiberfil.sys eleje "hibr" (nem "wake" vagy üres).

    Ilyenkor a Windows a következő indításkor a memóriaképből visszaírná a régi állapotot, és a közben
    megváltozott partíció tönkremenne. Az ntfsresize --info ezt nem nézi (csak olvasásra nyit), ezért külön
    ellenőrizzük, csak olvasva (ntfscat, csatolás nélkül).
    """
    try:
        proc = subprocess.Popen(["ntfscat", dev, "hiberfil.sys"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        head = proc.stdout.read(4)
        proc.kill()
        proc.wait()
    except OSError:
        return False
    log(f"hiberfil.sys eleje ({dev}): {head!r}")
    return head.lower() == b"hibr"


def ntfs_info(dev):
    """(min. méret bájtban vagy None, gond: "" | "hibernated" | "dirty" | "unknown") az ntfsresize szerint."""
    if hibernated(dev):
        return None, "hibernated"
    r = subprocess.run(["ntfsresize", "--info", "--no-progress-bar", dev], capture_output=True, text=True)
    text = (r.stdout + r.stderr)
    log(f"ntfsresize --info {dev}: {r.returncode}\n{text}")
    low = text.lower()
    if "hibernat" in low or "unsafe state" in low or "fast restart" in low:
        return None, "hibernated"
    if "scheduled for check" in low or "dirty" in low or "chkdsk" in low:
        return None, "dirty"
    m = re.search(r"you might resize at (\d+) bytes", low)
    if r.returncode != 0 or not m:
        return None, "unknown"
    return int(m.group(1)), ""


def probe(disk):
    """A Windows mellé telepítés lehetőségei: mekkora hely jut a Sloth OS-nek, és mi akadályozza."""
    pt = table(disk)
    ss = pt["sectorsize"]
    info = {"uefi": Path("/sys/firmware/efi").is_dir(), "gpt": pt.get("label") == "gpt",
            "windowsEsp": "", "free": 0, "shrinkable": 0, "max": 0, "problems": [], "bitlocker": False}
    if not info["uefi"]:
        info["problems"].append("not_uefi")
    if not info["gpt"]:
        info["problems"].append("not_gpt")
    if info["problems"]:
        return info
    release_disk(disk)
    info["windowsEsp"] = windows_esp()
    regions = free_regions(pt)
    info["free"] = max((size * ss for _s, size in regions), default=0)
    types = {p["node"]: fstype(p["node"]) for p in pt["partitions"]}
    info["bitlocker"] = any(t.lower() == "bitlocker" for t in types.values())
    ntfs = [p for p in pt["partitions"] if types.get(p["node"]) == "ntfs"]
    if ntfs:
        win = max(ntfs, key=lambda p: p["size"])
        size = win["size"] * ss
        minimum, problem = ntfs_info(win["node"])
        if problem:
            info["problems"].append(problem)
        else:
            after = gap_after(pt, win) * ss
            shrink = max(0, size - minimum - WINDOWS_RESERVE) // MIB * MIB
            info["windows"] = {"path": win["node"], "size": size, "min": minimum}
            info["shrinkable"] = shrink + after if shrink else 0
    elif info["bitlocker"]:
        info["problems"].append("bitlocker")
    info["max"] = max(info["free"], info["shrinkable"])
    if info["max"] < MIN_BESIDE_BYTES and not set(info["problems"]) & {"hibernated", "dirty", "bitlocker"}:
        info["problems"].append("no_space")
    return info


# Ami miatt nem lehet Windows mellé telepíteni -> a felület hibaüzenete (fordítási kulcs; ugyanaz a
# magyarázat, ami a lemezválasztó lapon is látszik)
BESIDE_PROBLEMS = ("not_uefi", "not_gpt", "hibernated", "dirty", "unknown", "bitlocker", "no_space")
BESIDE_ERRORS = {p: f"disk.beside.{p}" for p in BESIDE_PROBLEMS if p != "bitlocker"}


def partition_beside(disk, size_bytes, encrypt=False):
    """A Sloth OS helye a Windows mellett: a meglévő szabad hely, vagy a Windows-partíció zsugorítása.

    -> (partíciók {"esp", "root", "scratch"} eszköz és partíciószám szerint, a Windows EFI FS-UUID-ja)
    """
    info = probe(disk)
    blocking = [p for p in info["problems"] if p in BESIDE_ERRORS]
    if blocking:
        fail(BESIDE_ERRORS[blocking[0]], f"Windows mellé nem telepíthető: {info}")
    if size_bytes > info["max"]:
        fail(BESIDE_ERRORS["no_space"], f"kevés hely: {size_bytes} (max {info['max']})")
    pt = table(disk)
    ss = pt["sectorsize"]
    need = size_bytes // ss
    region = next(((st, sz) for st, sz in sorted(free_regions(pt), key=lambda r: r[1]) if sz >= need), None)
    if region is None:
        # Zsugorítás: a Windows-partíció vége előrébb kerül, a felszabadult hely utána következik
        win = info.get("windows")
        if not win:
            fail(BESIDE_ERRORS["no_space"], "nincs zsugorítható Windows-partíció")
        part = next(p for p in pt["partitions"] if p["node"] == win["path"])
        align = MIB // ss
        after = gap_after(pt, part)
        shrink = -(-(need - after) // align) * align
        new_size = (part["size"] - shrink) // align * align
        if new_size * ss < win["min"] + WINDOWS_RESERVE:
            fail(BESIDE_ERRORS["no_space"], f"nem zsugorítható ennyivel: {shrink * ss}")
        emit(stage="shrink", progress=8)
        # a felmérés óta nem változhatott, de ennél a lépésnél inkább kétszer nézzük meg
        if hibernated(win["path"]):
            fail(BESIDE_ERRORS["hibernated"], "a Windows hibernált")
        # előbb próba, aztán élesben; utána a partíció is kisebb lesz (a kezdete marad)
        run(["ntfsresize", "--no-action", "--no-progress-bar", "--size", str(new_size * ss), win["path"]],
            error="error.beside_shrink_failed")
        run(["ntfsresize", "--force", "--no-progress-bar", "--size", str(new_size * ss), win["path"]],
            error="error.beside_shrink_failed")
        run(["sfdisk", "--no-reread", "-N", str(partnum(disk, part["node"])), disk],
            input=f"start={part['start']}, size={new_size}\n", error="error.beside_shrink_failed")
        run(["partx", "--update", disk], error="error.beside_shrink_failed")
        pt = table(disk)
        region = next(((st, sz) for st, sz in free_regions(pt) if sz >= need), None)
        if region is None:
            fail("error.install_failed", "a zsugorítás után sincs elég hely")
    # sorban: EFI, (titkosításnál /boot,) rendszer, munkapartíció
    layout = [("esp", ESP_MIB * MIB // ss, ESP_TYPE, "EFI-SYSTEM")]
    if encrypt:
        layout.append(("boot", BOOT_MIB * MIB // ss, LINUX_DATA, "boot"))
    scratch = SCRATCH_BYTES // ss
    root = need - sum(size for _n, size, _t, _l in layout) - scratch
    layout += [("root", root, ROOT_X86_64, "root"), ("scratch", scratch, LINUX_DATA, "sloth-install-tmp")]
    script, starts, pos = "", {}, region[0]
    for name, size, ptype, label in layout:
        script += f"start={pos}, size={size}, type={ptype}, name=\"{label}\"\n"
        starts[name] = pos
        pos += size
    run(["sfdisk", "--append", "--no-reread", disk], input=script)
    run(["partx", "--update", disk])
    run(["udevadm", "settle", "--timeout=30"])
    by_start = {p["start"]: p for p in table(disk)["partitions"]}
    try:
        new = {name: by_start[st] for name, st in starts.items()}
    except KeyError:
        fail("error.install_failed", f"az új partíciók nem jelentek meg: {sorted(by_start)}")
    parts = {name: p["node"] for name, p in new.items()}
    parts["numbers"] = {name: partnum(disk, p["node"]) for name, p in new.items()}
    return parts, info["windowsEsp"]


def partnum(disk, node):
    out = json.loads(run(["lsblk", "--json", "--output", "PATH,PARTN", node]) or "{}")
    return int(out["blockdevices"][0]["partn"])


def mount_target(root, esp, scratch, boot=None):
    TARGET.mkdir(parents=True, exist_ok=True)
    SCRATCH.mkdir(parents=True, exist_ok=True)
    run(["mount", root, str(TARGET)])
    if boot:
        (TARGET / "boot").mkdir()
        run(["mount", boot, str(TARGET / "boot")])
    (TARGET / "boot/efi").mkdir(parents=True)
    run(["mount", esp, str(TARGET / "boot/efi")])
    run(["mount", scratch, str(SCRATCH)])


def format_and_mount(parts, passphrase=""):
    """Fájlrendszerek (titkosításnál a rendszerpartíción LUKS2), és a cél felcsatolása.

    A jelszó csak a szabványos bemeneten megy át a cryptsetup-nak (sor vége nélkül: így kell majd
    beírni indításkor is). A TRIM (discard) engedélyezése a fejlécbe kerül (--persistent).
    """
    run(["mkfs.fat", "-F", "32", "-n", "EFI-SYSTEM", parts["esp"]])
    if parts.get("boot"):
        run(["mkfs.ext4", "-F", "-q", "-L", "boot", parts["boot"]])
    root_dev = parts["root"]
    if passphrase:
        emit(stage="encrypt", progress=12)
        run(["cryptsetup", "luksFormat", "--type", "luks2", "--batch-mode", "--key-file=-", parts["root"]],
            input=passphrase, error="error.encrypt_failed")
        run(["cryptsetup", "open", "--allow-discards", "--persistent", "--key-file=-", parts["root"], CRYPT_NAME],
            input=passphrase, error="error.encrypt_failed")
        parts["luks_uuid"] = run(["cryptsetup", "luksUUID", parts["root"]]).strip()
        root_dev = str(CRYPT_DEV)
    parts["root_dev"] = root_dev
    run(["mkfs.btrfs", "--force", "--label", "root", root_dev])
    run(["mkfs.ext4", "-F", "-q", "-L", "sloth-tmp", parts["scratch"]])
    mount_target(root_dev, parts["esp"], parts["scratch"], parts.get("boot"))


def image_size(source):
    """A telepítendő image kicsomagolt mérete bájtban (a haladás becsléséhez)."""
    name = source.split(":", 1)[1]
    r = subprocess.run(["podman", "image", "inspect", "--format", "{{.Size}}", name],
                       capture_output=True, text=True)
    try:
        return int(r.stdout.strip())
    except ValueError:
        return 12 * 1024**3


def copy_progress(stop, expected, progress):
    """Másolás közben a rendszerpartíción elfoglalt hely alapján halad a folyamatjelző (25–80%)."""
    st = os.statvfs(TARGET)
    base = (st.f_blocks - st.f_bfree) * st.f_frsize
    while not stop.wait(2):
        st = os.statvfs(TARGET)
        used = (st.f_blocks - st.f_bfree) * st.f_frsize - base
        pct = 25 + int(55 * min(1.0, used / expected))
        if pct > progress[0]:
            progress[0] = pct
            emit(stage="copy", progress=pct)


def run_bootc(kargs=()):
    source, target = image_refs()
    cmd = ["bootc", "install", "to-filesystem",
           "--source-imgref", source, "--target-imgref", target,
           # amíg a repó privát, az élő rendszer nem tudja ellenőrizni a frissítések elérhetőségét
           "--skip-fetch-check",
           *[f"--karg={k}" for k in kargs],
           str(TARGET)]
    log("$ " + " ".join(cmd))
    # A kicsomagolt rétegek a munkapartícióra kerüljenek, ne a RAM-ban lévő /var/tmp-be. A TMPDIR-t a
    # bootc nem veszi figyelembe, és a rendszer (PID 1) /var/tmp-jét használja, ezért a telepítés idejére a
    # munkapartíciót rendszerszinten a /var/tmp fölé csatoljuk (finish_partitions veszi le).
    run(["mount", "--bind", str(SCRATCH), "/var/tmp"])
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1)
    progress = [20]
    stop = threading.Event()
    watcher = None
    for line in proc.stdout:
        log(line)
        low = line.lower()
        for keys, stage, pct in STAGES:
            if any(k in low for k in keys):
                if stage == "copy" and watcher is None:
                    watcher = threading.Thread(target=copy_progress,
                                               args=(stop, image_size(source), progress), daemon=True)
                    watcher.start()
                if stage != "copy" and pct > progress[0]:
                    stop.set()
                    progress[0] = pct
                    emit(stage=stage, progress=pct)
                break
    stop.set()
    if proc.wait() != 0:
        fail("error.install_failed", f"bootc kilépési kód: {proc.returncode}")


GRUB_CUSTOM = Path("/usr/lib/sloth-os/grub-custom.cfg")


def setup_boot_menu(windows_esp=""):
    """Rejtett boot menü: a bootupd GRUB-sablonja minden indításkor 1 mp-re kirakná a menüt.

    A custom.cfg ezt felülírja (csak hibás indítás után mutatja), az állapota az EFI partíción
    van (sloth-boot.env). Ha nem sikerül, a gép így is elindul, csak látszik a menü.
    Windows mellett a menü mindig látszik (pár másodpercig), és a Windows is benne van
    (EFI/fedora/sloth-windows.cfg: a Windows rendszerindítója a saját EFI-partícióján).
    """
    grub_dir = TARGET / "boot/grub2"
    efi_dir = TARGET / "boot/efi/EFI/fedora"
    if not grub_dir.is_dir() or not GRUB_CUSTOM.is_file():
        log("boot menü: nincs /boot/grub2 vagy sablon, marad a látható menü")
        return
    # A bootc a végén („Finalizing filesystem root”) csak olvashatóra csatolja vissza a célt; írás előtt
    # vissza kell állítani (2026-10-15: e nélkül a custom.cfg írása kivételt dobott, és a segéd leállt).
    for mp in (TARGET, TARGET / "boot", TARGET / "boot/efi"):
        if os.path.ismount(mp):
            r = subprocess.run(["mount", "-o", "remount,rw", str(mp)], capture_output=True, text=True)
            if r.returncode:
                log(f"boot menü: {mp} nem csatolható írhatóra: {r.stderr.strip()}")
    try:
        (grub_dir / "custom.cfg").write_bytes(GRUB_CUSTOM.read_bytes())
        if efi_dir.is_dir():
            # GRUB környezeti blokk (a grub2-editenv formátuma: 1024 bájt, a maradék #-kel kitöltve)
            show = "1" if windows_esp else "0"
            body = f"# GRUB Environment Block\nsloth_boot_pending=0\nsloth_show_menu={show}\n"
            (efi_dir / "sloth-boot.env").write_text(body + "#" * (1024 - len(body)), encoding="ascii")
            if windows_esp:
                (efi_dir / "sloth-windows.cfg").write_text(
                    'menuentry "Windows" --class windows --class os {\n'
                    "  insmod part_gpt\n  insmod fat\n  insmod chain\n"
                    f"  search --no-floppy --fs-uuid --set=root {windows_esp}\n"
                    "  chainloader /EFI/Microsoft/Boot/bootmgfw.efi\n}\n", encoding="ascii")
        log("boot menü: " + ("látható, Windows-bejegyzéssel" if windows_esp else "rejtett"))
    except OSError as e:
        log(f"boot menü: nem sikerült, marad a látható menü ({e})")


def finish_partitions(disk, parts, passphrase=""):
    """Leválasztás, a munkapartíció törlése, és a rendszerpartíció kiterjesztése a helyére
    (teljes lemeznél a lemez végéig, Windows mellett a következő partícióig)."""
    run(["sync"])
    for mp in ("/var/tmp", SCRATCH, TARGET / "boot/efi", TARGET / "boot", TARGET):
        subprocess.run(["umount", str(mp)], capture_output=True)
    release_disk(disk)  # a bootc is csatolva hagyhat valamit (pl. /run/bootc/storage)
    root_n, scratch_n = str(parts["numbers"]["root"]), str(parts["numbers"]["scratch"])
    # A rendszerpartíció pontosan a munkapartíció helyével nő (közvetlenül utána van): teljes lemeznél ez a
    # lemez vége, Windows mellett pedig a felhasználó által választott méret (az esetleges további szabad
    # hely szabad marad)
    by_node = {p["node"]: p for p in table(disk)["partitions"]}
    root_p, scratch_p = by_node[parts["root"]], by_node[parts["scratch"]]
    if scratch_p["start"] != root_p["start"] + root_p["size"]:
        fail("error.install_failed", f"a munkapartíció nem a rendszerpartíció után van: {root_p} {scratch_p}")
    run(["sfdisk", "--delete", disk, scratch_n])
    run(["sfdisk", "--no-reread", "-N", root_n, disk],
        input=f"start={root_p['start']}, size={root_p['size'] + scratch_p['size']}\n")
    # a kernel is lássa az új partíciós táblát (Windows mellett a Windows-partíciók miatt nem mindig
    # olvasható újra az egész, ezért partíciónként frissítünk)
    if subprocess.run(["blockdev", "--rereadpt", disk], capture_output=True).returncode != 0:
        subprocess.run(["partx", "--delete", "--nr", scratch_n, disk], capture_output=True)
        run(["partx", "--update", "--nr", root_n, disk])
    run(["udevadm", "settle", "--timeout=30"])
    if parts.get("luks_uuid"):
        # a titkosított réteg is kövesse a nagyobb partíciót (a fájlrendszer a configure-ban nő)
        run(["cryptsetup", "resize", "--key-file=-", CRYPT_NAME], input=passphrase, error="error.configure_failed")
    return parts["root_dev"]


LOADER = r"\EFI\fedora\shimx64.efi"


def rename_boot_entry(disk, esp_partn):
    """A bootloader a firmware-be "Fedora" néven veszi fel a rendszert; ezt "Sloth OS"-re cseréljük.

    Az efibootmgr nem tud átnevezni, ezért új bejegyzést hozunk létre ugyanarra a betöltőre,
    és a régit töröljük. Ha bármi nem sikerül, a régi marad: a gép így is elindul.
    Az új bejegyzés kerül a rendszerindítási sorrend elejére (Windows mellett is: a választás a
    Sloth OS menüjében van). A Windows saját bejegyzéséhez nem nyúlunk.
    """
    if not Path("/sys/firmware/efi").is_dir():
        return
    listing = subprocess.run(["efibootmgr"], capture_output=True, text=True).stdout
    old = [line[4:8] for line in listing.splitlines()
           if line.startswith("Boot") and line[8:9] == "*" and "Fedora" in line]
    r = subprocess.run(["efibootmgr", "--create", "--disk", disk, "--part", str(esp_partn),
                        "--loader", LOADER, "--label", "Sloth OS"], capture_output=True, text=True)
    log(f"boot-bejegyzés: {r.returncode} {r.stderr.strip()}")
    if r.returncode != 0:
        return
    for num in old:
        subprocess.run(["efibootmgr", "--bootnum", num, "--delete-bootnum"], capture_output=True)


def write(path, content):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content, encoding="utf-8")


# Konzolos billentyűzetkiosztás az XKB-névből (ahol eltér); nem latin betűsnél az amerikai
CONSOLE_KEYMAPS = {"gb": "uk", "cz": "cz-qwertz", "sk": "sk-qwertz", "si": "slovene", "hr": "croat",
                   "latam": "la-latin1", "br": "br-abnt2", "ee": "et", "be": "be-latin1", "ca": "cf",
                   "pt": "pt-latin1", "tr": "trq", "jp": "jp106",
                   # nincs saját konzolos kiosztásuk (a latin betűs alap az amerikai)
                   "kr": "us", "cn": "us", "tw": "us", "al": "us", "lv": "us"}


def console_keymap(layouts):
    """A konzol (és a titkosított lemez jelszókérője) kiosztása: a választott, nem latin betűsnél az amerikai."""
    console = layouts[0] if layouts[0] != "us" or len(layouts) == 1 else "us"
    return CONSOLE_KEYMAPS.get(console, console)


def password_hash(password):
    """SHA-512 crypt hash (a jelszó csak a szabványos bemeneten megy át, parancssorban nem látszik)."""
    r = subprocess.run(["openssl", "passwd", "-6", "-stdin"], input=password + "\n",
                       capture_output=True, text=True)
    if r.returncode != 0 or not r.stdout.startswith("$6$"):
        fail("error.configure_failed", "openssl passwd nem sikerült")
    return r.stdout.strip()


def configure(root_part, locale, layouts, variants, timezone, account, beside_windows=False, luks_uuid=""):
    """A nyelv, a billentyűzet és az időzóna beírása a feltelepített rendszer /etc mappájába."""
    mnt = Path(tempfile.mkdtemp(prefix="sloth-install-"))
    log(f"gyökérpartíció: {root_part}")
    subprocess.run(["mount", "-o", "subvolid=5", root_part, str(mnt)], check=True)
    try:
        # a rendszer a munkapartíció helyét is megkapja
        run(["btrfs", "filesystem", "resize", "max", str(mnt)], error="error.configure_failed")
        etcs = glob.glob(f"{mnt}/ostree/deploy/*/deploy/*.0/etc") + \
            glob.glob(f"{mnt}/*/ostree/deploy/*/deploy/*.0/etc")
        if not etcs:
            fail("error.configure_failed", f"nincs ostree deployment ezen: {root_part}")
        etc = Path(etcs[0])
        deploy = etc.parent

        files = {
            etc / "locale.conf": f"LANG={locale}\n",
            etc / "vconsole.conf": f"KEYMAP={console_keymap(layouts)}\n",
            # a bejelentkező képernyő és az X11/Wayland alapértelmezése (systemd-localed formátum)
            etc / "X11/xorg.conf.d/00-keyboard.conf": (
                'Section "InputClass"\n'
                '        Identifier "system-keyboard"\n'
                '        MatchIsKeyboard "on"\n'
                f'        Option "XkbLayout" "{",".join(layouts)}"\n'
                + (f'        Option "XkbVariant" "{",".join(variants)}"\n' if any(variants) else "")
                + ('        Option "XkbOptions" "grp:alt_shift_toggle"\n' if len(layouts) > 1 else "")
                + "EndSection\n"),
            # a Plasma alapértelmezése minden új felhasználónak
            etc / "xdg/kxkbrc": (
                "[Layout]\n"
                f"LayoutList={','.join(layouts)}\n"
                f"VariantList={','.join(variants)}\n"
                + ("Options=grp:alt_shift_toggle\nResetOldOptions=true\n" if len(layouts) > 1 else "")
                + "Use=true\n"),
        }
        if luks_uuid:
            # A titkosított rendszerpartíció (az initramfs a rd.luks.uuid alapján nyitja, a jelszót a Plymouth kéri)
            files[etc / "crypttab"] = f"luks-{luks_uuid} UUID={luks_uuid} none discard\n"
        if beside_windows:
            # A Windows a hardverórát helyi időben tartja: ha mi UTC-ben, minden váltás után elcsúszna az óra
            files[etc / "adjtime"] = "0.0 0 0.0\n0\nLOCAL\n"
        for path, content in files.items():
            write(path, content)
        # A fiók: első induláskor a sloth-first-user szolgáltatás hozza létre (rendszergazdaként)
        user_spec = etc / "sloth-os/first-user.json"
        write(user_spec, json.dumps(account, ensure_ascii=False))
        os.chmod(user_spec, 0o600)
        localtime = etc / "localtime"
        if localtime.is_symlink() or localtime.exists():
            localtime.unlink()
        localtime.symlink_to(f"../usr/share/zoneinfo/{timezone}")

        use_signed_updates(deploy)

        # SELinux címkék a telepített rendszer saját szabályai szerint
        contexts = deploy / "etc/selinux/targeted/contexts/files/file_contexts"
        if contexts.exists():
            r = subprocess.run(["setfiles", "-F", "-r", str(deploy), str(contexts),
                                *[str(p) for p in files], str(localtime), str(user_spec.parent), str(user_spec)],
                               capture_output=True, text=True)
            log(f"setfiles: {r.returncode} {r.stderr.strip()}")
    finally:
        subprocess.run(["sync"])
        subprocess.run(["umount", str(mnt)])
        mnt.rmdir()


def use_signed_updates(deploy):
    """A frissítések aláírás-ellenőrzéssel jöjjenek (ostree-image-signed).

    A bootc ellenőrzés nélküli hivatkozást ír (ostree-unverified-registry). Ha a telepített image
    containers-policy.json-ja aláírást követel erre az image-re (BlueBuild signing modul +
    signing-family.sh), átírjuk; így a frissítés csak a mi kulcsunkkal aláírt image-ből jöhet. Ha a
    szabály hiányzik, marad a régi, mert különben a gép egyáltalán nem kapna frissítést.
    """
    origin = deploy.with_name(deploy.name + ".origin")
    prefix = "container-image-reference=ostree-unverified-registry:"
    try:
        lines = origin.read_text(encoding="utf-8").splitlines()
        policy = json.loads((deploy / "etc/containers/policy.json").read_text(encoding="utf-8"))
    except (OSError, ValueError) as e:
        log(f"aláírt frissítések: nem olvasható ({e}), marad az ellenőrzés nélküli")
        return
    out, changed = [], False
    for line in lines:
        if line.startswith(prefix):
            ref = line[len(prefix):]
            repo = ref.rsplit(":", 1)[0] if ":" in ref.rsplit("/", 1)[-1] else ref
            rules = policy.get("transports", {}).get("docker", {}).get(repo, [])
            if rules and rules[0].get("type") == "sigstoreSigned":
                line = f"container-image-reference=ostree-image-signed:docker://{ref}"
                changed = True
            else:
                log(f"aláírt frissítések: a policy.json-ban nincs szabály erre: {repo}")
        out.append(line)
    if changed:
        origin.write_text("\n".join(out) + "\n", encoding="utf-8")
        log("aláírt frissítések: " + next(l for l in out if l.startswith("container-image-reference=")))


def dry_run(beside=False):
    for stage, pct in [("shrink", 8)] * beside + [("partition", 10), ("encrypt", 12), ("prepare", 20)] + [("copy", p) for p in range(25, 81, 5)] + \
            [("bootloader", 85), ("finishing", 90), ("configure", 95)]:
        time.sleep(1.5)
        emit(stage=stage, progress=pct)
    emit(done=True)


def main():
    parser = argparse.ArgumentParser(prog="sloth-install-helper")
    sub = parser.add_subparsers(dest="cmd", required=True)
    inst = sub.add_parser("install")
    inst.add_argument("--disk", required=True)
    inst.add_argument("--locale", required=True)
    inst.add_argument("--keyboard", required=True)
    inst.add_argument("--timezone", required=True)
    inst.add_argument("--username", required=True)
    inst.add_argument("--fullname", default="")
    inst.add_argument("--beside-windows", action="store_true")
    inst.add_argument("--size-gib", type=int, default=0)
    inst.add_argument("--encrypt", action="store_true", help="a titkosítás jelszava a 2. sor a bemeneten")
    prb = sub.add_parser("probe")
    prb.add_argument("--disk", required=True)
    args = parser.parse_args()

    if args.cmd == "probe":
        if os.environ.get("SLOTH_INSTALL_DRY_RUN") == "1":
            print(json.dumps({"uefi": True, "gpt": True, "windowsEsp": "ABCD-1234", "free": 0,
                              "shrinkable": 200 * 1024**3, "max": 200 * 1024**3, "problems": [],
                              "bitlocker": False, "windows": {"size": 400 * 1024**3}}))
            return 0
        if os.geteuid() != 0:
            fail("error.not_authorized")
        if not whole_disk(args.disk):
            fail("error.bad_disk", f"nem telepíthető lemez: {args.disk}")
        LOG.write_text(f"Sloth OS lemezfelmérés: {time.ctime()}\n", encoding="utf-8")
        print(json.dumps(probe(args.disk)), flush=True)
        return 0

    if os.environ.get("SLOTH_INSTALL_DRY_RUN") == "1":
        dry_run(args.beside_windows)
        return 0
    if os.geteuid() != 0:
        fail("error.not_authorized")
    if not whole_disk(args.disk):
        fail("error.bad_disk", f"nem telepíthető lemez: {args.disk}")
    if args.beside_windows and not 40 <= args.size_gib <= 100000:
        fail("error.bad_input", f"rossz méret: {args.size_gib} GiB")
    if not re.fullmatch(r"[a-z]{2,3}(_[A-Z]{2})?\.UTF-8", args.locale):
        fail("error.bad_input", f"rossz locale: {args.locale}")
    keyboard = parse_keyboard(args.keyboard)
    if not keyboard:
        fail("error.bad_input", f"rossz billentyűzet: {args.keyboard}")
    if args.timezone not in zoneinfo.available_timezones():
        fail("error.bad_input", f"rossz időzóna: {args.timezone}")
    if not re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", args.username) or args.username in RESERVED_USERS:
        fail("error.bad_input", f"rossz felhasználónév: {args.username}")
    if len(args.fullname) > 128 or any(c in args.fullname for c in ":\n,"):
        fail("error.bad_input", "rossz teljes név")
    password = sys.stdin.readline().rstrip("\n")
    if not password:
        fail("error.bad_input", "üres jelszó")
    passphrase = sys.stdin.readline().rstrip("\n") if args.encrypt else ""
    if args.encrypt and len(passphrase) < 8:
        fail("error.bad_input", "túl rövid titkosítási jelszó")
    account = {"username": args.username, "fullname": args.fullname, "password_hash": password_hash(password)}

    LOG.write_text(f"Sloth OS telepítés: {time.ctime()}\n", encoding="utf-8")
    emit(stage="partition", progress=5)
    # egy korábbi, megszakadt próbálkozás nyitva hagyhatta a titkosított réteget
    subprocess.run(["umount", "-R", str(TARGET)], capture_output=True)
    subprocess.run(["cryptsetup", "close", CRYPT_NAME], capture_output=True)
    release_disk(args.disk)
    windows_esp = ""
    if args.beside_windows:
        parts, windows_esp = partition_beside(args.disk, args.size_gib * 1024**3, args.encrypt)
    else:
        parts = partition(args.disk, args.encrypt)
    format_and_mount(parts, passphrase)
    kargs = []
    if parts.get("luks_uuid"):
        # indításkor ezt kell kinyitni, és a jelszót a választott billentyűzetkiosztással kérjük
        kargs = [f"rd.luks.uuid=luks-{parts['luks_uuid']}", f"rd.vconsole.keymap={console_keymap(keyboard[0])}"]
    emit(stage="prepare", progress=20)
    run_bootc(kargs)
    setup_boot_menu(windows_esp)
    root_part = finish_partitions(args.disk, parts, passphrase)
    rename_boot_entry(args.disk, parts["numbers"]["esp"])
    emit(stage="configure", progress=95)
    configure(root_part, args.locale, *keyboard, args.timezone, account, beside_windows=args.beside_windows,
              luks_uuid=parts.get("luks_uuid", ""))
    if parts.get("luks_uuid"):
        subprocess.run(["cryptsetup", "close", CRYPT_NAME], capture_output=True)
    emit(done=True)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except subprocess.CalledProcessError as e:
        fail("error.configure_failed", str(e))
    except Exception:  # váratlan hiba: a részletek a logba, különben csak a hibaoldal látszana
        fail("error.install_failed", traceback.format_exc())
