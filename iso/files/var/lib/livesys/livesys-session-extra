# Settings of the Sloth OS live system (called by livesys-main as administrator, at the first start).
# The liveuser signs in automatically; the installer starts, and its icon is on the desktop too.

home=/home/liveuser

# The installer should start at login
mkdir -p "$home/.config/autostart"
cp /usr/share/applications/org.slothos.installer.desktop "$home/.config/autostart/"

# An icon on the desktop (made executable, so KDE does not ask about it)
mkdir -p "$home/Desktop"
cp /usr/share/applications/org.slothos.installer.desktop "$home/Desktop/"
chmod +x "$home/Desktop/org.slothos.installer.desktop"

# Sloth Welcome will run on the installed system; it must not come up here
mkdir -p "$home/.config/sloth-os"
: > "$home/.config/sloth-os/welcome-done"

# The installer should be first in the start menu
cat > "$home/.config/kickoffrc" << 'EOF'
[Favorites]
FavoriteURLs=/usr/share/applications/org.slothos.installer.desktop,/usr/share/applications/org.kde.dolphin.desktop,/usr/share/applications/systemsettings.desktop
EOF

# While installing, the screen must not dim or turn off, the machine must not sleep, and it must not lock
# (the installer also inhibits this separately for the duration of the install, see sloth_installer/controller.py)
for profile in AC Battery LowBattery; do
    kwriteconfig6 --file "$home/.config/powerdevilrc" --group "$profile" --group Display --key DimDisplayWhenIdle false
    kwriteconfig6 --file "$home/.config/powerdevilrc" --group "$profile" --group Display --key TurnOffDisplayWhenIdle false
    kwriteconfig6 --file "$home/.config/powerdevilrc" --group "$profile" --group SuspendAndShutdown --key AutoSuspendAction 0
done
kwriteconfig6 --file "$home/.config/kscreenlockerrc" --group Daemon --key Autolock false
kwriteconfig6 --file "$home/.config/kscreenlockerrc" --group Daemon --key LockOnResume false
