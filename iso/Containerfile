# Sloth OS élő rendszer a telepítő ISO-hoz. A Titanoboa (ublue-os/titanoboa) ebből az image-ből
# készít indítható ISO-t. Építés: tools/build-iso.ps1 (Windows, Podman) vagy .github/workflows/iso.yml.
# A telepítendő image és a Firefox a második lépésben kerül bele (iso/payload.sh).
ARG BASE_IMAGE=ghcr.io/bathorizsolt/sloth-os:latest
FROM ${BASE_IMAGE}

COPY build.sh iso.yaml /src/
COPY files/ /src/files/
RUN bash /src/build.sh && rm -rf /src
