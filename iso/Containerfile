# The Sloth OS live system for the installer ISO. Titanoboa (ublue-os/titanoboa) makes a bootable ISO
# from this image. Build: tools/build-iso.sh (Linux) / tools/build-iso.ps1 (Windows), or .github/workflows/iso.yml.
# The image to install is not in it: when the ISO is made, it is mounted in from a separate folder (iso/payload.sh).
ARG BASE_IMAGE=ghcr.io/sloth-os-linux/sloth-os:latest
FROM ${BASE_IMAGE}
ARG BASE_IMAGE

COPY build.sh iso.yaml /src/
COPY files/ /src/files/
RUN SLOTH_IMAGE="${BASE_IMAGE}" bash /src/build.sh && rm -rf /src
