# Sloth OS élő rendszer a telepítő ISO-hoz. A Titanoboa (ublue-os/titanoboa) ebből az image-ből
# készít indítható ISO-t. Építés: tools/build-iso.sh (Linux) / tools/build-iso.ps1 (Windows), vagy .github/workflows/iso.yml.
# A telepítendő image nem kerül bele: az ISO készítésekor külön mappából csatoljuk be (iso/payload.sh).
ARG BASE_IMAGE=ghcr.io/bathorizsolt/sloth-os:latest
FROM ${BASE_IMAGE}
ARG BASE_IMAGE

COPY build.sh iso.yaml /src/
COPY files/ /src/files/
RUN SLOTH_IMAGE="${BASE_IMAGE}" bash /src/build.sh && rm -rf /src
